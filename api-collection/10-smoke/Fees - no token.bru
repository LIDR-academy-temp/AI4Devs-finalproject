meta {
  name: Fees - no token
  type: http
  seq: 86
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/fees
  body: none
  auth: none
}

vars:pre-request {
  selfAuth: true
}

tests {
  test('no session: 401 unauthorized', () => {
    expect(res.status).to.equal(401);
    expect(res.body.code).to.equal('unauthorized');
  });
}
