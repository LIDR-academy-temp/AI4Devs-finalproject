meta {
  name: Review - missing inclusionVersion
  type: http
  seq: 121
  tags: [
    smoke
  ]
}

post {
  url: {{baseUrl}}/api/v1/imports/:importId/review
  body: json
  auth: inherit
}

params:path {
  importId: {{$randomUUID}}
}

body:json {
  {
    "runId": 1
  }
}

tests {
  test('the decision names the inclusions the analyst saw: without inclusionVersion, 400 validation_error', () => {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal('validation_error');
  });
}
