meta {
  name: Imports in progress - no token
  type: http
  seq: 118
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/imports
  body: none
  auth: none
}

vars:pre-request {
  selfAuth: true
}

tests {
  test('responds 401 unauthorized without a token', () => {
    expect(res.status).to.equal(401);
    expect(res.body.code).to.equal('unauthorized');
  });
}
