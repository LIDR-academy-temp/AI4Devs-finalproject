meta {
  name: Patch fee - analyst
  type: http
  seq: 83
  tags: [
    smoke
  ]
}

patch {
  url: {{baseUrl}}/api/v1/fees/:feeId
  body: json
  auth: inherit
}

params:path {
  feeId: {{$randomUUID}}
}

body:json {
  {
    "description": "Smoke test"
  }
}

tests {
  test('analyst lacks fee.manage: 403 forbidden, before the scope', () => {
    expect(res.status).to.equal(403);
    expect(res.body.code).to.equal('forbidden');
  });
}
