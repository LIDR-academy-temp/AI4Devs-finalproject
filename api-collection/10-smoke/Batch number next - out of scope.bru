meta {
  name: Batch number next - out of scope
  type: http
  seq: 46
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/accounts/:accountId/batch-number/next
  body: none
  auth: bearer
}

params:path {
  accountId: {{providerCUsdAccountId}}
}

auth:bearer {
  token: {{viewerToken}}
}

vars:pre-request {
  as: viewer
}

script:pre-request {
  if (!bru.getVar('providerCUsdAccountId')) {
    await bru.runRequest('10-smoke/Provider C accounts');
  }
  if (!bru.getVar('providerCUsdAccountId')) {
    throw new Error(bru.getVar('providerCUsdLookupError') || 'ProviderC-USD accountId could not be resolved');
  }
}

tests {
  test('viewer gets 404 not_found for an account of merchant 2', () => {
    expect(res.status).to.equal(404);
    expect(res.body.code).to.equal('not_found');
    expect(res.body.message).to.equal('Account not found');
  });
}
