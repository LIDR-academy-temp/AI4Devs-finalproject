meta {
  name: Provider accounts
  type: http
  seq: 12
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/providers/:providerId/accounts
  body: none
  auth: inherit
}

params:path {
  providerId: 101
}

script:post-response {
  const account = Array.isArray(res.body) && res.body.find((a) => a.name === 'ProviderA-USD');
  if (account) {
    bru.setVar('providerAUsdAccountId', account.accountId);
  }
}

tests {
  test('provider 101 includes ProviderA-USD', () => {
    expect(res.status).to.equal(200);
    expect(res.body.map((a) => a.name)).to.include('ProviderA-USD');
  });
}

example {
  name: 200 Response
  description: Default Response
  
  request: {
    url: {{baseUrl}}/api/v1/providers/:providerId/accounts
    method: GET
    mode: none
    params:path: {
      providerId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        [
          {
            "accountId": "",
            "providerId": 0,
            "name": "",
            "chargebackReservePolicy": "hold_until_term",
            "rollingReserveCapAmt": "",
