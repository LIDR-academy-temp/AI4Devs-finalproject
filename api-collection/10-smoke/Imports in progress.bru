meta {
  name: Imports in progress
  type: http
  seq: 115
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/imports
  body: none
  auth: inherit
}

tests {
  test('analyst gets a page of open imports, each with its account, provider and merchant', () => {
    expect(res.status).to.equal(200);
    expect(res.body.page).to.equal(1);
    expect(res.body.pageSize).to.equal(50);
    expect(res.body.total).to.be.a('number');
    for (const item of res.body.items) {
      expect(['uploaded', 'mapped', 'analyzed', 'validated']).to.include(item.status);
      expect(item.account).to.have.keys('id', 'name');
      expect(item.provider).to.have.keys('id', 'name');
      expect(item.merchant).to.have.keys('id', 'name');
    }
  });
}
