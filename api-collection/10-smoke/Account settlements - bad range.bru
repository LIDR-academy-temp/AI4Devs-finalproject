meta {
  name: Account settlements - bad range
  type: http
  seq: 63
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/accounts/:accountId/settlements?from=2026-10-24&to=2026-10-01
  body: none
  auth: inherit
}

params:query {
  from: 2026-10-24
  to: 2026-10-01
}

params:path {
  accountId: {{providerAUsdAccountId}}
}

script:pre-request {
  if (!bru.getVar('providerAUsdAccountId')) {
    await bru.runRequest('10-smoke/Provider accounts');
  }
}

tests {
  test('from after to responds 400 validation_error', () => {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal('validation_error');
  });
}
