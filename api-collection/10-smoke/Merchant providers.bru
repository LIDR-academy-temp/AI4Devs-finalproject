meta {
  name: Merchant providers
  type: http
  seq: 6
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/merchants/:merchantId/providers
  body: none
  auth: inherit
}

params:path {
  merchantId: 1
}

tests {
  test('merchant 1 has Provider A and Provider B', () => {
    expect(res.status).to.equal(200);
    expect(res.body.map((p) => p.name)).to.deep.equal(['Provider A', 'Provider B']);
  });
}

