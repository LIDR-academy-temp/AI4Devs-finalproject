meta {
  name: Validations - unknown import
  type: http
  seq: 33
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/imports/:importId/validations
  body: none
  auth: bearer
}

params:path {
  importId: {{$randomUUID}}
}

auth:bearer {
  token: {{viewerToken}}
}

vars:pre-request {
  as: viewer
}

tests {
  test('viewer gets 404 not_found for the validations of an import it cannot see (same body as an unknown one)', () => {
    expect(res.status).to.equal(404);
    expect(res.body.code).to.equal('not_found');
    expect(res.body.message).to.equal('Import not found');
  });
}
