meta {
  name: Patch fee - unknown
  type: http
  seq: 82
  tags: [
    smoke
  ]
}

patch {
  url: {{baseUrl}}/api/v1/fees/:feeId
  body: json
  auth: bearer
}

params:path {
  feeId: {{$randomUUID}}
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "description": "Smoke test"
  }
}

vars:pre-request {
  as: admin
}

tests {
  test('an unknown fee: 404 not_found', () => {
    expect(res.status).to.equal(404);
    expect(res.body.code).to.equal('not_found');
  });
}
