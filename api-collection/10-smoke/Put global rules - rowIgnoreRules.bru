meta {
  name: Put global rules - rowIgnoreRules
  type: http
  seq: 114
  tags: [
    smoke
  ]
}

put {
  url: {{baseUrl}}/api/v1/matching-rules/global
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {}
}

vars:pre-request {
  as: admin
}

script:pre-request {
  // The body is what GET returned, without rule ids nor statuses, as in "20-flows/matching/9 Send global rules back",
  // plus the read-only rowIgnoreRules: at worst, if the schema let it through, nothing would change.
  if (!bru.getVar('globalMatchingRules')) {
    await bru.runRequest('10-smoke/Global rules');
  }
  const globals = bru.getVar('globalMatchingRules');
  if (!globals) {
    throw new Error('the global rules could not be read');
  }
  req.setBody({
    sheetRules: globals.sheetRules.map(({ sheetRuleId, ...rule }) => rule),
    columnRules: globals.columnRules.map(({ columnRuleId, ...rule }) => rule),
    statusAliases: globals.statusAliases,
    rowIgnoreRules: globals.rowIgnoreRules,
  });
}

tests {
  test('row ignores are read-only (#120): 400 validation_error, nothing written', () => {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal('validation_error');
  });
}
