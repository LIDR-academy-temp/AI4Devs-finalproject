meta {
  name: Account settlements
  type: http
  seq: 60
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/accounts/:accountId/settlements?pageSize=50
  body: none
  auth: inherit
}

params:query {
  pageSize: 50
}

params:path {
  accountId: {{providerAUsdAccountId}}
}

script:pre-request {
  if (!bru.getVar('providerAUsdAccountId')) {
    await bru.runRequest('10-smoke/Provider accounts');
  }
}

tests {
  test('the seeded history of ProviderA-USD: at least the 22 paid batches, one page', () => {
    expect(res.status).to.equal(200);
    expect(res.body.accountId).to.equal(bru.getVar('providerAUsdAccountId'));
    expect([res.body.page, res.body.pageSize]).to.eql([1, 50]);
    expect(res.body.total).to.be.at.least(22);
    expect(res.body.items.filter((i) => i.status === 'paid')).to.have.length(22);
  });
  test('newest first by processedAt', () => {
    const instants = res.body.items.map((i) => i.processedAt);
    expect(instants).to.eql([...instants].sort().reverse());
    // The New York day of batch 122, for "Account settlements - processed date" (as the integration test does).
    const batch122 = res.body.items.find((i) => i.batchNo === 122);
    bru.setVar('batch122EtDay', new Date(batch122.processedAt).toLocaleDateString('en-CA', { timeZone: 'America/New_York' }));
    bru.setVar('batch122SettlementDate', batch122.settlementDate);
  });
  test('money as text with four decimals and the settlement date as a day', () => {
    for (const item of res.body.items) {
      expect(item.amountPayable).to.be.a('string');
      expect(item.amountPayable).to.match(/^-?\d+\.\d{4}$/);
      if (item.settlementDate !== null) expect(item.settlementDate).to.match(/^\d{4}-\d{2}-\d{2}$/);
    }
  });
}
