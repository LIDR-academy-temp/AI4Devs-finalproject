meta {
  name: Put rule set - analyst
  type: http
  seq: 111
  tags: [
    smoke
  ]
}

put {
  url: {{baseUrl}}/api/v1/matching-rule-sets/:ruleSetId
  body: json
  auth: inherit
}

params:path {
  ruleSetId: {{providerCLegacyRuleSetId}}
}

body:json {
  {
    "name": "Provider C v2",
    "isActive": true,
    "sheetRules": [],
    "columnRules": []
  }
}

script:pre-request {
  // "Provider C legacy" resolved by name (no literal ids).
  if (!bru.getVar('providerCLegacyRuleSetId')) {
    await bru.runRequest('10-smoke/Matching rule sets');
  }
  if (!bru.getVar('providerCLegacyRuleSetId')) {
    throw new Error('the "Provider C legacy" rule set could not be resolved');
  }
}

tests {
  test('analyst lacks account.manage: 403 forbidden, the set is not touched', () => {
    expect(res.status).to.equal(403);
    expect(res.body.code).to.equal('forbidden');
  });
}
