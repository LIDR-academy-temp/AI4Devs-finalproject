meta {
  name: Cancel - no reason
  type: http
  seq: 120
  tags: [
    smoke
  ]
}

post {
  url: {{baseUrl}}/api/v1/imports/:importId/cancel
  body: json
  auth: inherit
}

params:path {
  importId: {{$randomUUID}}
}

body:json {
  {
    "reason": "   "
  }
}

tests {
  test('a blank reason answers 400 validation_error: the body is checked before the import is looked up', () => {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal('validation_error');
  });
}
