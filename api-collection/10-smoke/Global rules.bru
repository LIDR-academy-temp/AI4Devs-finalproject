meta {
  name: Global rules
  type: http
  seq: 112
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/matching-rules/global
  body: none
  auth: inherit
}

script:post-response {
  // The global rules as read, for the flow step that sends them back unchanged (20-flows/matching).
  if (res.status === 200) {
    bru.setVar('globalMatchingRules', res.body);
  }
}

tests {
  test('analyst reads the template rules, CHB 2, the six statuses and the read-only row ignore', () => {
    expect(res.status).to.equal(200);
    expect(res.body.sheetRules.map((r) => r.sheetPattern)).to.include.members(['APP', 'DEC', 'CHB', 'REF', 'RDR', 'RR']);
    expect(res.body.statusAliases.find((a) => a.alias === 'CHB 2')).to.include({ excludeAmount: true });
    expect(res.body.statuses).to.have.length(6);
    expect(res.body.rowIgnoreRules.map((r) => r.pattern)).to.include('transactionId:empty');
  });
}
