meta {
  name: Account
  type: http
  seq: 14
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/accounts/:accountId
  body: none
  auth: inherit
}

params:path {
  accountId: {{providerAUsdAccountId}}
}

script:pre-request {
  // The accountId is resolved by name in 10-smoke/Provider accounts; no UUID literals (design D5).
  if (!bru.getVar('providerAUsdAccountId')) {
    await bru.runRequest('10-smoke/Provider accounts');
  }
  if (!bru.getVar('providerAUsdAccountId')) {
    throw new Error(bru.getVar('providerAUsdLookupError') || 'ProviderA-USD accountId could not be resolved');
  }
}

tests {
  test('responds ProviderA-USD with its provider and merchant', () => {
    expect(res.status).to.equal(200);
    expect(res.body.name).to.equal('ProviderA-USD');
    expect(res.body.provider.providerId).to.equal(101);
    expect(res.body.merchant.merchantId).to.equal(1);
  });
}

example {
  name: 200 Response
  description: Default Response
  
  request: {
    url: {{baseUrl}}/api/v1/accounts/:accountId
    method: GET
    mode: none
    params:path: {
      accountId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "accountId": "",
          "providerId": 0,
          "name": "",
          "chargebackReservePolicy": "hold_until_term",
          "rollingReserveCapAmt": "",
          "matchingRuleSetId": 0,
          "isActive": false,
          "createdAt": "",
          "provider": {
            "providerId": 0,
            "merchantId": 0,
            "name": "",
            "isActive": false
          },
          "merchant": {
            "merchantId": 0,
            "name": ""
          }
        }
      '''
    }
  }
}

