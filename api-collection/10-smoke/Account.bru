meta {
  name: Account
  type: http
  seq: 14
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/accounts/:accountId
  body: none
  auth: inherit
}

params:path {
  accountId: {{providerAUsdAccountId}}
}

script:pre-request {
  // Resolve the ProviderA-USD accountId by name; no UUID literals in the collection (design D5).
  if (!bru.getVar('providerAUsdAccountId')) {
    const res = await bru.sendRequest({
      method: 'GET',
      url: `${bru.getEnvVar('baseUrl')}/api/v1/providers/101/accounts`,
      headers: { Authorization: `Bearer ${bru.getVar('accessToken')}` },
    });
    bru.setVar('providerAUsdAccountId', res.data.find((a) => a.name === 'ProviderA-USD').accountId);
  }
}

tests {
  test('responds ProviderA-USD with its provider and merchant', () => {
    expect(res.status).to.equal(200);
    expect(res.body.name).to.equal('ProviderA-USD');
    expect(res.body.provider.providerId).to.equal(101);
    expect(res.body.merchant.merchantId).to.equal(1);
  });
}

example {
  name: 200 Response
  description: Default Response
  
  request: {
    url: {{baseUrl}}/api/v1/accounts/:accountId
    method: GET
    mode: none
    params:path: {
      accountId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "accountId": "",
          "providerId": 0,
          "name": "",
          "chargebackReservePolicy": "hold_until_term",
          "rollingReserveCapAmt": "",
          "matchingRuleSetId": 0,
          "isActive": false,
          "createdAt": "",
          "provider": {
            "providerId": 0,
            "merchantId": 0,
            "name": "",
            "isActive": false
          },
          "merchant": {
            "merchantId": 0,
            "name": ""
          }
        }
      '''
    }
  }
}

