meta {
  name: Fee types - no token
  type: http
  seq: 50
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/fee-types
  body: none
  auth: none
}

vars:pre-request {
  selfAuth: true
}

tests {
  test('responds 401 unauthorized', () => {
    expect(res.status).to.equal(401);
    expect(res.body.code).to.equal('unauthorized');
  });
}
