meta {
  name: Upload - viewer
  type: http
  seq: 22
  tags: [
    smoke
  ]
}

post {
  url: {{baseUrl}}/api/v1/accounts/:accountId/imports
  body: multipartForm
  auth: bearer
}

params:path {
  accountId: {{$randomUUID}}
}

auth:bearer {
  token: {{viewerToken}}
}

body:multipart-form {
  files: @file(../data/samples/batch-split/Recon_Template_ProviderA-USD_batch-split_part1.xlsx)
}

vars:pre-request {
  as: viewer
}

tests {
  test('viewer lacks settlement.process: 403 forbidden before anything is read', () => {
    expect(res.status).to.equal(403);
    expect(res.body.code).to.equal('forbidden');
  });
}
