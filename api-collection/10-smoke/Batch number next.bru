meta {
  name: Batch number next
  type: http
  seq: 45
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/accounts/:accountId/batch-number/next
  body: none
  auth: inherit
}

params:path {
  accountId: {{providerAUsdAccountId}}
}

script:pre-request {
  if (!bru.getVar('providerAUsdAccountId')) {
    await bru.runRequest('10-smoke/Provider accounts');
  }
  if (!bru.getVar('providerAUsdAccountId')) {
    throw new Error(bru.getVar('providerAUsdLookupError') || 'ProviderA-USD accountId could not be resolved');
  }
}

tests {
  test('proposes the next number of ProviderA-USD (123 on a fresh seed), attempt 1', () => {
    expect(res.status).to.equal(200);
    expect(res.body.accountId).to.equal(bru.getVar('providerAUsdAccountId'));
    expect(res.body.batchNo).to.be.at.least(123);
    expect(res.body.attemptNo).to.equal(1);
    expect(res.body.reason).to.equal('next');
  });
}
