              "isActive": false,
              "createdAt": ""
            }
          ],
          "channels": [
            {
              "channelId": 0,
              "gatewayId": 0,
              "providerId": 0,
              "name": "",
              "isActive": false,
              "settlementTermDays": 0,
              "rollingReservePct": "",
              "rollingReserveDays": 0
            }
          ]
        }
      '''
    }
  }
}

