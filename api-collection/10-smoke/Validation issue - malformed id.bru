meta {
  name: Validation issue - malformed id
  type: http
  seq: 35
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/validation-issues/:issueId
  body: none
  auth: inherit
}

params:path {
  issueId: abc
}

tests {
  test('a non-numeric issue id: 400 validation_error', () => {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal('validation_error');
  });
}
