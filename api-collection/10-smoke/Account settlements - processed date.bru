meta {
  name: Account settlements - processed date
  type: http
  seq: 61
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/accounts/:accountId/settlements?dateField=processedAt&from={{batch122EtDay}}&to={{batch122EtDay}}
  body: none
  auth: inherit
}

params:query {
  dateField: processedAt
  from: {{batch122EtDay}}
  to: {{batch122EtDay}}
}

params:path {
  accountId: {{providerAUsdAccountId}}
}

script:pre-request {
  if (!bru.getVar('batch122EtDay')) {
    await bru.runRequest('10-smoke/Account settlements');
  }
}

tests {
  test('filters by the New York day of processedAt: only batch 122, whose settlement date is another day', () => {
    expect(res.status).to.equal(200);
    // Ignoring dateField would filter the settlement date by this day, which is not the one of batch 122.
    expect(bru.getVar('batch122SettlementDate')).to.not.equal(bru.getVar('batch122EtDay'));
    expect(res.body.items.map((i) => i.batchNo)).to.eql([122]);
    expect(res.body.total).to.equal(1);
  });
}
