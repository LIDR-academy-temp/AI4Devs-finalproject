meta {
  name: Validation issue - unknown
  type: http
  seq: 36
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/validation-issues/:issueId
  body: none
  auth: bearer
}

params:path {
  issueId: 2147483000
}

auth:bearer {
  token: {{viewerToken}}
}

vars:pre-request {
  as: viewer
}

tests {
  test('an unknown finding: 404 not_found', () => {
    expect(res.status).to.equal(404);
    expect(res.body.code).to.equal('not_found');
    expect(res.body.message).to.equal('Validation issue not found');
  });
}
