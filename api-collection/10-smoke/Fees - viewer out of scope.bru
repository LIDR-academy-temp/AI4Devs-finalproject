meta {
  name: Fees - viewer out of scope
  type: http
  seq: 87
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/fees?merchantId=2
  body: none
  auth: bearer
}

params:query {
  merchantId: 2
}

auth:bearer {
  token: {{viewerToken}}
}

vars:pre-request {
  as: viewer
}

tests {
  test('viewer filtering by merchant 2: 404 not_found', () => {
    expect(res.status).to.equal(404);
    expect(res.body.code).to.equal('not_found');
  });
}
