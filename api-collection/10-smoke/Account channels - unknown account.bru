meta {
  name: Account channels - unknown account
  type: http
  seq: 17
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/accounts/:accountId/channels
  body: none
  auth: inherit
}

params:path {
  accountId: {{$randomUUID}}
}

tests {
  test('responds 404 not_found for a random UUID', () => {
    expect(res.status).to.equal(404);
    expect(res.body.code).to.equal('not_found');
  });
}
