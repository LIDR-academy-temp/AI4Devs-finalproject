meta {
  name: Account fees - out of scope
  type: http
  seq: 48
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/accounts/:accountId/fees
  body: none
  auth: bearer
}

params:path {
  accountId: {{providerCUsdAccountId}}
}

auth:bearer {
  token: {{viewerToken}}
}

vars:pre-request {
  as: viewer
}

script:pre-request {
  if (!bru.getVar('providerCUsdAccountId')) {
    await bru.runRequest('10-smoke/Provider C accounts');
  }
}

tests {
  test('viewer gets 404 not_found for the fees of an account of merchant 2', () => {
    expect(res.status).to.equal(404);
    expect(res.body.code).to.equal('not_found');
  });
}
