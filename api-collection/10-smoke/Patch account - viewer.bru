meta {
  name: Patch account - viewer
  type: http
  seq: 102
  tags: [
    smoke
  ]
}

patch {
  url: {{baseUrl}}/api/v1/accounts/:accountId
  body: json
  auth: bearer
}

params:path {
  accountId: {{$randomUUID}}
}

auth:bearer {
  token: {{viewerToken}}
}

body:json {
  {
    "chargebackReservePolicy": "release_on_chargeback"
  }
}

vars:pre-request {
  as: viewer
}

tests {
  test('viewer lacks account.manage: 403 forbidden, before the scope', () => {
    expect(res.status).to.equal(403);
    expect(res.body.code).to.equal('forbidden');
  });
}
