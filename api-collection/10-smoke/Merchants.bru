meta {
  name: Merchants
  type: http
  seq: 2
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/merchants
  body: none
  auth: inherit
}

tests {
  test('analyst sees Merchant A and Merchant B', () => {
    expect(res.status).to.equal(200);
    expect(res.body.map((m) => m.name)).to.have.members(['Merchant A', 'Merchant B']);
  });
}

example {
  name: 200 Response
  description: Default Response
  
  request: {
    url: {{baseUrl}}/api/v1/merchants
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        [
          {
            "merchantId": 0,
            "name": "",
            "isActive": false
          }
        ]
      '''
    }
  }
}

example {
  name: 401 Response
