meta {
  name: Upload - no files
  type: http
  seq: 23
  tags: [
    smoke
  ]
}

post {
  url: {{baseUrl}}/api/v1/accounts/:accountId/imports
  body: none
  auth: inherit
}

params:path {
  accountId: {{$randomUUID}}
}

tests {
  test('a request without multipart files responds 400 validation_error', () => {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal('validation_error');
  });
}
