meta {
  name: Imports in progress - bad status
  type: http
  seq: 116
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/imports?status=weird
  body: none
  auth: inherit
}

params:query {
  status: weird
}

tests {
  test('a status outside the vocabulary of Import answers 400 validation_error', () => {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal('validation_error');
  });
}
