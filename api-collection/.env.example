# Credentials for the Bruno collection. Copy to api-collection/.env (ignored by git).
# Synthetic users created by the seed script (backend/prisma/synthetic.ts).
SEED_USER=analyst				# SEED_USER is the main user
SEED_VIEWER_USER=viewer				# SEED_VIEWER_USER is only used for scope (404) and permission (403) negatives.
SEED_ADMIN_USER=admin
SEED_PAYMENTS_USER=payments			# Only user with payment.process in the collection: the happy paths of pay and unpay, and the 403 of undo.
# Must match SEED_PASSWORD in the root .env: it is the password the seed gives every user.
SEED_PASSWORD=Recon2026!

