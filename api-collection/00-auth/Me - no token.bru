meta {
  name: Me - no token
  type: http
  seq: 6
  tags: [
    auth
  ]
}

get {
  url: {{baseUrl}}/api/v1/auth/me
  body: none
  auth: none
}

vars:pre-request {
  selfAuth: true
}

tests {
  test('responds 401 unauthorized', () => {
    expect(res.status).to.equal(401);
    expect(res.body.code).to.equal('unauthorized');
  });
}
