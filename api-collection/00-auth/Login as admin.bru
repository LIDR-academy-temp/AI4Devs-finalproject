meta {
  name: Login as admin
  type: http
  seq: 12
  tags: [
    auth
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "userName": "{{process.env.SEED_ADMIN_USER}}",
    "password": "{{process.env.SEED_PASSWORD}}"
  }
}

vars:pre-request {
  selfAuth: true
}

script:post-response {
  // Token of the admin user, the only role with fee.manage: the fee writes. Never replaces accessToken.
  if (res.status === 200) {
    bru.setVar('adminToken', res.body.accessToken);
  }
}

tests {
  test('responds 200 with a token pair', () => {
    expect(res.status).to.equal(200);
    expect(res.body.accessToken).to.be.a('string').and.not.empty;
  });
}
