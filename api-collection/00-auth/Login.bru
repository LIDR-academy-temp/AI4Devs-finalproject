example {
  name: 401 Response
  description: Default Response
  
  request: {
    url: {{baseUrl}}/api/v1/auth/login
    method: POST
    mode: json
    body:json: {
      {
        "userName": "",
        "password": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
