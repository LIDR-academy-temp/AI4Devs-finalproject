meta {
  name: Login - wrong password
  type: http
  seq: 5
  tags: [
    auth
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "userName": "{{process.env.SEED_USER}}",
    "password": "not-the-seed-password"
  }
}

vars:pre-request {
  selfAuth: true
}

tests {
  test('responds 401 invalid_credentials without tokens', () => {
    expect(res.status).to.equal(401);
    expect(res.body.code).to.equal('invalid_credentials');
    expect(res.body).to.not.have.property('accessToken');
  });
}
