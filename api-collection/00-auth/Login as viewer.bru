meta {
  name: Login as viewer
  type: http
  seq: 2
  tags: [
    auth
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "userName": "{{process.env.SEED_VIEWER_USER}}",
    "password": "{{process.env.SEED_PASSWORD}}"
  }
}

script:post-response {
  // Second token, only for scope (404) and permission (403) negatives. Never replaces accessToken.
  if (res.status === 200) {
    bru.setVar('viewerToken', res.body.accessToken);
  }
}

tests {
  test('responds 200 with a token pair', () => {
    expect(res.status).to.equal(200);
    expect(res.body.accessToken).to.be.a('string').and.not.empty;
  });
}
