meta {
  name: 1 Login
  type: http
  seq: 1
  tags: [
    flow
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "userName": "{{process.env.SEED_USER}}",
    "password": "{{process.env.SEED_PASSWORD}}"
  }
}

vars:pre-request {
  selfAuth: true
}

script:post-response {
  // Own pair for the flow; the shared session (accessToken) is never touched (design D4).
  if (res.status === 200) {
    bru.setVar('flowAccessToken', res.body.accessToken);
    bru.setVar('flowRefreshToken', res.body.refreshToken);
  }
}

tests {
  test('login responds 200', () => {
    expect(res.status).to.equal(200);
  });
}
