meta {
  name: 2 Refresh
  type: http
  seq: 2
  tags: [
    flow
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{flowRefreshToken}}"
  }
}

vars:pre-request {
  selfAuth: true
}

script:post-response {
  bru.setVar('rotatedRefreshToken', bru.getVar('flowRefreshToken'));
  if (res.status === 200) {
    bru.setVar('flowAccessToken', res.body.accessToken);
    bru.setVar('flowRefreshToken', res.body.refreshToken);
  }
}

tests {
  test('refresh responds 200 with a new pair', () => {
    expect(res.status).to.equal(200);
    expect(res.body.refreshToken).to.not.equal(bru.getVar('rotatedRefreshToken'));
  });
}
