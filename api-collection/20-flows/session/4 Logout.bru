meta {
  name: 4 Logout
  type: http
  seq: 4
  tags: [
    flow
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/logout
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{flowRefreshToken}}"
  }
}

vars:pre-request {
  selfAuth: true
}

tests {
  test('logout responds 204', () => {
    expect(res.status).to.equal(204);
  });
}
