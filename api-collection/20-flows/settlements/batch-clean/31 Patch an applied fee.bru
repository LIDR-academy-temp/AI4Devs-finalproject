meta {
  name: 31 Patch an applied fee
  type: http
  seq: 33
  tags: [
    flow
  ]
}

patch {
  url: {{baseUrl}}/api/v1/fees/:feeId
  body: json
  auth: bearer
}

params:path {
  feeId: {{inUseFeeId}}
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "fixedAmount": "999.0000"
  }
}

vars:pre-request {
  as: admin
}

script:pre-request {
  if (!bru.getVar('inUseFeeId')) {
    throw new Error('no applied fee: 13 Transactions I or 10-smoke/Fees saves one');
  }
}

tests {
  test('a fee the batch applied does not change its values in place: 409 fee_in_use naming the field', () => {
    expect(res.status).to.equal(409);
    expect(res.body.code).to.equal('fee_in_use');
    expect(res.body.details.fields).to.deep.equal(['fixedAmount']);
  });
}
