meta {
  name: 1 Create fee
  type: http
  seq: 1
  tags: [
    flow
  ]
}

post {
  url: {{baseUrl}}/api/v1/accounts/:accountId/fees
  body: json
  auth: bearer
}

params:path {
  accountId: {{providerAEurAccountId}}
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "feeTypeId": 119,
    "fixedAmount": "15",
    "startDate": "{{flowFeeStart}}",
    "endDate": "{{flowFeeEnd}}",
    "description": "Bruno flow"
  }
}

vars:pre-request {
  as: admin
}

script:pre-request {
  // A two-day Special Adjustment (free amount) of ProviderA-EUR in the far future, on days derived from this run, so the flow can run again without a seed:
  // each run lands on other days and never overlaps the fees of earlier runs.
  if (!bru.getVar('providerAEurAccountId')) {
    await bru.runRequest('10-smoke/Provider accounts');
  }
  const day = (offset) => new Date(Date.UTC(2100, 0, 1) + offset * 86400000).toISOString().slice(0, 10);
  const base = 2 * (Math.floor(Date.now() / 1000) % 18000);
  bru.setVar('flowFeeStart', day(base));
  bru.setVar('flowFeeEnd', day(base + 1));
}

script:post-response {
  if (res.status === 201) {
    bru.setVar('flowFeeId', res.body.feeId);
  }
}

tests {
  test('admin creates the fee: 201, scheduled, not in use, money normalized to 4 decimals', () => {
    expect(res.status).to.equal(201);
    expect(res.body.fixedAmount).to.equal('15.0000');
    expect(res.body.startDate).to.equal(bru.getVar('flowFeeStart'));
    expect(res.body.endDate).to.equal(bru.getVar('flowFeeEnd'));
    expect(res.body.status).to.equal('scheduled');
    expect(res.body.inUse).to.equal(false);
    expect(res.body.lastAppliedEventDate).to.equal(null);
    expect(res.body.createdBy.userName).to.equal('admin');
  });
}
