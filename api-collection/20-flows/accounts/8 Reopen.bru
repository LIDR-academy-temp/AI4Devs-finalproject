meta {
  name: 8 Reopen
  type: http
  seq: 8
  tags: [
    flow
  ]
}

patch {
  url: {{baseUrl}}/api/v1/accounts/:accountId
  body: json
  auth: bearer
}

params:path {
  accountId: {{flowNewAccountId}}
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "isActive": true
  }
}

vars:pre-request {
  as: admin
}

tests {
  test('admin reopens the account: 200, isActive true, the edits of step 5 kept', () => {
    expect(res.status).to.equal(200);
    expect(res.body.isActive).to.equal(true);
    expect(res.body.rollingReserveCapAmt).to.equal('2500.5000');
  });
}
