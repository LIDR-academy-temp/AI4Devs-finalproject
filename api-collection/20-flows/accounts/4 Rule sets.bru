meta {
  name: 4 Rule sets
  type: http
  seq: 4
  tags: [
    flow
  ]
}

get {
  url: {{baseUrl}}/api/v1/providers/:providerId/matching-rule-sets
  body: none
  auth: inherit
}

params:path {
  providerId: 201
}

tests {
  test('the new account is linked to "Provider C legacy", active', () => {
    expect(res.status).to.equal(200);
    const legacy = res.body.find((s) => s.name === 'Provider C legacy');
    const linked = legacy.accounts.find((a) => a.name === bru.getVar('flowAccountName'));
    expect(linked).to.include({ isActive: true });
    expect(linked.accountId.toLowerCase()).to.equal(String(bru.getVar('flowNewAccountId')).toLowerCase());
  });
}
