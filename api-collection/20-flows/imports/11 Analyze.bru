meta {
  name: 11 Analyze
  type: http
  seq: 11
  tags: [
    flow
  ]
}

post {
  url: {{baseUrl}}/api/v1/imports/:importId/analyze
  body: none
  auth: inherit
}

params:path {
  importId: {{flowImportId}}
}

script:post-response {
  if (res.status === 200) {
    const app = res.body.files[0].sheets.find((s) => s.sheetName === 'APP');
    bru.setVar('flowSheetId', app.sheetId);
  }
}

tests {
  test('analyzes the batch: 783 rows, 780 matched, 3 ignored, RAM-07 not assigned yet, two batch fees', () => {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal('analyzed');
    expect(res.body.analysis.rows).to.eql({ total: 783, matched: 780, unmatched: 0, ambiguous: 0, ignored: 3 });
    expect(res.body.analysis.byCycle).to.eql({ E: 450, I: 10, R: 320 });
    const ram07 = res.body.channels.find((c) => c.name === 'RAM-07');
    expect(ram07.assignment).to.equal('unassigned');
    expect(res.body.batchFees).to.have.length(2);
  });
}
