meta {
  name: 8 Add part2 again
  type: http
  seq: 8
  tags: [
    flow
  ]
}

post {
  url: {{baseUrl}}/api/v1/imports/:importId/files
  body: multipartForm
  auth: inherit
}

params:path {
  importId: {{flowImportId}}
}

body:multipart-form {
  files: @file(../data/samples/batch-split/Recon_Template_ProviderA-USD_batch-split_part2.xlsx)
}

script:post-response {
  if (res.status === 200) {
    bru.setVar('flowFileId2', res.body.files[1].fileId);
    // The proposal over both files; "12 Confirm mapping" turns it into the confirmation body.
    bru.setVar('flowDetail', res.body);
  }
}

tests {
  test('adds part2 back so that the batch is complete again (both files, ready to analyze)', () => {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal('uploaded');
    expect(res.body.files).to.have.length(2);
    expect(res.body.readiness.canAnalyze).to.equal(true);
  });
}
