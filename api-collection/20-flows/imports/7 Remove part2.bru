meta {
  name: 6 Remove part2
  type: http
  seq: 6
  tags: [
    flow
  ]
}

delete {
  url: {{baseUrl}}/api/v1/imports/:importId/files/:fileId
  body: none
  auth: inherit
}

params:path {
  importId: {{flowImportId}}
  fileId: {{flowFileId2}}
}

tests {
  test('removes part2 and answers the remaining file', () => {
    expect(res.status).to.equal(200);
    expect(res.body.files).to.have.length(1);
    expect(res.body.files[0].fileId).to.equal(bru.getVar('flowFileId1'));
  });
}
