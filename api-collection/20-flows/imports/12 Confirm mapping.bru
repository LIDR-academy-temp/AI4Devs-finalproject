meta {
  name: 12 Confirm mapping
  type: http
  seq: 12
  tags: [
    flow
  ]
}

put {
  url: {{baseUrl}}/api/v1/imports/:importId/mapping
  body: json
  auth: inherit
}

params:path {
  importId: {{flowImportId}}
}

body:json {
  {
    "sheets": []
  }
}

script:pre-request {
  // The confirmation accepts the proposal as "8 Add part2 again" returned it: every sheet, proposed columns only.
  const detail = bru.getVar('flowDetail');
  if (!detail) {
    throw new Error('flowDetail is missing: run "8 Add part2 again" first');
  }
  const sheets = detail.files.flatMap((file) =>
    file.sheets.map((sheet) => ({
      sheetId: sheet.sheetId,
      kind: sheet.proposed.kind,
      cycle: sheet.proposed.cycle,
      statusId: sheet.proposed.statusId,
      columns: sheet.columns
        .filter((column) => column.targetField !== null)
        .map((column) => ({ sourceColumn: column.sourceColumn, targetField: column.targetField })),
    })),
  );
  req.setBody({ sheets });
}

tests {
  test('confirms the proposal of both files: the import is mapped and every sheet is confirmed', () => {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal('mapped');
    const sheets = res.body.files.flatMap((f) => f.sheets);
    expect(sheets.every((s) => s.mappingConfirmed === true)).to.equal(true);
    const app = sheets.find((s) => s.sheetName === 'APP');
    expect(app.mapping.columns).to.have.length(3);
    expect(res.body.readiness.canAnalyze).to.equal(true);
  });
}
