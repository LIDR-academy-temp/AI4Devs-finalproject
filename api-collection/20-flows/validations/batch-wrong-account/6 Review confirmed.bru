meta {
  name: 6 Review confirmed
  type: http
  seq: 6
  tags: [
    flow
  ]
}

post {
  url: {{baseUrl}}/api/v1/imports/:importId/review
  body: json
  auth: inherit
}

params:path {
  importId: {{wraImportId}}
}

body:json {
  {
    "runId": 0,
    "inclusionVersion": 0
  }
}

script:pre-request {
  req.setBody({ runId: bru.getVar('wraRunId'), inclusionVersion: bru.getVar('wraInclusionVersion'), confirmEmptyBatch: true });
}

tests {
  test('with confirmEmptyBatch the import is validated', () => {
    expect(res.status).to.equal(200);
    expect(res.body.importStatus).to.equal('validated');
  });
}
