meta {
  name: 9 Cancel
  type: http
  seq: 9
  tags: [
    flow
  ]
}

post {
  url: {{baseUrl}}/api/v1/imports/:importId/cancel
  body: json
  auth: inherit
}

params:path {
  importId: {{wraImportId}}
}

body:json {
  {
    "reason": "Bruno flow cleanup: a file of another account"
  }
}

tests {
  test('the import is cancelled without having processed anything', () => {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal('cancelled');
  });
}
