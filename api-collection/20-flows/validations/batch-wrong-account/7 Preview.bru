meta {
  name: 7 Preview
  type: http
  seq: 7
  tags: [
    flow
  ]
}

post {
  url: {{baseUrl}}/api/v1/imports/:importId/settlements/preview
  body: json
  auth: inherit
}

params:path {
  importId: {{wraImportId}}
}

body:json {
  {
    "runId": 0
  }
}

script:pre-request {
  req.setBody({ runId: bru.getVar('wraRunId') });
}

tests {
  test('the preview reports the empty batch instead of a 409', () => {
    expect(res.status).to.equal(200);
    expect(res.body.requiresEmptyBatchConfirmation).to.equal(true);
    expect(res.body.emptyBatch.likelyWrongAccount).to.equal(true);
    expect(res.body.movements).to.eql({ E: 0, I: 0, R: 0 });
  });
}
