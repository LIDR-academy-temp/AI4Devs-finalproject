meta {
  name: 4 Run validations
  type: http
  seq: 4
  tags: [
    flow
  ]
}

post {
  url: {{baseUrl}}/api/v1/imports/:importId/validations
  body: none
  auth: inherit
}

params:path {
  importId: {{wraImportId}}
}

script:post-response {
  if (res.status === 201) {
    bru.setVar('wraRunId', res.body.run.runId);
  }
}

tests {
  test('the run is not blocked: the empty batch is not a validation', () => {
    expect(res.status).to.equal(201);
    expect(res.body.run.blocked).to.equal(false);
  });
}
