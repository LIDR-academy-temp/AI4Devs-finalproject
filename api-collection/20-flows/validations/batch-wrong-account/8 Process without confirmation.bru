meta {
  name: 8 Process without confirmation
  type: http
  seq: 8
  tags: [
    flow
  ]
}

post {
  url: {{baseUrl}}/api/v1/imports/:importId/settlements
  body: json
  auth: inherit
}

params:path {
  importId: {{wraImportId}}
}

body:json {
  {
    "runId": 0
  }
}

script:pre-request {
  req.setBody({ runId: bru.getVar('wraRunId') });
}

tests {
  test('409 no_matched_rows: nothing is processed', () => {
    expect(res.status).to.equal(409);
    expect(res.body.code).to.equal('no_matched_rows');
    expect(res.body.details.likelyWrongAccount).to.equal(true);
  });
}
