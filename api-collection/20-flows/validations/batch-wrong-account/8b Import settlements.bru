meta {
  name: 8b Import settlements
  type: http
  seq: 9
  tags: [
    flow
  ]
}

get {
  url: {{baseUrl}}/api/v1/imports/:importId/settlements
  body: none
  auth: inherit
}

params:path {
  importId: {{wraImportId}}
}

tests {
  test('the refused processing created no attempt: the import has no settlements (review-diff #135, point 7)', () => {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.eql([]);
    expect(res.body.currentBatchId).to.equal(null);
  });
}
