meta {
  name: 16b Validations after include
  type: http
  seq: 17
  tags: [
    flow
  ]
}

get {
  url: {{baseUrl}}/api/v1/imports/:importId/validations
  body: none
  auth: inherit
}

params:path {
  importId: {{valImportId}}
}

tests {
  test('the current run is the reviewed one, without a valid review and with the invalidation', () => {
    expect(res.status).to.equal(200);
    expect(res.body.run.runId).to.equal(bru.getVar('runId2'));
    expect(res.body.run.review).to.equal(null);
    expect(res.body.lastInvalidatedReview.reason).to.equal('inclusion_change');
  });
}
