meta {
  name: 10 Include again
  type: http
  seq: 10
  tags: [
    flow
  ]
}

patch {
  url: {{baseUrl}}/api/v1/conflict-occurrences/:occurrenceId
  body: json
  auth: inherit
}

params:path {
  occurrenceId: {{excludedOccurrenceId}}
}

body:json {
  {
    "includeInSettlement": true
  }
}

tests {
  test('the same value: 200 and no new history entry', () => {
    expect(res.status).to.equal(200);
    expect(res.body.history).to.have.length(1);
  });
}
