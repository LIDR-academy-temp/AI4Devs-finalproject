meta {
  name: 19 Cancel
  type: http
  seq: 25
  tags: [
    flow
  ]
}

post {
  url: {{baseUrl}}/api/v1/imports/:importId/cancel
  body: json
  auth: inherit
}

params:path {
  importId: {{valImportId}}
}

body:json {
  {
    "reason": "Bruno flow cleanup"
  }
}

tests {
  test('the flow leaves nothing open: the import is cancelled', () => {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal('cancelled');
  });
}
