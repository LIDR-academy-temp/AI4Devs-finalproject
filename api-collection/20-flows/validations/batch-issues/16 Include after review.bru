meta {
  name: 16 Include after review
  type: http
  seq: 16
  tags: [
    flow
  ]
}

patch {
  url: {{baseUrl}}/api/v1/conflict-occurrences/:occurrenceId
  body: json
  auth: inherit
}

params:path {
  occurrenceId: {{excludedOccurrenceId}}
}

body:json {
  {
    "includeInSettlement": false
  }
}

tests {
  test('changing an inclusion of a validated import takes it back to analyzed (the invalidation is checked in 16b)', () => {
    expect(res.status).to.equal(200);
    expect(res.body.importStatus).to.equal('analyzed');
  });
}
