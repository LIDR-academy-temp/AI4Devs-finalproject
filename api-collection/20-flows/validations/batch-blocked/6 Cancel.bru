meta {
  name: 6 Cancel
  type: http
  seq: 6
  tags: [
    flow
  ]
}

post {
  url: {{baseUrl}}/api/v1/imports/:importId/cancel
  body: json
  auth: inherit
}

params:path {
  importId: {{blkImportId}}
}

body:json {
  {
    "reason": "Bruno flow cleanup"
  }
}

tests {
  test('cancelling is the only way out of a blocked run', () => {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal('cancelled');
  });
}
