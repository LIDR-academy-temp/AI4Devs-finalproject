meta {
  name: 2 Providers
  type: http
  seq: 2
  tags: [
    flow
  ]
}

get {
  url: {{baseUrl}}/api/v1/merchants/:merchantId/providers
  body: none
  auth: inherit
}

params:path {
  merchantId: {{flowMerchantId}}
}

script:post-response {
  const provider = Array.isArray(res.body) && res.body.find((p) => p.name === 'Provider A');
  if (provider) {
    bru.setVar('flowProviderId', provider.providerId);
  }
}

tests {
  test('Merchant A has Provider A and Provider B', () => {
    expect(res.status).to.equal(200);
    expect(res.body.map((p) => p.name)).to.deep.equal(['Provider A', 'Provider B']);
  });
}
