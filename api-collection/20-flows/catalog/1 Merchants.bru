meta {
  name: 1 Merchants
  type: http
  seq: 1
  tags: [
    flow
  ]
}

get {
  url: {{baseUrl}}/api/v1/merchants
  body: none
  auth: inherit
}

script:post-response {
  const merchant = Array.isArray(res.body) && res.body.find((m) => m.name === 'Merchant A');
  if (merchant) {
    bru.setVar('flowMerchantId', merchant.merchantId);
  }
}

tests {
  test('analyst sees Merchant A and Merchant B', () => {
    expect(res.status).to.equal(200);
    expect(res.body.map((m) => m.name)).to.have.members(['Merchant A', 'Merchant B']);
  });
}
