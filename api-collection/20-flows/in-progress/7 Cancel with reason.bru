meta {
  name: 7 Cancel with reason
  type: http
  seq: 7
  tags: [
    flow
  ]
}

post {
  url: {{baseUrl}}/api/v1/imports/:importId/cancel
  body: json
  auth: inherit
}

params:path {
  importId: {{inProgressImportId}}
}

body:json {
  {
    "reason": "  Bruno flow cleanup  "
  }
}

tests {
  test('cancels with the reason: the flow leaves nothing open behind', () => {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal('cancelled');
  });
}
