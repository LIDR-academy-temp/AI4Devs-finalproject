meta {
  name: 3 Confirm mapping
  type: http
  seq: 3
  tags: [
    flow
  ]
}

put {
  url: {{baseUrl}}/api/v1/imports/:importId/mapping
  body: json
  auth: inherit
}

params:path {
  importId: {{inProgressImportId}}
}

body:json {
  {
    "sheets": []
  }
}

script:pre-request {
  // Confirms the proposal as the upload returned it: every sheet, proposed columns only.
  const detail = bru.getVar('inProgressDetail');
  if (!detail) {
    throw new Error('inProgressDetail is missing: run "1 Upload legacy" first');
  }
  const sheets = detail.files.flatMap((file) =>
    file.sheets.map((sheet) => ({
      sheetId: sheet.sheetId,
      kind: sheet.proposed.kind,
      cycle: sheet.proposed.cycle,
      statusId: sheet.proposed.statusId,
      columns: sheet.columns
        .filter((column) => column.targetField !== null)
        .map((column) => ({ sourceColumn: column.sourceColumn, targetField: column.targetField })),
    })),
  );
  req.setBody({ sheets });
}

tests {
  test('confirms the proposal: mapped and ready to analyze', () => {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal('mapped');
    expect(res.body.readiness.canAnalyze).to.equal(true);
  });
}
