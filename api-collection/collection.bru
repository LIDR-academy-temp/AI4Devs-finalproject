meta {
  name: Recon Tool API
}

auth {
  mode: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  // Logs in on demand so any folder or single request can run on its own (design D3).
  // Requests that log in themselves (auth folder, flows) set the request var `selfAuth: true`.
  // Requests that must run as the viewer set the request var `as: viewer` and use {{viewerToken}}.
  const name = req.getName();
  if (name === 'Login' || name === 'Login as viewer' || bru.getRequestVar('selfAuth') === 'true') {
    return;
  }
  if (!bru.getVar('accessToken')) {
    await bru.runRequest('00-auth/Login');
  }
  if (bru.getRequestVar('as') === 'viewer' && !bru.getVar('viewerToken')) {
    await bru.runRequest('00-auth/Login as viewer');
  }
}
