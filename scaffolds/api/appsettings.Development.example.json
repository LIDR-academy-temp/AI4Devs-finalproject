{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=CuartaQuinientos;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "cuartaquinientos-api",
    "Audience": "cuartaquinientos-web",
    "SecretKey": "CAMBIAR_EN_USER_SECRETS_O_ENV",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },
  "Assistant": {
    "Provider": "Anthropic",
    "DefaultModel": "claude-sonnet-4-20250514",
    "FallbackModel": "claude-haiku-4-20250514",
    "MinConfidenceToAnswer": 0.72,
    "EscalateOnLowConfidence": true,
    "MaxOutputTokens": 1024,
    "Temperature": 0.2,
    "Rag": {
      "TopK": 5,
      "MinSimilarity": 0.75,
      "MaxContextChars": 12000
    },
    "Intents": {
      "UseLlmClassifier": true,
      "DeterministicCommandsFirst": true
    }
  },
  "Telegram": {
    "BotToken": "",
    "WebhookUrl": "",
    "WebhookSecret": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
