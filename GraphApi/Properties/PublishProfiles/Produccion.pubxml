<?xml version="1.0" encoding="utf-8"?>
<!-- OBSOLETO: no usar para GraphApi. El portal web es SPA estatica (Web/dist).
     API correcta: IISProfile.pubxml -> apicuartaquinientos.runasp.net
     Web: scripts/Deploy-Produccion.ps1 -Solo Web + cuartaquinientosresidencial*.publishSettings -->
<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <SelfContained>false</SelfContained>
    <MSDeployServiceURL>site64404.siteasp.net</MSDeployServiceURL>
    <DeployIisAppPath>site64404</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>true</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <EnableMSDeployBackup>true</EnableMSDeployBackup>
    <EnableMsDeployAppOffline>true</EnableMsDeployAppOffline>
    <UserName>site64404</UserName>
    <_SavePWD>true</_SavePWD>
    <_TargetId>IISWebDeploy</_TargetId>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>
</Project>
