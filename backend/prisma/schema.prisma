// Recon Tool 2.0 — data model (README §3.2, v7.7)
// Conventions: amounts DECIMAL(19,4); percentages DECIMAL(9,6) as a fraction;
// uniqueidentifier values generated by the application; every table has createdAt.
// What Prisma cannot express (CHECK, filtered unique indexes, fee non-overlap
// trigger) lives in the SQL migration: prisma/migrations/0001_init/migration.sql.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

// ───────────────────────── Catalog (read-only for the app) ─────────────────────────

model Gateway {
  gatewayId Int    @id
  name      String @unique @db.VarChar(50)
  /// numeric | uuid — how sourceTransactionId is normalized
  idFormat  String @db.VarChar(10)
  createdAt DateTime @default(now()) @db.DateTime2

  channels     Channel[]
  transactions Transaction[]
  importRows   ImportRow[]
}

model Merchant {
  merchantId Int     @id
  name       String  @unique @db.VarChar(100)
  isActive   Boolean @default(true)
  createdAt  DateTime @default(now()) @db.DateTime2

  providers     Provider[]
  transactions  Transaction[]
  userMerchants UserMerchant[]
}

model Provider {
  providerId Int     @id
  merchantId Int
  name       String  @db.VarChar(100)
  isActive   Boolean @default(true)
  createdAt  DateTime @default(now()) @db.DateTime2

  merchant     Merchant          @relation(fields: [merchantId], references: [merchantId], onDelete: NoAction, onUpdate: NoAction)
  channels     Channel[]
  accounts     Account[]
  ruleSets     MatchingRuleSet[]
  transactions Transaction[]

  @@unique([merchantId, name])
}

/// Channel (RAM) through which transactions are processed, with its settlement parameters.
model Channel {
  channelId          Int     @id
  gatewayId          Int
  providerId         Int
  name               String  @db.VarChar(50)
  isActive           Boolean @default(true)
  settlementTermDays Int
  rollingReservePct  Decimal @db.Decimal(9, 6)
  rollingReserveDays Int
  createdAt          DateTime @default(now()) @db.DateTime2

  gateway         Gateway          @relation(fields: [gatewayId], references: [gatewayId], onDelete: NoAction, onUpdate: NoAction)
  provider        Provider         @relation(fields: [providerId], references: [providerId], onDelete: NoAction, onUpdate: NoAction)
  accountChannels AccountChannel[]
  transactions    Transaction[]

  @@unique([gatewayId, name])
  @@index([providerId])
}

// ───────────────────────── Accounts ─────────────────────────

model Account {
  accountId               String   @id @db.UniqueIdentifier
  providerId              Int
  name                    String   @unique @db.VarChar(50)
  /// hold_until_term | release_on_chargeback
  chargebackReservePolicy String   @db.VarChar(30)
  rollingReserveCapAmt    Decimal? @db.Decimal(19, 4)
  matchingRuleSetId       Int?
  isActive                Boolean  @default(true)
  createdByUserId         Int
  createdAt               DateTime @default(now()) @db.DateTime2
  updatedAt               DateTime @updatedAt @db.DateTime2

  provider        Provider          @relation(fields: [providerId], references: [providerId], onDelete: NoAction, onUpdate: NoAction)
  matchingRuleSet MatchingRuleSet?  @relation(fields: [matchingRuleSetId], references: [ruleSetId], onDelete: NoAction, onUpdate: NoAction)
  createdBy       User              @relation("AccountCreatedBy", fields: [createdByUserId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  accountChannels AccountChannel[]
  fees            Fee[]
  imports         Import[]
  batches         SettlementBatch[]

  @@index([providerId])
}

/// Account–channel association; the primary one is the last account that processed a settlement with the channel.
model AccountChannel {
  accountId         String   @db.UniqueIdentifier
  channelId         Int
  isPrimary         Boolean
  assignedAt        DateTime @db.DateTime2
  assignedInBatchId String?  @db.UniqueIdentifier
  assignedByUserId  Int?

  account         Account          @relation(fields: [accountId], references: [accountId], onDelete: NoAction, onUpdate: NoAction)
  channel         Channel          @relation(fields: [channelId], references: [channelId], onDelete: NoAction, onUpdate: NoAction)
  assignedInBatch SettlementBatch? @relation(fields: [assignedInBatchId], references: [batchId], onDelete: NoAction, onUpdate: NoAction)
  assignedBy      User?            @relation(fields: [assignedByUserId], references: [userId], onDelete: NoAction, onUpdate: NoAction)

  @@id([accountId, channelId])
  @@index([channelId])
  // filtered unique index (channelId) WHERE isPrimary = 1 → migration
}

// ───────────────────────── Fees ─────────────────────────

model FeeType {
  feeTypeId         Int     @id
  code              String  @unique @db.VarChar(50)
  title             String  @db.VarChar(80)
  isTransactional   Boolean
  appliesToStatusId Int?
  allowsFreeAmount  Boolean @default(false)
  isActive          Boolean @default(true)

  appliesToStatus TransactionStatus?        @relation(fields: [appliesToStatusId], references: [statusId], onDelete: NoAction, onUpdate: NoAction)
  fees            Fee[]
  batchFees       SettlementBatchFee[]
  appliedFees     SettlementTransactionFee[]
}

model Fee {
  feeId                 String    @id @db.UniqueIdentifier
  accountId             String    @db.UniqueIdentifier
  feeTypeId             Int
  fixedAmount           Decimal?  @db.Decimal(19, 4)
  percentage            Decimal?  @db.Decimal(9, 6)
  conditionalPercentage Decimal?  @db.Decimal(9, 6)
  conditionThresholdAmt Decimal?  @db.Decimal(19, 4)
  brandFixedAmount      Decimal?  @db.Decimal(19, 4)
  brandPercentage       Decimal?  @db.Decimal(9, 6)
  /// NULL = since forever
  startDate             DateTime? @db.Date
  /// NULL = no end
  endDate               DateTime? @db.Date
  description           String?   @db.VarChar(100)
  createdByUserId       Int
  createdAt             DateTime  @default(now()) @db.DateTime2
  updatedAt             DateTime  @updatedAt @db.DateTime2

  account     Account                    @relation(fields: [accountId], references: [accountId], onDelete: NoAction, onUpdate: NoAction)
  feeType     FeeType                    @relation(fields: [feeTypeId], references: [feeTypeId], onDelete: NoAction, onUpdate: NoAction)
  createdBy   User                       @relation(fields: [createdByUserId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  history     FeeHistory[]
  batchFees   SettlementBatchFee[]
  appliedFees SettlementTransactionFee[]

  @@index([accountId, feeTypeId, startDate, endDate])
}

model FeeHistory {
  feeHistoryId    Int      @id @default(autoincrement())
  feeId           String   @db.UniqueIdentifier
  changedByUserId Int
  changedAt       DateTime @default(now()) @db.DateTime2
  /// created | updated | closed | copied
  action          String   @db.VarChar(20)
  beforeJson      String?  @db.NVarChar(Max)
  afterJson       String   @db.NVarChar(Max)
  reason          String?  @db.NVarChar(500)

  fee       Fee  @relation(fields: [feeId], references: [feeId], onDelete: NoAction, onUpdate: NoAction)
  changedBy User @relation(fields: [changedByUserId], references: [userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([feeId, changedAt])
}

// ───────────────────────── Matching rules ─────────────────────────

model MatchingRuleSet {
  ruleSetId  Int     @id @default(autoincrement())
  providerId Int
  name       String  @db.VarChar(80)
  isActive   Boolean @default(true)
  createdAt  DateTime @default(now()) @db.DateTime2

  provider    Provider                @relation(fields: [providerId], references: [providerId], onDelete: NoAction, onUpdate: NoAction)
  accounts    Account[]
  sheetRules  MatchingSheetRule[]
  columnRules MatchingColumnRule[]
  rowIgnores  MatchingRowIgnoreRule[]

  @@unique([providerId, name])
}

/// Sheet name pattern → kind + cycle + statusId. ruleSetId NULL = global.
model MatchingSheetRule {
  sheetRuleId  Int     @id @default(autoincrement())
  ruleSetId    Int?
  sheetPattern String  @db.NVarChar(128)
  isRegex      Boolean @default(false)
  /// transactions | batch_fees | ignore
  kind         String  @db.VarChar(20)
  cycle        String? @db.Char(1)
  statusId     Int?
  priority     Int     @default(100)
  isActive     Boolean @default(true)

  ruleSet     MatchingRuleSet?   @relation(fields: [ruleSetId], references: [ruleSetId], onDelete: NoAction, onUpdate: NoAction)
  cycleRef    Cycle?             @relation(fields: [cycle], references: [cycle], onDelete: NoAction, onUpdate: NoAction)
  status      TransactionStatus? @relation(fields: [statusId], references: [statusId], onDelete: NoAction, onUpdate: NoAction)

  @@index([ruleSetId, priority])
}

/// Column name pattern → targetField. ruleSetId NULL = global; sheetPattern NULL = any sheet.
model MatchingColumnRule {
  columnRuleId  Int     @id @default(autoincrement())
  ruleSetId     Int?
  sheetPattern  String? @db.NVarChar(128)
  columnPattern String  @db.NVarChar(128)
  isRegex       Boolean @default(false)
  /// transactionId | status | gateway | amount | currency | txnDate | feeType | providerRef | orderId | reference
  targetField   String  @db.VarChar(30)
  priority      Int     @default(100)
  isActive      Boolean @default(true)

  ruleSet MatchingRuleSet? @relation(fields: [ruleSetId], references: [ruleSetId], onDelete: NoAction, onUpdate: NoAction)

  @@index([ruleSetId, priority])
}

model MatchingRowIgnoreRule {
  rowIgnoreId Int     @id @default(autoincrement())
  ruleSetId   Int?
  /// Expression over the row: e.g. "transactionId:empty" or a regex over rawData
  pattern     String  @db.NVarChar(200)
  isRegex     Boolean @default(false)
  description String? @db.NVarChar(200)
  isActive    Boolean @default(true)

  ruleSet MatchingRuleSet? @relation(fields: [ruleSetId], references: [ruleSetId], onDelete: NoAction, onUpdate: NoAction)
}

/// Global: status text as read → statusId; excludeAmount for aliases such as "CHB 2".
model MatchingStatusAlias {
  alias         String  @id @db.NVarChar(50)
  statusId      Int
  excludeAmount Boolean @default(false)
  isLegacy      Boolean @default(false)

  status TransactionStatus @relation(fields: [statusId], references: [statusId], onDelete: NoAction, onUpdate: NoAction)
}

// ───────────────────────── Cycle and status catalogs ─────────────────────────

/// E transaction · I adjustment · R reserve
model Cycle {
  cycle String @id @db.Char(1)
  name  String @db.VarChar(30)

  sheetRules     MatchingSheetRule[]
  importRows     ImportRow[]
  settlementTxns SettlementTransaction[]
  issues         ValidationIssue[]
}

/// Gateway statuses; cycle = natural cycle (E or I). The rolling reserve is not a status.
model TransactionStatus {
  statusId Int    @id
  code     String @unique @db.VarChar(20)
  name     String @db.VarChar(50)
  cycle    String @db.Char(1)

  transactions   Transaction[]
  aliases        MatchingStatusAlias[]
  sheetRules     MatchingSheetRule[]
  importSheets   ImportSheet[]
  importRows     ImportRow[]
  feeTypes       FeeType[]
  settlementTxns SettlementTransaction[]
  issues         ValidationIssue[]
  occurrences    ConflictOccurrence[]
}

model SettlementStatus {
  settlementStatusId Int    @id
  name               String @unique @db.VarChar(30)

  settlementTxns SettlementTransaction[]
}

// ───────────────────────── Own transactions ─────────────────────────

/// Source of transactions; synthetic in the MVP.
model Transaction {
  transactionId       BigInt    @id @default(autoincrement())
  sourceTransactionId String    @db.VarChar(36)
  gatewayId           Int
  merchantId          Int
  providerId          Int
  channelId           Int
  orderId             String?   @db.VarChar(50)
  amount              Decimal   @db.Decimal(19, 4)
  currency            String    @default("USD") @db.Char(3)
  cardBrand           String?   @db.VarChar(20)
  statusId            Int
  transactionDate     DateTime  @db.DateTime2
  lastStatusChangedAt DateTime? @db.DateTime2
  appliedReservePct   Decimal   @db.Decimal(9, 6)
  createdAt           DateTime  @default(now()) @db.DateTime2

  gateway        Gateway                 @relation(fields: [gatewayId], references: [gatewayId], onDelete: NoAction, onUpdate: NoAction)
  merchant       Merchant                @relation(fields: [merchantId], references: [merchantId], onDelete: NoAction, onUpdate: NoAction)
  provider       Provider                @relation(fields: [providerId], references: [providerId], onDelete: NoAction, onUpdate: NoAction)
  channel        Channel                 @relation(fields: [channelId], references: [channelId], onDelete: NoAction, onUpdate: NoAction)
  status         TransactionStatus       @relation(fields: [statusId], references: [statusId], onDelete: NoAction, onUpdate: NoAction)
  importRows     ImportRow[]
  settlementTxns SettlementTransaction[]
  issues         ValidationIssue[]

  @@unique([gatewayId, sourceTransactionId])
  @@index([providerId, transactionDate])
  @@index([merchantId, transactionDate])
  @@index([channelId, transactionDate])
  @@index([statusId])
}

// ───────────────────────── Import ─────────────────────────

model Import {
  importId        String    @id @db.UniqueIdentifier
  accountId       String    @db.UniqueIdentifier
  createdByUserId Int
  /// uploaded | mapped | analyzed | validated | processed | cancelled
  status          String    @db.VarChar(20)
  analyzedAt      DateTime? @db.DateTime2
  rowsTotal       Int?
  rowsMatched     Int?
  rowsUnmatched   Int?
  currentBatchId  String?   @db.UniqueIdentifier
  createdAt       DateTime  @default(now()) @db.DateTime2
  updatedAt       DateTime  @updatedAt @db.DateTime2

  account      Account           @relation(fields: [accountId], references: [accountId], onDelete: NoAction, onUpdate: NoAction)
  createdBy    User              @relation(fields: [createdByUserId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  currentBatch SettlementBatch?  @relation("ImportCurrentBatch", fields: [currentBatchId], references: [batchId], onDelete: NoAction, onUpdate: NoAction)
  files        ImportFile[]
  batches      SettlementBatch[] @relation("BatchImport")
  runs         ValidationRun[]

  @@index([accountId, createdAt])
}

model ImportFile {
  fileId      String   @id @db.UniqueIdentifier
  importId    String   @db.UniqueIdentifier
  fileName    String   @db.NVarChar(255)
  storagePath String   @db.NVarChar(500)
  sizeBytes   Int
  sha256      String   @db.Char(64)
  uploadedAt  DateTime @default(now()) @db.DateTime2
  ignore      Boolean  @default(false)

  import      Import               @relation(fields: [importId], references: [importId], onDelete: NoAction, onUpdate: NoAction)
  sheets      ImportSheet[]
  occurrences ConflictOccurrence[]

  @@unique([importId, sha256])
}

model ImportSheet {
  sheetId          String  @id @db.UniqueIdentifier
  fileId           String  @db.UniqueIdentifier
  sheetName        String  @db.NVarChar(128)
  /// transactions | batch_fees | ignore
  kind             String  @db.VarChar(20)
  cycle            String? @db.Char(1)
  statusId         Int?
  rowCount         Int     @default(0)
  mappingConfirmed Boolean @default(false)
  /// Position of the sheet in its workbook (0 = first); NULL for imports uploaded before 0006
  sheetIndex       Int?

  file       ImportFile             @relation(fields: [fileId], references: [fileId], onDelete: NoAction, onUpdate: NoAction)
  status     TransactionStatus?     @relation(fields: [statusId], references: [statusId], onDelete: NoAction, onUpdate: NoAction)
  columnMaps ImportSheetColumnMap[]
  rows       ImportRow[]
  settlementTxns SettlementTransaction[]

  @@index([fileId])
}

/// Confirmed mapping: source of truth for parsing that sheet.
model ImportSheetColumnMap {
  sheetId      String @db.UniqueIdentifier
  sourceColumn String @db.NVarChar(128)
  targetField  String @db.VarChar(30)

  sheet ImportSheet @relation(fields: [sheetId], references: [sheetId], onDelete: NoAction, onUpdate: NoAction)

  @@id([sheetId, sourceColumn])
}

model ImportRow {
  sheetId          String    @db.UniqueIdentifier
  rowNo            Int
  transactionIdRaw String?   @db.NVarChar(100)
  transactionId    BigInt?
  gatewayId        Int?
  statusRaw        String?   @db.NVarChar(50)
  statusId         Int?
  cycle            String    @db.Char(1)
  amount           Decimal?  @db.Decimal(19, 4)
  currency         String?   @db.Char(3)
  txnDate          DateTime? @db.DateTime2
  feeTypeRaw       String?   @db.NVarChar(100)
  rawData          String    @db.NVarChar(Max)
  ignore           Boolean   @default(false)
  /// matched | unmatched | ambiguous | ignored
  matchResult      String    @db.VarChar(20)
  detailJson       String?   @db.NVarChar(Max)

  sheet       ImportSheet        @relation(fields: [sheetId], references: [sheetId], onDelete: NoAction, onUpdate: NoAction)
  transaction Transaction?       @relation(fields: [transactionId], references: [transactionId], onDelete: NoAction, onUpdate: NoAction)
  gateway     Gateway?           @relation(fields: [gatewayId], references: [gatewayId], onDelete: NoAction, onUpdate: NoAction)
  status      TransactionStatus? @relation(fields: [statusId], references: [statusId], onDelete: NoAction, onUpdate: NoAction)
  cycleRef    Cycle              @relation(fields: [cycle], references: [cycle], onDelete: NoAction, onUpdate: NoAction)

  @@id([sheetId, rowNo])
  @@index([transactionId])
  @@index([sheetId, statusId])
  @@index([transactionIdRaw])
}

// ───────────────────────── Validations and issues ─────────────────────────

model ValidationRun {
  runId               Int       @id @default(autoincrement())
  importId            String    @db.UniqueIdentifier
  runAt               DateTime  @default(now()) @db.DateTime2
  runByUserId         Int
  dateMinApp          DateTime? @db.DateTime2
  dateMaxApp          DateTime? @db.DateTime2
  dateMinDec          DateTime? @db.DateTime2
  dateMaxDec          DateTime? @db.DateTime2
  dateMinI            DateTime? @db.DateTime2
  dateMaxI            DateTime? @db.DateTime2
  dateMinR            DateTime? @db.DateTime2
  dateMaxR            DateTime? @db.DateTime2
  pendingInRangeCount Int       @default(0)
  /// I rows without a status change date (informative)
  undatedAdjustmentCount Int    @default(0)
  /// I candidates without a status change date (informative)
  undatedCandidateCount  Int    @default(0)
  isSuperseded        Boolean   @default(false)

  import  Import             @relation(fields: [importId], references: [importId], onDelete: NoAction, onUpdate: NoAction)
  runBy   User               @relation(fields: [runByUserId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  results ValidationResult[]

  @@index([importId, runAt])
  // filtered unique index (importId) WHERE isSuperseded = 0 → migration
}

model ValidationResult {
  resultId       Int    @id @default(autoincrement())
  runId          Int
  validationCode String @db.VarChar(40)
  /// passed | warning | blocked | not_applicable | not_implemented
  outcome        String @db.VarChar(20)
  issueCount     Int    @default(0)
  detailJson     String? @db.NVarChar(Max)

  run    ValidationRun     @relation(fields: [runId], references: [runId], onDelete: NoAction, onUpdate: NoAction)
  issues ValidationIssue[]

  @@unique([runId, validationCode])
}

model ValidationIssue {
  issueId           Int       @id @default(autoincrement())
  resultId          Int
  /// provider_mismatch | non_recorded_adjustment | status_mismatch | duplicate | collision | missing
  issueType         String    @db.VarChar(30)
  /// in_batch | across_batches | previous_to_batch | in_range
  scope             String?   @db.VarChar(30)
  blocking          Boolean   @default(false)
  transactionIdRaw  String?   @db.NVarChar(100)
  transactionId     BigInt?
  cycle             String?   @db.Char(1)
  statusId          Int?
  missingType       String?   @db.VarChar(30)
  relevantDate      DateTime? @db.DateTime2
  detectedInBatchId String?   @db.UniqueIdentifier
  detailJson        String?   @db.NVarChar(Max)
  /// persistent | resolved
  resolutionStatus  String    @default("persistent") @db.VarChar(20)
  resolvedInBatchId String?   @db.UniqueIdentifier
  resolvedAt        DateTime? @db.DateTime2
  resolvedByUserId  Int?
  resolutionNote    String?   @db.NVarChar(500)
  createdAt         DateTime  @default(now()) @db.DateTime2

  result           ValidationResult     @relation(fields: [resultId], references: [resultId], onDelete: NoAction, onUpdate: NoAction)
  transaction      Transaction?         @relation(fields: [transactionId], references: [transactionId], onDelete: NoAction, onUpdate: NoAction)
  cycleRef         Cycle?               @relation(fields: [cycle], references: [cycle], onDelete: NoAction, onUpdate: NoAction)
  status           TransactionStatus?   @relation(fields: [statusId], references: [statusId], onDelete: NoAction, onUpdate: NoAction)
  detectedInBatch  SettlementBatch?     @relation("IssueDetectedIn", fields: [detectedInBatchId], references: [batchId], onDelete: NoAction, onUpdate: NoAction)
  resolvedInBatch  SettlementBatch?     @relation("IssueResolvedIn", fields: [resolvedInBatchId], references: [batchId], onDelete: NoAction, onUpdate: NoAction)
  resolvedBy       User?                @relation(fields: [resolvedByUserId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  occurrences      ConflictOccurrence[]

  @@index([resultId, issueType])
  @@index([transactionId, cycle, resolutionStatus])
}

model ConflictOccurrence {
  occurrenceId        BigInt    @id @default(autoincrement())
  issueId             Int
  /// current_import | previous_batch
  sourceType          String    @db.VarChar(20)
  batchId             String?   @db.UniqueIdentifier
  fileId              String?   @db.UniqueIdentifier
  sheetId             String?   @db.UniqueIdentifier
  rowNo               Int?
  /// NULL: the row's status could not be resolved (it still collides)
  statusId            Int?
  includeInSettlement Boolean
  defaultIncluded     Boolean
  changedByUserId     Int?
  changedAt           DateTime? @db.DateTime2

  issue     ValidationIssue   @relation(fields: [issueId], references: [issueId], onDelete: NoAction, onUpdate: NoAction)
  batch     SettlementBatch?  @relation(fields: [batchId], references: [batchId], onDelete: NoAction, onUpdate: NoAction)
  file      ImportFile?       @relation(fields: [fileId], references: [fileId], onDelete: NoAction, onUpdate: NoAction)
  status    TransactionStatus? @relation(fields: [statusId], references: [statusId], onDelete: NoAction, onUpdate: NoAction)
  changedBy User?             @relation(fields: [changedByUserId], references: [userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([issueId])
}

// ───────────────────────── Settlement ─────────────────────────

model SettlementBatch {
  batchId            String    @id @db.UniqueIdentifier
  accountId          String    @db.UniqueIdentifier
  batchNo            Int
  attemptNo          Int       @default(1)
  importId           String    @db.UniqueIdentifier
  /// processed | paid | undone
  status             String    @db.VarChar(20)
  approvedByUserId   Int
  processedAt        DateTime  @default(now()) @db.DateTime2
  settlementDate     DateTime? @db.Date
  paidAt             DateTime? @db.DateTime2
  paidByUserId       Int?
  undoneAt           DateTime? @db.DateTime2
  undoneByUserId     Int?
  undoReason         String?   @db.NVarChar(500)
  dateMinApp         DateTime? @db.DateTime2
  dateMaxApp         DateTime? @db.DateTime2
  dateMinDec         DateTime? @db.DateTime2
  dateMaxDec         DateTime? @db.DateTime2
  dateMinI           DateTime? @db.DateTime2
  dateMaxI           DateTime? @db.DateTime2
  dateMinR           DateTime? @db.DateTime2
  dateMaxR           DateTime? @db.DateTime2
  mdrAmt             Decimal   @default(0) @db.Decimal(19, 4)
  mdrRate            Decimal?  @db.Decimal(9, 6)
  otherFeeAmt        Decimal   @default(0) @db.Decimal(19, 4)
  reserveHeldAmt     Decimal   @default(0) @db.Decimal(19, 4)
  reserveReleasedAmt Decimal   @default(0) @db.Decimal(19, 4)
  amountPayable      Decimal   @default(0) @db.Decimal(19, 4)
  channels           String?   @db.VarChar(100)
  createdAt          DateTime  @default(now()) @db.DateTime2
  updatedAt          DateTime  @updatedAt @db.DateTime2

  account          Account                     @relation(fields: [accountId], references: [accountId], onDelete: NoAction, onUpdate: NoAction)
  import           Import                      @relation("BatchImport", fields: [importId], references: [importId], onDelete: NoAction, onUpdate: NoAction)
  approvedBy       User                        @relation("BatchApprovedBy", fields: [approvedByUserId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  paidBy           User?                       @relation("BatchPaidBy", fields: [paidByUserId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  undoneBy         User?                       @relation("BatchUndoneBy", fields: [undoneByUserId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  currentOfImports Import[]                    @relation("ImportCurrentBatch")
  fees             SettlementBatchFee[]
  totals           SettlementBatchTotal[]
  brandTotals      SettlementBatchBrandTotal[]
  transactions     SettlementTransaction[]
  accountChannels  AccountChannel[]
  issuesDetected   ValidationIssue[]           @relation("IssueDetectedIn")
  issuesResolved   ValidationIssue[]           @relation("IssueResolvedIn")
  occurrences      ConflictOccurrence[]

  @@unique([accountId, batchNo, attemptNo])
  @@index([importId])
  @@index([accountId, status, settlementDate])
  // filtered unique indexes (accountId, batchNo) and (importId) WHERE status <> 'undone' → migration
}

model SettlementBatchFee {
  batchFeeId      Int      @id @default(autoincrement())
  batchId         String   @db.UniqueIdentifier
  feeTypeId       Int
  feeId           String?  @db.UniqueIdentifier
  amount          Decimal  @db.Decimal(19, 4)
  description     String?  @db.NVarChar(200)
  /// file | manual — whether it came pre-filled from the Other Fees sheet or was added by the analyst
  source          String   @default("manual") @db.VarChar(10)
  enteredByUserId Int
  createdAt       DateTime @default(now()) @db.DateTime2

  batch     SettlementBatch @relation(fields: [batchId], references: [batchId], onDelete: NoAction, onUpdate: NoAction)
  feeType   FeeType         @relation(fields: [feeTypeId], references: [feeTypeId], onDelete: NoAction, onUpdate: NoAction)
  fee       Fee?            @relation(fields: [feeId], references: [feeId], onDelete: NoAction, onUpdate: NoAction)
  enteredBy User            @relation(fields: [enteredByUserId], references: [userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([batchId])
}

/// category ∈ deposit | declined | chargeback | refund | rdr
model SettlementBatchTotal {
  batchId   String  @db.UniqueIdentifier
  category  String  @db.VarChar(20)
  qty       Int     @default(0)
  amount    Decimal @default(0) @db.Decimal(19, 4)
  feeAmount Decimal @default(0) @db.Decimal(19, 4)
  feeRate   Decimal? @db.Decimal(9, 6)

  batch SettlementBatch @relation(fields: [batchId], references: [batchId], onDelete: NoAction, onUpdate: NoAction)

  @@id([batchId, category])
}

model SettlementBatchBrandTotal {
  batchId   String  @db.UniqueIdentifier
  cardBrand String  @db.VarChar(20)
  qty       Int     @default(0)
  amount    Decimal @default(0) @db.Decimal(19, 4)

  batch SettlementBatch @relation(fields: [batchId], references: [batchId], onDelete: NoAction, onUpdate: NoAction)

  @@id([batchId, cardBrand])
}

/// One movement processed in a cycle within a batch attempt.
model SettlementTransaction {
  settlementTxnId          BigInt    @id @default(autoincrement())
  batchId                  String    @db.UniqueIdentifier
  transactionId            BigInt
  cycle                    String    @db.Char(1)
  statusId                 Int
  settlementStatusId       Int
  roundNo                  Int?
  sheetId                  String?   @db.UniqueIdentifier
  rowNo                    Int?
  amount                   Decimal   @db.Decimal(19, 4)
  excludeAmount            Boolean   @default(false)
  feeAmount                Decimal   @default(0) @db.Decimal(19, 4)
  /// NULL: an adjustment the source cannot date (never an invented date)
  eventDate                DateTime? @db.DateTime2
  appliedReservePct        Decimal   @db.Decimal(9, 6)
  reserveDaysUsed          Int
  expectedReserveReleaseAt DateTime? @db.DateTime2
  reservePolicySnapshot    String?   @db.NVarChar(Max)
  reserveEarlyReleasedAmt  Decimal   @default(0) @db.Decimal(19, 4)
  reserveHeldAmt           Decimal   @default(0) @db.Decimal(19, 4)
  reserveReleasedAmt       Decimal   @default(0) @db.Decimal(19, 4)
  createdAt                DateTime  @default(now()) @db.DateTime2

  batch            SettlementBatch            @relation(fields: [batchId], references: [batchId], onDelete: NoAction, onUpdate: NoAction)
  transaction      Transaction                @relation(fields: [transactionId], references: [transactionId], onDelete: NoAction, onUpdate: NoAction)
  cycleRef         Cycle                      @relation(fields: [cycle], references: [cycle], onDelete: NoAction, onUpdate: NoAction)
  status           TransactionStatus          @relation(fields: [statusId], references: [statusId], onDelete: NoAction, onUpdate: NoAction)
  settlementStatus SettlementStatus           @relation(fields: [settlementStatusId], references: [settlementStatusId], onDelete: NoAction, onUpdate: NoAction)
  sheet            ImportSheet?               @relation(fields: [sheetId], references: [sheetId], onDelete: NoAction, onUpdate: NoAction)
  appliedFees      SettlementTransactionFee[]

  @@index([batchId, cycle])
  @@index([transactionId, cycle])
  // one movement per source row: filtered unique index (batchId, sheetId, rowNo) WHERE sheetId IS NOT NULL and
  // CHECK sheetId/rowNo together → migration 0007
}

model SettlementTransactionFee {
  appliedFeeId          BigInt   @id @default(autoincrement())
  settlementTxnId       BigInt
  feeId                 String   @db.UniqueIdentifier
  feeTypeId             Int
  eventDate             DateTime @db.DateTime2
  amountUsd             Decimal  @db.Decimal(19, 4)
  configurationSnapshot String   @db.NVarChar(Max)

  settlementTxn SettlementTransaction @relation(fields: [settlementTxnId], references: [settlementTxnId], onDelete: NoAction, onUpdate: NoAction)
  fee           Fee                   @relation(fields: [feeId], references: [feeId], onDelete: NoAction, onUpdate: NoAction)
  feeType       FeeType               @relation(fields: [feeTypeId], references: [feeTypeId], onDelete: NoAction, onUpdate: NoAction)

  @@index([settlementTxnId])
}

// ───────────────────────── Access and audit ─────────────────────────

model Role {
  roleId Int    @id @default(autoincrement())
  name   String @unique @db.VarChar(30)

  users       User[]
  permissions RolePermission[]
}

model RolePermission {
  roleId         Int
  permissionCode String @db.VarChar(40)

  role Role @relation(fields: [roleId], references: [roleId], onDelete: NoAction, onUpdate: NoAction)

  @@id([roleId, permissionCode])
}

model User {
  userId        Int      @id @default(autoincrement())
  userName      String   @unique @db.VarChar(50)
  email         String   @unique @db.VarChar(120)
  displayName   String   @db.NVarChar(100)
  passwordHash  String   @db.VarChar(255)
  roleId        Int
  /// assigned | all
  merchantScope String   @default("assigned") @db.VarChar(10)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.DateTime2
  updatedAt     DateTime @updatedAt @db.DateTime2

  role              Role                 @relation(fields: [roleId], references: [roleId], onDelete: NoAction, onUpdate: NoAction)
  merchants         UserMerchant[]
  accountsCreated   Account[]            @relation("AccountCreatedBy")
  channelsAssigned  AccountChannel[]
  feesCreated       Fee[]
  feeHistory        FeeHistory[]
  imports           Import[]
  runs              ValidationRun[]
  issuesResolved    ValidationIssue[]
  occurrenceChanges ConflictOccurrence[]
  batchesApproved   SettlementBatch[]    @relation("BatchApprovedBy")
  batchesPaid       SettlementBatch[]    @relation("BatchPaidBy")
  batchesUndone     SettlementBatch[]    @relation("BatchUndoneBy")
  batchFees         SettlementBatchFee[]
  auditEntries      AuditLog[]
  refreshTokens     RefreshToken[]
}

model UserMerchant {
  userId     Int
  merchantId Int

  user     User     @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  merchant Merchant @relation(fields: [merchantId], references: [merchantId], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, merchantId])
}

model AuditLog {
  auditId    BigInt   @id @default(autoincrement())
  /// NULL when the actor is unknown (e.g. login attempt with a nonexistent userName)
  userId     Int?
  action     String   @db.VarChar(60)
  entityType String   @db.VarChar(40)
  entityId   String   @db.VarChar(64)
  detailJson String?  @db.NVarChar(Max)
  createdAt  DateTime @default(now()) @db.DateTime2

  user User? @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
}

/// Issued refresh tokens, by jti. Only the id is stored, never the token itself.
model RefreshToken {
  /// = jti claim of the refresh JWT
  tokenId   String    @id @db.UniqueIdentifier
  userId    Int
  expiresAt DateTime  @db.DateTime2
  revokedAt DateTime? @db.DateTime2
  createdAt DateTime  @default(now()) @db.DateTime2

  user User @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, revokedAt])
}
