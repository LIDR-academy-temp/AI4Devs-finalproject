# ─── Base de datos ──────────────────────────────────────────────────────────
# PostgreSQL 16 levantado con `docker compose up -d db`
DATABASE_URL="postgresql://concilia:concilia@localhost:5432/concilia?schema=public"
# Base de datos usada por los tests de integración (la crea docker/postgres-init)
DATABASE_URL_TEST="postgresql://concilia:concilia@localhost:5432/concilia_test?schema=public"

# ─── API ────────────────────────────────────────────────────────────────────
PORT=3000
# Secreto para firmar los JWT (mínimo 16 caracteres; usa uno aleatorio en producción)
JWT_SECRET="cambia-este-secreto-por-uno-aleatorio"
# Horas de validez del token de acceso
JWT_EXPIRES_IN="8h"
# Origen permitido para CORS (URL del frontend)
# Límite de intentos de login por IP y ventana (ms)
LOGIN_RATE_LIMIT=5
LOGIN_RATE_TTL_MS=60000
CORS_ORIGIN="http://localhost:5173"

# ─── IA (opcional; sin clave las funciones de IA quedan deshabilitadas) ─────
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5-5"

# ─── Frontend (Vite solo expone variables con prefijo VITE_) ────────────────
VITE_API_URL="http://localhost:3000"
