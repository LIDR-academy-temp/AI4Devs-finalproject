# Copy to .env and change the passwords. .env is not committed.
# SQL Server requirements: at least 8 characters with uppercase, lowercase, digit and symbol.

# SQL Server (container)
MSSQL_SA_PASSWORD=ChangeMe_Sa_2026!
MSSQL_PORT=1433
DB_NAME=ReconTool
RECON_APP_PASSWORD=ChangeMe_App_2026!

# Backend (Prisma CLI and seed build the connection from these; the password is RECON_APP_PASSWORD above)
DB_HOST=localhost
DB_PORT=1433
DB_USER=recon_app

# Seed: password for the demo users (admin, analyst, payments, viewer)
SEED_PASSWORD=Recon2026!

# API
PORT=3000
# JWT signing secret, at least 32 characters. Example value only: never use it outside local development.
JWT_SECRET=change-me-32-chars-minimum-please-really
# CORS_ORIGIN=http://localhost:5173

# Directory where uploaded import files are stored.
# Optional: defaults to data/uploads relative to the backend working directory.
# UPLOAD_DIR=data/uploads
