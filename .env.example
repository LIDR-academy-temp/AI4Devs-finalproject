# AdOps360 — environment variables.
# Copy to .env and fill in real values. Never commit .env.
# On the EC2 instance .env must carry restricted file permissions (chmod 600):
# it holds the DSP API credentials.

# ---------------------------------------------------------------------------
# PostgreSQL (db service)
# ---------------------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ---------------------------------------------------------------------------
# AWS Cognito (User Pool)
# Managed AWS service, not part of the Compose stack.
# The backend uses these to verify tokens; the frontend to start a session.
# ---------------------------------------------------------------------------
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=

# ---------------------------------------------------------------------------
# AWS — S3 file storage
# Uploaded purchase-order and commercial-offer spreadsheets,
# and reports downloaded from the DSPs.
# ---------------------------------------------------------------------------
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ---------------------------------------------------------------------------
# DSP API credentials
# ---------------------------------------------------------------------------
ADFORM_CLIENT_ID=
ADFORM_CLIENT_SECRET=

EQUATIV_CLIENT_ID=
EQUATIV_CLIENT_SECRET=

DISPLAYCE_CLIENT_ID=
DISPLAYCE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Frontend
# Public base URL the browser uses to reach the API, through nginx.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=
