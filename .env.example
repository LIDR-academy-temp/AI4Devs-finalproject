# Copiar a .env y completar. Solo valores de prueba: nunca credenciales reales.

# PostgreSQL (docker-compose)
POSTGRES_USER=firmadoc
POSTGRES_PASSWORD=firmadoc
POSTGRES_DB=firmadoc
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://firmadoc:firmadoc@localhost:5432/firmadoc
TEST_DATABASE_URL=postgresql+psycopg://firmadoc:firmadoc@localhost:5432/firmadoc_test
# URL pública del widget: la signing_url se arma como {FIRMADOC_PUBLIC_BASE_URL}/sign/{id}#t=...
FIRMADOC_PUBLIC_BASE_URL=http://localhost:5173
# Orígenes de navegador que pueden llamar a la API (panel y widget), separados por comas
FIRMADOC_CORS_ORIGINS=http://localhost:4200,http://localhost:5173
FIRMADOC_ADMIN_TOKEN=
FIRMADOC_SIGNING_LINK_SECRET=
FIRMADOC_REQUIRE_CUIL_MATCH=false
FIRMADOC_MAX_UPLOAD_MB=10

# Proveedor local (firma electrónica de demostración)
FIRMADOC_LOCAL_KEYSTORE_PATH=var/keys/local-signer.p12
FIRMADOC_LOCAL_KEYSTORE_PASSPHRASE=

# Seed: si se define, el sistema integrador demo usa esta API key; si no, se genera y se muestra una sola vez.
FIRMADOC_DEMO_API_KEY=
