# Copia este archivo a .env y completa los valores. NUNCA subas .env ni credenciales reales.

# PostgreSQL (docker-compose local por defecto)
DATABASE_URL="postgresql://agendaya:agendaya@localhost:5432/agendaya?schema=public"

# NextAuth / Auth.js v5 (sesión del negocio) — AUTH_SECRET es el nombre que
# lee Auth.js v5; se mantiene NEXTAUTH_URL por compatibilidad con tooling que
# todavía lo busca.
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp (Twilio WhatsApp Sandbox) — SOLO credenciales de prueba, nunca de producción
WHATSAPP_API_SID=""
WHATSAPP_API_TOKEN=""
WHATSAPP_FROM_NUMBER="whatsapp:+14155238886"
