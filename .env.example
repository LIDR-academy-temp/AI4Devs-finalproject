# Copia este archivo como .env y completa los valores. No versiones el .env.

# Modo de los datos: simulado (por defecto), real o prueba. Ver docs/despliegue/instalacion-local.md, sección 5.
# La base recuerda el modo con que se llenó y no arranca con otro, para no mezclar datos reales y ficticios.
SAT2_MODO=simulado

# Credenciales y dirección base de la API de TECMES, solo para el modo real
nombreDeUsuario=
clave=
SAT2_URL_BASE=

# Contraseña de PostgreSQL. Obligatoria en el servidor: openssl rand -hex 32
POSTGRES_PASSWORD=

# Exige HTTPS para la cookie de sesión. En el servidor siempre queda activada.
COOKIE_SEGURA=false

# Puerto local de la aplicación, si el 8080 está ocupado
# PUERTO_WEB=8090

# Correos de las cuentas. En local los atrapa Mailpit, en http://localhost:8025, y no salen a internet.
# Puerto de Mailpit, si el 8025 está ocupado
# PUERTO_CORREO=8035

# Solo en el servidor (ver docs/despliegue/despliegue-gcp.md)
# DIRECCION_WEB=weathertrack.ejemplo.com
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# Proveedor de correo, obligatorio en el servidor. Siempre se usa STARTTLS.
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PUERTO=587
# SMTP_USUARIO=
# SMTP_CLAVE=
# CORREO_REMITENTE=Weather Track <no-responder@weathertrack.ejemplo.com>
