# Copia este archivo como .env y completa los valores. No versiones el .env.

# Modo de la ingesta: simulado o real. Las pruebas E2E usan su propio modo, escenarios.
SAT2_MODO=simulado

# Credenciales y dirección base de la API de TECMES, solo para el modo real
nombreDeUsuario=
clave=
SAT2_URL_BASE=

# Contraseña de PostgreSQL. Obligatoria en el servidor: openssl rand -hex 32
POSTGRES_PASSWORD=

# Exige HTTPS para la cookie de sesión. En el servidor siempre queda activada.
COOKIE_SEGURA=false

# Puerto local de la aplicación, si el 8080 está ocupado
# PUERTO_WEB=8090

# Solo en el servidor (ver docs/despliegue/despliegue-gcp.md)
# DIRECCION_WEB=weathertrack.ejemplo.com
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
