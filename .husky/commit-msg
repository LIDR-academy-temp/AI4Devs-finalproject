# Conventional Commits: type(optional scope): description
msg=$(head -1 "$1")
echo "$msg" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9/_-]+\))?!?: .{1,100}$' || {
  echo "Commit rejected. Format: type(scope): description  — e.g. feat(import): leer varias hojas"
  exit 1
}
