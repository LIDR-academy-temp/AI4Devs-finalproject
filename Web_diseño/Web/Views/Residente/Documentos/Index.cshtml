@model Web.Models.Residente.ResidentDocumentListPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Documentos";
    var context = Model.Context;
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Category);
}

<div class="container-fluid cq-resident-page">
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="mdi mdi-alert-circle mr-1"></i>@Model.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card cq-resident-hero mb-4">
        <div class="card-body">
            <div class="cq-resident-hero-grid">
                <div>
                    <span class="badge badge-pill badge-light text-uppercase">Documentos</span>
                    <h3 class="mt-3 mb-2">Biblioteca de tu vivienda</h3>
                    <p class="mb-0">Busca, filtra y abre archivos sin ruido extra.</p>

                    <div class="cq-resident-hero-pills mt-3">
                        <span class="cq-ticket-hero-pill"><i class="mdi mdi-home-city-outline"></i>@context.SelectedPropertyDisplay</span>
                        <span class="cq-ticket-hero-pill"><i class="mdi mdi-file-document-outline"></i>@Model.Items.Count documento(s)</span>
                        @if (hasFilters)
                        {
                            <span class="cq-ticket-hero-pill"><i class="mdi mdi-filter-variant"></i>Filtros activos</span>
                        }
                    </div>
                </div>
                <div class="cq-resident-focus-card">
                    <span class="cq-resident-mini-label">Biblioteca</span>
                    <strong>@Model.Items.Count archivo(s) visible(s)</strong>
                    <div class="cq-resident-metric-strip">
                        <span class="cq-resident-metric-pill"><i class="mdi mdi-tag-multiple-outline"></i>@Model.Categories.Count categoría(s)</span>
                    </div>
                </div>
            </div>

            <form method="get" action="/Residente/Documentos" class="cq-resident-toolbar cq-resident-toolbar--compact mt-4">
                <div class="cq-resident-search">
                    <i class="mdi mdi-magnify"></i>
                    <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Buscar por nombre, tipo o ruta" />
                </div>
                <select name="category" class="form-control cq-resident-filter-select">
                    <option value="">Todas las categorías</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category" selected="@(string.Equals(Model.Category, category, StringComparison.OrdinalIgnoreCase))">@category</option>
                    }
                </select>
                <button type="submit" class="btn btn-primary">Filtrar</button>
                @if (hasFilters)
                {
                    <a href="/Residente/Documentos" class="btn btn-outline-secondary">Limpiar</a>
                }
            </form>
        </div>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="card">
            <div class="card-body cq-reserva-empty cq-reserva-empty--table py-5">
                <div class="cq-reserva-empty-icon"><i class="mdi mdi-file-hidden"></i></div>
                <h5 class="mb-2">Sin documentos disponibles</h5>
                <p class="text-muted mb-0">No encontramos documentos públicos con los filtros actuales para tu portal residente.</p>
            </div>
        </div>
    }
    else
    {
        <div class="cq-resident-doc-grid">
            @foreach (var item in Model.Items)
            {
                <article class="cq-resident-doc-card">
                    <div class="d-flex align-items-start justify-content-between gap-2 mb-3">
                        <span class="badge badge-light border">@(string.IsNullOrWhiteSpace(item.TipoArchivo) ? "Documento" : item.TipoArchivo)</span>
                        <span class="badge badge-success">Público</span>
                    </div>

                    <h5 class="mb-2">@item.Nombre</h5>
                    <p class="cq-resident-card-caption">@(string.IsNullOrWhiteSpace(item.Ruta) ? "Sin archivo público vinculado." : "Disponible para abrir o descargar.")</p>
                    @if (!string.IsNullOrWhiteSpace(item.Ruta))
                    {
                        <small class="text-muted d-block text-truncate" title="@item.Ruta">@item.Ruta</small>
                    }

                    <div class="cq-resident-doc-actions">
                        <a href="/Residente/Documentos/@item.ArchivoID" class="btn btn-primary btn-sm">Ver detalle</a>
                        @if (!string.IsNullOrWhiteSpace(item.Ruta))
                        {
                            <a href="@item.Ruta" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm">Abrir archivo</a>
                        }
                    </div>
                </article>
            }
        </div>
    }
</div>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-file-document-multiple-outline"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Documentos</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge"><i class="mdi mdi-map-marker-radius-outline"></i>@context.SelectedPropertyDisplay</span>
                    <span class="cq-tb-badge">@Model.Items.Count documento(s)</span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item"><a href="/Residente/Inicio">Portal residente</a></li>
                <li class="breadcrumb-item active">Documentos</li>
            </ol>
        </div>
    </div>
}