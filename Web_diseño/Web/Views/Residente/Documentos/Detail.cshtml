@model Web.Models.Residente.ResidentDocumentDetailViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Document.Nombre;
    var context = Model.Context;
    var tipoArchivo = string.IsNullOrWhiteSpace(Model.Document.TipoArchivo) ? "Documento" : Model.Document.TipoArchivo;
    var relatedCount = Model.RelatedDocuments.Count;
}

<div class="container-fluid cq-resident-page">
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="mdi mdi-alert-circle mr-1"></i>@Model.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card cq-resident-hero mb-4">
        <div class="card-body">
            <div class="cq-resident-hero-grid">
                <div>
                    <span class="badge badge-pill badge-light text-uppercase">@tipoArchivo</span>
                    <h3 class="mt-3 mb-2">@Model.Document.Nombre</h3>
                    <p class="mb-0">Disponible para la vivienda activa <strong>@context.SelectedPropertyDisplay</strong>.</p>

                    <div class="cq-resident-hero-pills mt-3">
                        <span class="cq-ticket-hero-pill"><i class="mdi mdi-home-city-outline"></i>@context.SelectedPropertyDisplay</span>
                        <span class="cq-ticket-hero-pill"><i class="mdi mdi-shield-check-outline"></i>Público</span>
                        @if (!string.IsNullOrWhiteSpace(Model.Document.Ruta))
                        {
                            <span class="cq-ticket-hero-pill"><i class="mdi mdi-link-variant"></i>Archivo vinculado</span>
                        }
                    </div>
                </div>
                <div class="cq-resident-focus-card">
                    <span class="cq-resident-mini-label">Acciones</span>
                    <strong>@(string.IsNullOrWhiteSpace(Model.Document.Ruta) ? "Sin archivo público" : "Listo para abrir")</strong>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <a href="/Residente/Documentos" class="btn btn-light btn-sm">Volver</a>
                        @if (!string.IsNullOrWhiteSpace(Model.Document.Ruta))
                        {
                            <a href="@Model.Document.Ruta" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">Abrir archivo</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-xl-8">
            <div class="card cq-resident-detail-card">
                <div class="card-body">
                    <div class="cq-resident-info-list">
                        <div class="cq-resident-info-item">
                            <i class="mdi mdi-file-link-outline"></i>
                            <div>
                                <strong>Ruta registrada</strong>
                                <span>@(string.IsNullOrWhiteSpace(Model.Document.Ruta) ? "No hay una ruta pública configurada." : Model.Document.Ruta)</span>
                            </div>
                        </div>
                        <div class="cq-resident-info-item">
                            <i class="mdi mdi-shield-check-outline"></i>
                            <div>
                                <strong>Visibilidad</strong>
                                <span>Este archivo está visible en la biblioteca pública del portal residente.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4 mt-3 mt-xl-0">
            <div class="card h-100">
                <div class="card-body">
                    <h4 class="card-title mb-3">Otros documentos</h4>
                    @if (!Model.RelatedDocuments.Any())
                    {
                        <div class="cq-reserva-empty py-4">
                            <div class="cq-reserva-empty-icon"><i class="mdi mdi-file-multiple-outline"></i></div>
                            <p class="text-muted mb-0">No hay más documentos públicos relacionados por ahora.</p>
                        </div>
                    }
                    else
                    {
                        <div class="cq-resident-info-list">
                            @foreach (var item in Model.RelatedDocuments)
                            {
                                <a href="/Residente/Documentos/@item.ArchivoID" class="cq-resident-message-card">
                                    <strong>@item.Nombre</strong>
                                    <span>@(string.IsNullOrWhiteSpace(item.TipoArchivo) ? "Documento" : item.TipoArchivo)</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-file-document-outline"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Detalle de documento</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge"><i class="mdi mdi-map-marker-radius-outline"></i>@context.SelectedPropertyDisplay</span>
                    <span class="cq-tb-badge">@relatedCount relacionado(s)</span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item"><a href="/Residente/Inicio">Portal residente</a></li>
                <li class="breadcrumb-item"><a href="/Residente/Documentos">Documentos</a></li>
                <li class="breadcrumb-item active">Detalle</li>
            </ol>
        </div>
    </div>
}
