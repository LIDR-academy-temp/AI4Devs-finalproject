@model Web.Models.Residente.ResidentAccountPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Mi cuenta";
    var context = Model.Context;
}

<div class="container-fluid cq-resident-page">
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="mdi mdi-alert-circle mr-1"></i>@Model.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card cq-resident-hero mb-4">
        <div class="card-body">
            <div class="cq-resident-hero-grid">
                <div>
                    <span class="badge badge-pill badge-light text-uppercase">Mi cuenta</span>
                    <h3 class="mt-3 mb-2">Tu estado de cuenta, sin vueltas</h3>
                    <p class="mb-0">Saldo, próximos pagos y movimientos visibles de tu vivienda activa.</p>

                    <div class="cq-ticket-hero-pills mt-3">
                        <span class="cq-ticket-hero-pill"><i class="mdi mdi-home-city-outline"></i>@context.SelectedPropertyDisplay</span>
                        <span class="cq-ticket-hero-pill"><i class="mdi mdi-cash-clock"></i>@Model.CuotasPendientes pendiente(s)</span>
                        @if (Model.CuotasVencidas > 0)
                        {
                            <span class="cq-ticket-hero-pill"><i class="mdi mdi-alert-circle-outline"></i>@Model.CuotasVencidas vencida(s)</span>
                        }
                    </div>
                </div>
                <div class="cq-resident-focus-card">
                    <span class="cq-resident-mini-label">Saldo pendiente</span>
                    <strong>@Model.SaldoPendiente.ToString("C")</strong>
                    <div class="cq-resident-metric-strip">
                        <span class="cq-resident-metric-pill"><i class="mdi mdi-alert-circle-outline"></i>@Model.CuotasPendientes pendiente(s)</span>
                        <span class="cq-resident-metric-pill"><i class="mdi mdi-check-circle-outline"></i>@Model.CuotasPagadas pagada(s)</span>
                    </div>
                    <p class="mb-0">
                        @(Model.ProximoVencimiento.HasValue
                            ? $"Próximo vencimiento: {Model.ProximoVencimiento.Value:dd/MM/yyyy} por {Model.ProximoMonto?.ToString("C") ?? "$0.00"}."
                            : "No hay cuotas pendientes por vencer en este momento.")
                    </p>
                    <a href="/Residente/Tickets?newTicket=true&focus=detail&tab=created" class="btn btn-light btn-sm">Solicitar aclaración</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12 col-md-6 col-xl-3 mb-3 mb-xl-0">
            <div class="card h-100"><div class="card-body"><span class="text-muted d-block">Saldo pendiente</span><h3 class="mb-1">@Model.SaldoPendiente.ToString("C")</h3><small class="text-muted">Abierto hoy</small></div></div>
        </div>
        <div class="col-12 col-md-6 col-xl-3 mb-3 mb-xl-0">
            <div class="card h-100"><div class="card-body"><span class="text-muted d-block">Pendientes</span><h3 class="mb-1">@Model.CuotasPendientes</h3><small class="text-muted">@(Model.CuotasVencidas > 0 ? $"{Model.CuotasVencidas} vencida(s)" : "Sin vencidas")</small></div></div>
        </div>
        <div class="col-12 col-md-6 col-xl-3 mb-3 mb-xl-0">
            <div class="card h-100"><div class="card-body"><span class="text-muted d-block">Pagadas</span><h3 class="mb-1">@Model.CuotasPagadas</h3><small class="text-muted">Movimientos liquidados</small></div></div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card h-100"><div class="card-body"><span class="text-muted d-block">Total pagado</span><h3 class="mb-1">@Model.TotalPagado.ToString("C")</h3><small class="text-muted">Visible en tu historial</small></div></div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="cq-resident-section-head">
                <div>
                    <span class="cq-resident-kicker">Movimientos</span>
                    <h4 class="card-title mb-1">Historial visible</h4>
                    <p class="text-muted mb-0">Filtra si solo quieres ver lo pendiente.</p>
                </div>

                <form method="get" action="/Residente/Cuenta" class="cq-resident-toolbar">
                    <div class="cq-ticket-checkchip">
                        <input class="form-check-input mt-0" type="checkbox" name="soloPendientes" value="true" id="chkPendientesCuenta" @(Model.SoloPendientes ? "checked" : "") onchange="this.form.submit()" />
                        <label class="form-check-label mb-0" for="chkPendientesCuenta">Solo pendientes</label>
                    </div>
                    @if (Model.SoloPendientes)
                    {
                        <a href="/Residente/Cuenta" class="btn btn-outline-secondary">Ver todas</a>
                    }
                </form>
            </div>
        </div>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="card"><div class="card-body cq-empty-state"><i class="mdi mdi-cash-remove cq-empty-icon"></i><div class="cq-empty-title">Sin movimientos visibles</div><p class="text-muted mb-0">No encontramos cuotas para la vivienda activa con el filtro actual.</p></div></div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model.Items)
            {
                var periodoTexto = item.PeriodoInicio != default && item.PeriodoFin != default
                    ? $"{item.PeriodoInicio:dd/MM/yyyy} - {item.PeriodoFin:dd/MM/yyyy}"
                    : "Periodo no definido";
                var pagoTexto = item.Pagado
                    ? (item.FechaPago.HasValue ? $"Pago registrado el {item.FechaPago.Value:dd/MM/yyyy}" : "Pago registrado")
                    : (item.FechaVencimiento != default ? $"Vence el {item.FechaVencimiento:dd/MM/yyyy}" : "Sin fecha de vencimiento registrada");

                <div class="col-12 col-xl-6 mb-4">
                    <article class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex flex-column flex-lg-row align-items-lg-start justify-content-between gap-3 mb-3">
                                <div>
                                    <div class="d-flex flex-wrap gap-2 mb-2">
                                        <span class="@item.EstadoCuotaClase">@item.EstadoCuota</span>
                                        @if (!string.IsNullOrWhiteSpace(item.NombreCondominio))
                                        {
                                            <span class="badge badge-light border">@item.NombreCondominio</span>
                                        }
                                    </div>
                                    <h5 class="mb-1">@item.Monto.ToString("C")</h5>
                                    <p class="text-muted mb-0">@periodoTexto</p>
                                </div>
                                <div class="text-lg-right">
                                    <small class="text-muted d-block">Vivienda</small>
                                    <strong>@(string.IsNullOrWhiteSpace(item.DireccionCasa) ? context.SelectedCasaLabel : item.DireccionCasa)</strong>
                                </div>
                            </div>

                            <div class="cq-resident-detail-grid mb-3">
                                <div class="cq-resident-detail">
                                    <span>Estado</span>
                                    <strong>@pagoTexto</strong>
                                </div>

                                <div class="cq-resident-detail">
                                    <span>Referencia</span>
                                    <strong>@(string.IsNullOrWhiteSpace(item.ReferenciaPago) ? "Sin referencia registrada" : item.ReferenciaPago)</strong>
                                </div>

                                <div class="cq-resident-detail">
                                    <span>Método</span>
                                    <strong>@(string.IsNullOrWhiteSpace(item.MetodoPago) ? "Sin método capturado" : item.MetodoPago)</strong>
                                </div>
                            </div>

                            @if (!item.Pagado)
                            {
                                <div class="mt-auto d-flex flex-wrap gap-2">
                                    <a href="/Residente/Tickets?newTicket=true&focus=detail&tab=created" class="btn btn-outline-primary btn-sm">Solicitar revisión</a>
                                </div>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-cash-clock"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Mi cuenta</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge"><i class="mdi mdi-map-marker-radius-outline"></i>@context.SelectedPropertyDisplay</span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item"><a href="/Residente/Inicio">Portal residente</a></li>
                <li class="breadcrumb-item active">Mi cuenta</li>
            </ol>
        </div>
    </div>
}