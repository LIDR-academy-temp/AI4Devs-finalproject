@model Web.Models.Residente.ResidentPassPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Pases QR";
    var context = Model.Context;
}

<div class="container-fluid cq-resident-page">
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="mdi mdi-alert-circle mr-1"></i>@Model.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card cq-reserva-hero mb-4">
        <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="flex-grow-1">
                <span class="badge badge-pill cq-reserva-pill">Pases QR</span>
                <h3 class="mb-2 mt-2">Accesos temporales en minutos</h3>
                <p class="mb-0">Genera y comparte pases ligados a <strong>@context.SelectedPropertyDisplay</strong> sin pasos extra.</p>
            </div>
            <div class="d-flex flex-wrap gap-2 cq-reserva-stat-strip">
                <div class="cq-reserva-stat"><span>Vigentes</span><strong>@Model.TotalVigentes</strong></div>
                <div class="cq-reserva-stat"><span>Usados</span><strong>@Model.TotalUsados</strong></div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-5 mb-4 mb-lg-0">
            <div class="card cq-reserva-form-panel h-100">
                <div class="card-body">
                    <div class="cq-resident-section-head mb-3">
                        <div>
                            <span class="cq-resident-kicker">Nuevo pase</span>
                            <h4 class="card-title mb-1">Captura rápida</h4>
                            <p class="text-muted mb-0">Se emite con tu sesión y la vivienda activa.</p>
                        </div>
                        <span class="badge badge-pill @(Model.PuedeGuardar ? "badge-success" : "badge-warning")">
                            @(Model.PuedeGuardar ? "Listo para compartir" : "Catálogo pendiente")
                        </span>
                    </div>

                    <form action="/Residente/Pases/Guardar" method="post" class="cq-reserva-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="soloVigentes" value="@Model.SoloVigentes.ToString().ToLowerInvariant()" />
                        <input asp-for="Form.VisitaGeneradaID" type="hidden" />
                        <input asp-for="Form.UsuarioVisitadoID" type="hidden" />
                        <input asp-for="Form.CasaID" type="hidden" />
                        <input asp-for="Form.CodigoQR" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group">
                            <label asp-for="Form.NombreVisitante"></label>
                            <input asp-for="Form.NombreVisitante" class="form-control" placeholder="Nombre completo del visitante" />
                            <span asp-validation-for="Form.NombreVisitante" class="text-danger"></span>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label asp-for="Form.TipoIdentificacionID"></label>
                                <select asp-for="Form.TipoIdentificacionID" asp-items="Model.TipoIdentificacionOptions" class="form-control cq-reserva-select">
                                    <option value="">Selecciona un tipo</option>
                                </select>
                                <span asp-validation-for="Form.TipoIdentificacionID" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Form.NumeroIdentificacion"></label>
                                <input asp-for="Form.NumeroIdentificacion" class="form-control" placeholder="Folio o número" />
                                <span asp-validation-for="Form.NumeroIdentificacion" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label asp-for="Form.FechaEmision"></label>
                                <input asp-for="Form.FechaEmision" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                                <span asp-validation-for="Form.FechaEmision" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Form.DuracionMinutos"></label>
                                <select asp-for="Form.DuracionMinutos" class="form-control cq-reserva-select">
                                    <option value="60">1 hora</option>
                                    <option value="120">2 horas</option>
                                    <option value="240">4 horas</option>
                                    <option value="480">8 horas</option>
                                    <option value="1440">24 horas</option>
                                </select>
                                <span asp-validation-for="Form.DuracionMinutos" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label asp-for="Form.FechaExpira"></label>
                            <input asp-for="Form.FechaExpira" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                            <span asp-validation-for="Form.FechaExpira" class="text-danger"></span>
                        </div>

                        <div class="cq-reserva-form-note">
                            <i class="mdi mdi-qrcode"></i>
                            El enlace de validación se genera automáticamente y puede compartirse por WhatsApp.
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <button type="submit" class="btn btn-info" @(Model.PuedeGuardar ? null : "disabled")>Generar pase</button>
                            <a href="/Residente/Pases" class="btn btn-outline-secondary">Limpiar</a>
                        </div>
                    </form>

                    @if (!string.IsNullOrWhiteSpace(Model.Form.QrImageDataUrl))
                    {
                        <div class="cq-pass-preview mt-4">
                            <div class="d-flex align-items-center justify-content-between mb-3 gap-2">
                                <div>
                                    <h5 class="mb-1">Pase listo</h5>
                                    <small class="text-muted">@Model.Form.NombreVisitante</small>
                                </div>
                                <span class="badge @Model.Form.EstadoClase">@Model.Form.EstadoTexto</span>
                            </div>
                            <img src="@Model.Form.QrImageDataUrl" alt="QR del pase" class="img-fluid mb-3" style="max-width: 220px;" />
                            <div class="d-flex flex-wrap gap-2">
                                @if (!string.IsNullOrWhiteSpace(Model.Form.ValidationUrl))
                                {
                                    <a href="@Model.Form.ValidationUrl" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm">Abrir</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Form.WhatsAppUrl))
                                {
                                    <a href="@Model.Form.WhatsAppUrl" target="_blank" rel="noopener" class="btn btn-success btn-sm">WhatsApp</a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card cq-reserva-preview-panel h-100">
                <div class="card-body">
                    <div class="cq-resident-section-head mb-3">
                        <div>
                            <span class="cq-resident-kicker">Historial</span>
                            <h4 class="card-title mb-1">Pases visibles</h4>
                            <p class="text-muted mb-0">Solo se muestran QR de tu vivienda actual.</p>
                        </div>
                        <form method="get" action="/Residente/Pases" class="d-flex align-items-center gap-2">
                            <label class="cq-tb-toggle @(Model.SoloVigentes ? "active" : string.Empty)">
                                <input type="checkbox" name="soloVigentes" value="true" @(Model.SoloVigentes ? "checked" : string.Empty) onchange="this.form.submit()" />
                                <i class="mdi mdi-timer-sand"></i> Solo vigentes
                            </label>
                        </form>
                    </div>

                    @if (!Model.Items.Any())
                    {
                        <div class="cq-reserva-empty mt-3">
                            <div class="cq-reserva-empty-icon"><i class="mdi mdi-qrcode-scan"></i></div>
                            <h5 class="mb-2">Sin pases visibles</h5>
                            <p class="text-muted mb-0">No hay pases para el filtro actual.</p>
                        </div>
                    }
                    else
                    {
                        <div class="cq-resident-actions-grid">
                            @foreach (var item in Model.Items)
                            {
                                <article class="cq-resident-action-card">
                                    <span class="cq-resident-action-icon"><i class="mdi mdi-qrcode"></i></span>
                                    <strong>@item.NombreVisitante</strong>
                                    <p>
                                        @(string.IsNullOrWhiteSpace(item.TipoIdentificacion) ? "Identificación" : item.TipoIdentificacion): @item.NumeroIdentificacion
                                        <br />
                                        @(item.FechaExpira.HasValue ? $"Vence {item.FechaExpira:dd/MM/yyyy HH:mm}" : "Sin expiración")
                                    </p>
                                    <span class="badge @item.EstadoClase mb-2">@item.EstadoTexto</span>
                                    <div class="d-flex flex-wrap gap-2 mt-auto">
                                        @if (!string.IsNullOrWhiteSpace(item.ValidationUrl))
                                        {
                                            <a href="@item.ValidationUrl" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm">Abrir</a>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.WhatsAppUrl))
                                        {
                                            <a href="@item.WhatsAppUrl" target="_blank" rel="noopener" class="btn btn-success btn-sm">WhatsApp</a>
                                        }
                                        @if (item.EstadoTexto == "Vigente")
                                        {
                                            <form action="/Residente/Pases/Cancelar" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="paseQrId" value="@item.VisitaGeneradaID" />
                                                <input type="hidden" name="soloVigentes" value="@Model.SoloVigentes.ToString().ToLowerInvariant()" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('¿Cancelar este pase?');">Cancelar</button>
                                            </form>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-qrcode"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Pases QR</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge"><i class="mdi mdi-map-marker-radius-outline"></i>@context.SelectedPropertyDisplay</span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item"><a href="/Residente/Inicio">Portal residente</a></li>
                <li class="breadcrumb-item active">Pases QR</li>
            </ol>
        </div>
    </div>
}