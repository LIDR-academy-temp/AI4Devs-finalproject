@model Web.Models.Residente.ResidentNotificationDetailViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Notification.Titulo;
    var context = Model.Context;
    var fechaTexto = Model.Notification.FechaCreacionNotificacion?.ToString("dddd dd 'de' MMMM yyyy") ?? "Sin fecha registrada";
}

<div class="container-fluid cq-resident-page">
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    @if (Model.MarkedAsRead)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="mdi mdi-bell-check-outline mr-1"></i>La notificación se marcó como leída para tu usuario.
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="mdi mdi-alert-circle mr-1"></i>@Model.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card cq-resident-hero mb-4">
        <div class="card-body">
            <div class="cq-resident-hero-grid">
                <div>
                    <span class="badge badge-pill badge-light text-uppercase">@(Model.IsGlobal ? "Comunitaria" : "Personal")</span>
                    <h3 class="mt-3 mb-2">@Model.Notification.Titulo</h3>
                    <p class="mb-0">@fechaTexto</p>

                    <div class="cq-resident-hero-pills mt-3">
                        <span class="cq-ticket-hero-pill"><i class="mdi mdi-home-city-outline"></i>@context.SelectedPropertyDisplay</span>
                        <span class="cq-ticket-hero-pill"><i class="mdi mdi-bell@(Model.Notification.Leido ? "-check" : "-ring")-outline"></i>@(Model.Notification.Leido ? "Leída" : "No leída")</span>
                    </div>
                </div>
                <div class="cq-resident-focus-card">
                    <span class="cq-resident-mini-label">Estado</span>
                    <strong>@(Model.Notification.Leido ? "Leída" : "Pendiente de lectura")</strong>
                    <div class="cq-resident-metric-strip">
                        <span class="cq-resident-metric-pill"><i class="mdi mdi-tag-outline"></i>@(Model.IsGlobal ? "Comunitaria" : "Personal")</span>
                    </div>
                    <a href="/Residente/Notificaciones?tab=@Model.BackTab" class="btn btn-light btn-sm mt-2">Volver al inbox</a>
                </div>
            </div>
        </div>
    </div>

    <div class="card cq-resident-detail-card">
        <div class="card-body">
            <div class="cq-resident-longform-card">
                @if (string.IsNullOrWhiteSpace(Model.Notification.Mensaje))
                {
                    <p class="text-muted mb-0">Esta notificación no incluye detalle adicional.</p>
                }
                else
                {
                    <p class="mb-0">@Model.Notification.Mensaje</p>
                }
            </div>
        </div>
    </div>
</div>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-bell-ring-outline"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Detalle de notificación</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge"><i class="mdi mdi-map-marker-radius-outline"></i>@context.SelectedPropertyDisplay</span>
                    <span class="cq-tb-badge">@(Model.Notification.Leido ? "Leída" : "No leída")</span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item"><a href="/Residente/Inicio">Portal residente</a></li>
                <li class="breadcrumb-item"><a href="/Residente/Notificaciones?tab=@Model.BackTab">Notificaciones</a></li>
                <li class="breadcrumb-item active">Detalle</li>
            </ol>
        </div>
    </div>
}
