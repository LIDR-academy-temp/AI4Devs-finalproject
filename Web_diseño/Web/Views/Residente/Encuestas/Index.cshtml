@model Web.Models.Residente.ResidentSurveyListPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Encuestas";
    var context = Model.Context;
    var respondidas = Model.Items.Count(item => item.YaRespondio);
    var activas = Model.Items.Count;
}

<div class="container-fluid cq-resident-page">
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            <i class="mdi mdi-check-circle me-1"></i>@Model.Message
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            @Model.Error
        </div>
    }

    <div class="card cq-resident-hero mb-4">
        <div class="card-body">
            <div class="cq-resident-hero-grid">
                <div>
                    <span class="badge badge-pill badge-light text-uppercase">Encuestas</span>
                    <h3 class="mt-3 mb-2">Participación rápida</h3>
                    <p class="mb-0">Responde lo pendiente y consulta las encuestas que ya completaste.</p>

                    <div class="cq-resident-hero-pills mt-3">
                        <span class="cq-ticket-hero-pill"><i class="mdi mdi-home-city-outline"></i>@context.SelectedPropertyDisplay</span>
                        <span class="cq-ticket-hero-pill"><i class="mdi mdi-poll-box-outline"></i>@Model.PendingCount pendiente(s)</span>
                        <span class="cq-ticket-hero-pill"><i class="mdi mdi-clipboard-text-outline"></i>@activas activa(s)</span>
                    </div>
                </div>
                <div class="cq-resident-focus-card">
                    <span class="cq-resident-mini-label">Vivienda activa</span>
                    <strong>@context.SelectedPropertyDisplay</strong>
                    <div class="cq-resident-metric-strip">
                        <span class="cq-resident-metric-pill"><i class="mdi mdi-poll-box-outline"></i>@Model.PendingCount pendiente(s)</span>
                        <span class="cq-resident-metric-pill"><i class="mdi mdi-check-circle-outline"></i>@respondidas respondida(s)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="mdi mdi-clipboard-text-outline cq-empty-icon"></i>
                <h5 class="mb-2">Sin encuestas activas</h5>
                <p class="text-muted mb-0">No hay encuestas disponibles en este momento.</p>
            </div>
        </div>
    }
    else
    {
        <div class="cq-resident-survey-grid">
            @foreach (var item in Model.Items)
            {
                var description = string.IsNullOrWhiteSpace(item.Encuesta.Descripcion)
                    ? null
                    : item.Encuesta.Descripcion.Length > 110
                        ? item.Encuesta.Descripcion[..110] + "..."
                        : item.Encuesta.Descripcion;

                <article class="cq-resident-survey-card">
                    <div class="d-flex justify-content-between align-items-start mb-2 gap-2">
                        <h5 class="mb-0">@item.Encuesta.Titulo</h5>
                        @if (item.YaRespondio)
                        {
                            <span class="badge badge-success">Respondida</span>
                        }
                        else
                        {
                            <span class="badge badge-primary">Pendiente</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(description))
                    {
                        <p class="cq-resident-card-caption mb-2">@description</p>
                    }

                    @if (item.Encuesta.FechaFin.HasValue)
                    {
                        <small class="text-muted d-block mb-3">
                            <i class="mdi mdi-calendar-clock"></i>
                            Cierra: @item.Encuesta.FechaFin.Value.ToString("dd/MM/yyyy")
                        </small>
                    }

                    @if (item.YaRespondio)
                    {
                        <button class="btn btn-sm btn-outline-secondary" disabled>
                            <i class="mdi mdi-check-circle"></i> Completada
                        </button>
                    }
                    else
                    {
                        <a href="/Residente/Encuestas/@item.Encuesta.EncuestaID" class="btn btn-sm btn-primary">
                            <i class="mdi mdi-pencil-box-outline"></i> Responder ahora
                        </a>
                    }
                </article>
            }
        </div>
    }
</div>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-clipboard-list"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Encuestas</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge"><i class="mdi mdi-map-marker-radius-outline"></i>@context.SelectedPropertyDisplay</span>
                    <span class="cq-tb-badge">@Model.PendingCount pendiente(s) · @activas activa(s)</span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item"><a href="/Residente/Inicio">Portal residente</a></li>
                <li class="breadcrumb-item active">Encuestas</li>
            </ol>
        </div>
    </div>
}