@model Web.Models.Residente.ResidentSurveyDetailViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Responder encuesta";
    var context = Model.Context;
    var totalPreguntas = Model.Preguntas.Count;
    var requeridas = Model.Preguntas.Count(p => p.Requerida);
}

<div class="container-fluid cq-resident-page">
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            <i class="mdi mdi-check-circle me-1"></i>@Model.Message
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            @Model.Error
        </div>
    }

    <div class="card cq-resident-hero mb-4">
        <div class="card-body">
            <div class="cq-resident-hero-grid">
                <div>
                    <span class="badge badge-pill badge-light text-uppercase">Encuesta</span>
                    <h3 class="mt-3 mb-2">@Model.Encuesta.Titulo</h3>
                    @if (!string.IsNullOrWhiteSpace(Model.Encuesta.Descripcion))
                    {
                        <p class="mb-0">@Model.Encuesta.Descripcion</p>
                    }
                    else
                    {
                        <p class="mb-0">Completa el formulario y envía tus respuestas.</p>
                    }

                    <div class="cq-resident-hero-pills mt-3">
                        <span class="cq-ticket-hero-pill"><i class="mdi mdi-home-city-outline"></i>@context.SelectedPropertyDisplay</span>
                        <span class="cq-ticket-hero-pill"><i class="mdi mdi-format-list-numbered"></i>@totalPreguntas pregunta(s)</span>
                        @if (requeridas > 0)
                        {
                            <span class="cq-ticket-hero-pill"><i class="mdi mdi-asterisk"></i>@requeridas obligatoria(s)</span>
                        }
                    </div>
                </div>
                <div class="cq-resident-focus-card">
                    <span class="cq-resident-mini-label">Estado</span>
                    <strong>@(Model.YaRespondio ? "Ya respondida" : totalPreguntas > 0 ? "Pendiente de envío" : "Sin preguntas")</strong>
                    <div class="cq-resident-metric-strip">
                        <span class="cq-resident-metric-pill"><i class="mdi mdi-format-list-numbered"></i>@totalPreguntas pregunta(s)</span>
                        <span class="cq-resident-metric-pill"><i class="mdi mdi-asterisk"></i>@requeridas obligatoria(s)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.YaRespondio)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="mdi mdi-check-circle cq-empty-icon" style="color:var(--cq-success);"></i>
                <h5 class="mb-2">Ya respondiste esta encuesta</h5>
                <p class="text-muted mb-3">Tu respuesta ya fue registrada. Solo se permite una respuesta por usuario.</p>
                <a href="/Residente/Encuestas" class="btn btn-primary">
                    <i class="mdi mdi-arrow-left"></i> Volver a encuestas
                </a>
            </div>
        </div>
    }
    else if (!Model.Preguntas.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="mdi mdi-clipboard-alert-outline cq-empty-icon"></i>
                <h5 class="mb-2">Encuesta sin preguntas</h5>
                <p class="text-muted mb-3">Esta encuesta aún no tiene preguntas configuradas.</p>
                <a href="/Residente/Encuestas" class="btn btn-secondary">
                    <i class="mdi mdi-arrow-left"></i> Volver
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card cq-resident-detail-card">
                    <div class="card-body p-4">
                        <form action="/Residente/Encuestas/@(Model.Encuesta.EncuestaID ?? 0)" method="post" novalidate>
                            @Html.AntiForgeryToken()

                            @for (int i = 0; i < Model.Preguntas.Count; i++)
                            {
                                var pregunta = Model.Preguntas[i];
                                var opciones = Model.Opciones
                                    .Where(item => item.PreguntaID == pregunta.PreguntaID && !item.bEliminado)
                                    .OrderBy(item => item.Orden)
                                    .ToList();
                                var fieldName = $"p_{pregunta.PreguntaID}";

                                <div class="mb-4 pb-3 @(i < Model.Preguntas.Count - 1 ? "border-bottom" : string.Empty)">
                                    <label class="fw-bold d-block mb-2" style="font-size:.92rem;">
                                        <span class="badge badge-light mr-1 border">@(i + 1)</span>
                                        @pregunta.Texto
                                        @if (pregunta.Requerida)
                                        {
                                            <span class="text-danger ml-1" title="Obligatoria">*</span>
                                        }
                                    </label>

                                    @if (pregunta.TipoPreguntaID == 1)
                                    {
                                        <textarea class="form-control" name="@fieldName" rows="3" placeholder="Escribe tu respuesta..." @(pregunta.Requerida ? "required" : null)></textarea>
                                    }
                                    else if (pregunta.TipoPreguntaID == 2)
                                    {
                                        @foreach (var opcion in opciones)
                                        {
                                            <div class="custom-control custom-radio mb-1">
                                                <input type="radio" class="custom-control-input" id="opt_@opcion.OpcionPreguntaID" name="@fieldName" value="@opcion.OpcionPreguntaID" @(pregunta.Requerida ? "required" : null) />
                                                <label class="custom-control-label" for="opt_@opcion.OpcionPreguntaID">@opcion.Texto</label>
                                            </div>
                                        }
                                    }
                                    else if (pregunta.TipoPreguntaID == 3)
                                    {
                                        @foreach (var opcion in opciones)
                                        {
                                            <div class="custom-control custom-checkbox mb-1">
                                                <input type="checkbox" class="custom-control-input" id="opt_@opcion.OpcionPreguntaID" name="@fieldName" value="@opcion.OpcionPreguntaID" />
                                                <label class="custom-control-label" for="opt_@opcion.OpcionPreguntaID">@opcion.Texto</label>
                                            </div>
                                        }
                                    }
                                    else if (pregunta.TipoPreguntaID == 4)
                                    {
                                        <div class="d-flex gap-3 flex-wrap" style="gap:.75rem;">
                                            @for (int value = 1; value <= 5; value++)
                                            {
                                                <div class="custom-control custom-radio custom-control-inline">
                                                    <input type="radio" class="custom-control-input" id="scale_@(pregunta.PreguntaID)_@value" name="@fieldName" value="@value" @(pregunta.Requerida ? "required" : null) />
                                                    <label class="custom-control-label" for="scale_@(pregunta.PreguntaID)_@value">@value ⭐</label>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (pregunta.TipoPreguntaID == 5)
                                    {
                                        <input type="date" class="form-control" name="@fieldName" style="max-width:220px;" @(pregunta.Requerida ? "required" : null) />
                                    }
                                    else
                                    {
                                        <input type="text" class="form-control" name="@fieldName" @(pregunta.Requerida ? "required" : null) />
                                    }
                                </div>
                            }

                            <div class="d-flex justify-content-between mt-4 pt-2">
                                <a href="/Residente/Encuestas" class="btn btn-outline-secondary">
                                    <i class="mdi mdi-arrow-left"></i> Cancelar
                                </a>
                                <button type="submit" class="btn btn-primary px-5">
                                    <i class="mdi mdi-send"></i> Enviar respuestas
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-clipboard-edit"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">@Model.Encuesta.Titulo</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge"><i class="mdi mdi-map-marker-radius-outline"></i>@context.SelectedPropertyDisplay</span>
                    <span class="cq-tb-badge">@totalPreguntas pregunta(s) · @requeridas obligatoria(s)</span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item"><a href="/Residente/Inicio">Portal residente</a></li>
                <li class="breadcrumb-item"><a href="/Residente/Encuestas">Encuestas</a></li>
                <li class="breadcrumb-item active">Responder</li>
            </ol>
        </div>
    </div>
}
