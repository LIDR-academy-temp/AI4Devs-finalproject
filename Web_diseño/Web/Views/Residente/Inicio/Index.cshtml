@model Web.Models.Residente.ResidentHomePageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Inicio residente";
    var context = Model.Context;
    var propertyCount = context.Properties.Count;
}

<div class="container-fluid cq-resident-page">
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="mdi mdi-alert-circle mr-1"></i>@Model.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card cq-resident-hero mb-4">
        <div class="card-body">
            <div class="cq-resident-hero-grid">
                <div>
                    <span class="badge badge-pill badge-light text-uppercase">Mi portal</span>
                    <h3 class="mt-3 mb-2">Tu vivienda al día</h3>
                    <p class="mb-0">Pendientes, avisos y accesos clave en una sola vista.</p>

                    <div class="cq-resident-hero-pills mt-3">
                        <span class="cq-ticket-hero-pill"><i class="mdi mdi-home-city-outline"></i>@context.SelectedPropertyDisplay</span>
                        <span class="cq-ticket-hero-pill"><i class="mdi mdi-home-switch-outline"></i>@propertyCount vivienda(s)</span>
                        @if (Model.PendingSurveys > 0)
                        {
                            <span class="cq-ticket-hero-pill"><i class="mdi mdi-poll-box-outline"></i>@Model.PendingSurveys encuesta(s) pendiente(s)</span>
                        }
                    </div>
                </div>
                <div class="cq-resident-focus-card">
                    <span class="cq-resident-mini-label">Vivienda activa</span>
                    <strong>@context.SelectedPropertyDisplay</strong>
                    <div class="cq-resident-metric-strip">
                        <span class="cq-resident-metric-pill"><i class="mdi mdi-home-switch-outline"></i>@propertyCount vivienda(s)</span>
                        <span class="cq-resident-metric-pill"><i class="mdi mdi-poll-box-outline"></i>@(Model.PendingSurveys > 0 ? $"{Model.PendingSurveys} pendiente(s)" : "Sin pendientes")</span>
                    </div>
                    <a href="/Residente/Acceso?force=true" class="btn btn-light btn-sm">Cambiar vivienda</a>
                </div>
            </div>
        </div>
    </div>

    <div class="cq-resident-stat-grid mb-4">
        @foreach (var badge in Model.Badges)
        {
            <div class="cq-resident-stat-card cq-tone-@badge.ToneClass">
                <div class="cq-resident-stat-icon"><i class="mdi @badge.Icon"></i></div>
                <div>
                    <span>@badge.Label</span>
                    <strong>@badge.Count</strong>
                </div>
            </div>
        }
    </div>

    <div class="row">
        <div class="col-12 col-xl-8 mb-4 mb-xl-0">
            <div class="card h-100">
                <div class="card-body">
                    <div class="cq-resident-section-head">
                        <div>
                            <span class="cq-resident-kicker">Accesos rápidos</span>
                            <h4 class="card-title mb-1">Abre lo que más usas</h4>
                            <p class="text-muted mb-0">Menos lectura, más acciones directas.</p>
                        </div>
                    </div>

                    <div class="cq-resident-actions-grid">
                        <a href="/Residente/Encuestas" class="cq-resident-action-card">
                            <span class="cq-resident-action-icon"><i class="mdi mdi-poll"></i></span>
                            <strong>Encuestas</strong>
                            <p>@(Model.PendingSurveys > 0 ? $"Tienes {Model.PendingSurveys} pendiente(s) por responder." : "Revisa las encuestas activas de tu vivienda.")</p>
                            <span class="cq-resident-action-cta">Ir a encuestas</span>
                        </a>

                        <a href="/Residente/Notificaciones" class="cq-resident-action-card">
                            <span class="cq-resident-action-icon"><i class="mdi mdi-bell-outline"></i></span>
                            <strong>Avisos</strong>
                            <p>Revisa avisos personales y comunitarios en una sola vista.</p>
                            <span class="cq-resident-action-cta">Ver avisos</span>
                        </a>

                        <a href="/Residente/Vivienda" class="cq-resident-action-card">
                            <span class="cq-resident-action-icon"><i class="mdi mdi-home-city-outline"></i></span>
                            <strong>Mi vivienda</strong>
                            <p>Confirma la vivienda activa y cambia de contexto cuando haga falta.</p>
                            <span class="cq-resident-action-cta">Abrir vivienda</span>
                        </a>

                        <a href="/Residente/Cuenta" class="cq-resident-action-card">
                            <span class="cq-resident-action-icon"><i class="mdi mdi-cash-clock"></i></span>
                            <strong>Mi cuenta</strong>
                            <p>Revisa saldo, pagos visibles y próximos vencimientos.</p>
                            <span class="cq-resident-action-cta">Ver cuenta</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="cq-resident-section-head">
                        <div>
                            <span class="cq-resident-kicker">Resumen</span>
                            <h4 class="card-title mb-1">Lo esencial hoy</h4>
                            <p class="text-muted mb-0">Estado del portal en lectura rápida.</p>
                        </div>
                    </div>

                    <div class="cq-resident-detail-grid">
                        <div class="cq-resident-detail">
                            <span>Vivienda activa</span>
                            <strong>@context.SelectedPropertyDisplay</strong>
                        </div>

                        <div class="cq-resident-detail">
                            <span>Viviendas</span>
                            <strong>@propertyCount disponible(s)</strong>
                        </div>

                        <div class="cq-resident-detail">
                            <span>Encuestas</span>
                            <strong>@(Model.PendingSurveys > 0 ? $"{Model.PendingSurveys} pendiente(s)" : "Sin pendientes")</strong>
                        </div>

                        <div class="cq-resident-detail">
                            <span>Portal</span>
                            <strong>Listo para navegar</strong>
                        </div>
                    </div>

                    <div class="cq-resident-inline-actions mt-3">
                        <a href="/Residente/Acceso?force=true" class="btn btn-outline-secondary btn-sm">Cambiar vivienda</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-home-city-outline"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Inicio residente</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge"><i class="mdi mdi-map-marker-radius-outline"></i>@context.SelectedPropertyDisplay</span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <a href="/Residente/Acceso?force=true" class="btn btn-outline-secondary cq-tb-btn-new">
                <i class="mdi mdi-swap-horizontal-bold"></i><span>Cambiar vivienda</span>
            </a>
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item active">Portal residente</li>
            </ol>
        </div>
    </div>
}