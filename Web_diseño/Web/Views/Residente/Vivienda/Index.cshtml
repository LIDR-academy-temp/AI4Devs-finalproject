@model Web.Models.Residente.ResidentPropertyPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Mi vivienda";
    var context = Model.Context;
    var activeProperty = Model.ActiveProperty;
    var activeCasa = Model.ActiveCasa;
    var activeCondominio = Model.ActiveCondominio;
    var propertyCount = Model.AvailableProperties.Count;
    var casaDireccion = activeCasa is null
        ? (activeProperty?.CasaLabel ?? context.SelectedCasaLabel ?? "Sin vivienda activa")
        : $"{activeCasa.DireccionCasa} {activeCasa.NumeroExtCasa}".Trim();
    var condominioNombre = activeCondominio?.NombreCondominio ?? activeCasa?.NombreCondominio ?? context.SelectedCondominioName;
    var condominioDireccion = activeCondominio?.DireccionCondominio ?? activeCasa?.DireccionCondominio ?? activeProperty?.CondominioAddress;
}

<div class="container-fluid cq-resident-page">
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="mdi mdi-alert-circle mr-1"></i>@Model.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card cq-resident-hero mb-4">
        <div class="card-body">
            <div class="cq-resident-hero-grid">
                <div>
                    <span class="badge badge-pill badge-light text-uppercase">Mi vivienda</span>
                    <h3 class="mt-3 mb-2">Tu contexto activo</h3>
                    <p class="mb-0">Confirma la vivienda activa y cambia de propiedad cuando haga falta.</p>

                    <div class="cq-ticket-hero-pills mt-3">
                        <span class="cq-ticket-hero-pill"><i class="mdi mdi-home-city-outline"></i>@context.SelectedPropertyDisplay</span>
                        <span class="cq-ticket-hero-pill"><i class="mdi mdi-map-marker-outline"></i>@(string.IsNullOrWhiteSpace(casaDireccion) ? "Sin dirección disponible" : casaDireccion)</span>
                        <span class="cq-ticket-hero-pill"><i class="mdi mdi-home-switch-outline"></i>@propertyCount vivienda(s)</span>
                    </div>
                </div>
                <div class="cq-resident-focus-card">
                    <span class="cq-resident-mini-label">Contexto activo</span>
                    <strong>@context.SelectedPropertyDisplay</strong>
                    <div class="cq-resident-metric-strip">
                        <span class="cq-resident-metric-pill"><i class="mdi mdi-office-building-outline"></i>@(string.IsNullOrWhiteSpace(condominioNombre) ? "Sin condominio visible" : condominioNombre)</span>
                        <span class="cq-resident-metric-pill"><i class="mdi mdi-home-switch-outline"></i>@propertyCount vivienda(s)</span>
                    </div>
                    <a href="/Residente/Acceso?force=true" class="btn btn-light btn-sm">Cambiar vivienda</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12 col-xl-7 mb-4 mb-xl-0">
            <div class="card h-100">
                <div class="card-body">
                    <div class="cq-resident-section-head">
                        <div>
                            <span class="cq-resident-kicker">Resumen activo</span>
                            <h4 class="card-title mb-1">Datos base de tu portal</h4>
                            <p class="text-muted mb-0">La información que usan tickets, documentos y avisos.</p>
                        </div>
                        <span class="cq-stat-badge"><i class="mdi mdi-check-decagram-outline"></i><strong>Activa</strong></span>
                    </div>

                    <div class="cq-resident-detail-grid">
                        <div class="cq-resident-detail">
                            <span>Condominio</span>
                            <strong>@(string.IsNullOrWhiteSpace(condominioNombre) ? "Sin condominio visible" : condominioNombre)</strong>
                        </div>

                        <div class="cq-resident-detail">
                            <span>Dirección</span>
                            <strong>@(string.IsNullOrWhiteSpace(casaDireccion) ? "Sin dirección disponible" : casaDireccion)</strong>
                        </div>

                        <div class="cq-resident-detail">
                            <span>Referencia</span>
                            <strong>@(string.IsNullOrWhiteSpace(condominioDireccion) ? "Sin referencia registrada" : condominioDireccion)</strong>
                        </div>

                        <div class="cq-resident-detail">
                            <span>Etiqueta visible</span>
                            <strong>@(activeProperty?.CasaLabel ?? context.SelectedCasaLabel ?? "Sin etiqueta")</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-5">
            <div class="card h-100">
                <div class="card-body">
                    <div class="cq-resident-section-head">
                        <div>
                            <span class="cq-resident-kicker">Contacto</span>
                            <h4 class="card-title mb-1">Datos útiles</h4>
                            <p class="text-muted mb-0">Datos rápidos del propietario asociado.</p>
                        </div>
                    </div>

                    <div class="cq-resident-detail-grid mb-3">
                        <div class="cq-resident-detail">
                            <span>Propietario</span>
                            <strong>@(string.IsNullOrWhiteSpace(activeCasa?.NombrePropietario) ? "Sin nombre registrado" : activeCasa.NombrePropietario)</strong>
                        </div>

                        <div class="cq-resident-detail">
                            <span>Correo</span>
                            <strong>@(string.IsNullOrWhiteSpace(activeCasa?.CorreoPropietario) ? "Sin correo registrado" : activeCasa.CorreoPropietario)</strong>
                        </div>

                        <div class="cq-resident-detail">
                            <span>Teléfono</span>
                            <strong>@(string.IsNullOrWhiteSpace(activeCasa?.TelefonoPropietario) ? "Sin teléfono registrado" : activeCasa.TelefonoPropietario)</strong>
                        </div>
                    </div>

                    <div class="cq-resident-inline-actions">
                        <a href="/Residente/Perfil" class="btn btn-outline-primary btn-sm">Actualizar perfil</a>
                        <a href="/Residente/Tickets?newTicket=true&focus=detail&tab=created" class="btn btn-outline-primary btn-sm">Levantar ticket</a>
                        <a href="/Residente/Documentos" class="btn btn-outline-secondary btn-sm">Ver documentos</a>
                        <a href="/Residente/Notificaciones" class="btn btn-outline-secondary btn-sm">Ver avisos</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="cq-resident-section-head">
                <div>
                    <span class="cq-resident-kicker">Cambio de contexto</span>
                    <h4 class="card-title mb-1">Tus viviendas disponibles</h4>
                    <p class="text-muted mb-0">Cambia la vivienda activa desde esta misma vista.</p>
                </div>
                <span class="cq-stat-badge"><i class="mdi mdi-home-switch-outline"></i><strong>@propertyCount</strong> vivienda(s)</span>
            </div>

            <div class="cq-resident-property-grid">
                @foreach (var property in Model.AvailableProperties)
                {
                    var isActive = property.CasaId == context.SelectedCasaId;
                    <form asp-controller="Contexto" asp-action="SeleccionarVivienda" method="post" class="cq-resident-property-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="casaId" value="@property.CasaId" />
                        <input type="hidden" name="returnUrl" value="/Residente/Vivienda" />

                        <button type="submit" class="cq-resident-property-card text-left" @(isActive ? "disabled" : null)>
                            <span class="cq-resident-property-icon"><i class="mdi @(isActive ? "mdi-check-decagram-outline" : "mdi-home-city-outline")"></i></span>
                            <span class="cq-resident-property-body">
                                <strong>@property.CondominioName</strong>
                                <span>@property.CasaLabel</span>
                                @if (!string.IsNullOrWhiteSpace(property.CondominioAddress))
                                {
                                    <small>@property.CondominioAddress</small>
                                }
                            </span>
                            <span class="cq-resident-property-cta">
                                @if (isActive)
                                {
                                    <span class="badge badge-success">Activa</span>
                                }
                                else
                                {
                                    <i class="mdi mdi-arrow-right"></i>
                                }
                            </span>
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-home-city-outline"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Mi vivienda</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge"><i class="mdi mdi-map-marker-radius-outline"></i>@context.SelectedPropertyDisplay</span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <a href="/Residente/Acceso?force=true" class="btn btn-outline-secondary cq-tb-btn-new">
                <i class="mdi mdi-swap-horizontal-bold"></i><span>Cambiar vivienda</span>
            </a>
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item"><a href="/Residente/Inicio">Portal residente</a></li>
                <li class="breadcrumb-item active">Mi vivienda</li>
            </ol>
        </div>
    </div>
}