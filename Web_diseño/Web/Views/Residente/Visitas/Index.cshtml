@model Web.Models.Residente.ResidentVisitPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Visitas";
    var context = Model.Context;
}

<div class="container-fluid cq-resident-page">
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="mdi mdi-alert-circle mr-1"></i>@Model.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card cq-reserva-hero mb-4">
        <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="flex-grow-1">
                <span class="badge badge-pill cq-reserva-pill">Visitas</span>
                <h3 class="mb-2 mt-2">Autoriza visitas sin rodeos</h3>
                <p class="mb-0">Registra invitados y revisa solo el historial de <strong>@context.SelectedPropertyDisplay</strong>.</p>
            </div>
            <div class="d-flex flex-wrap gap-2 cq-reserva-stat-strip">
                <div class="cq-reserva-stat"><span>Total</span><strong>@Model.TotalVisitas</strong></div>
                <div class="cq-reserva-stat"><span>Próximas</span><strong>@Model.TotalProximas</strong></div>
                <div class="cq-reserva-stat"><span>Activas</span><strong>@Model.TotalActivas</strong></div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-5 mb-4 mb-lg-0">
            <div class="card cq-reserva-form-panel h-100">
                <div class="card-body">
                    <div class="cq-resident-section-head mb-3">
                        <div>
                            <span class="cq-resident-kicker">Nueva visita</span>
                            <h4 class="card-title mb-1">Captura rápida</h4>
                            <p class="text-muted mb-0">El vecino y la vivienda se toman de tu sesión.</p>
                        </div>
                        <span class="badge badge-pill @(Model.PuedeGuardar ? "badge-success" : "badge-warning")">
                            @(Model.PuedeGuardar ? "Listo para autorizar" : "Catálogo pendiente")
                        </span>
                    </div>

                    <form action="/Residente/Visitas/Guardar" method="post" enctype="multipart/form-data" class="cq-reserva-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="soloProximas" value="@Model.SoloProximas.ToString().ToLowerInvariant()" />
                        <input asp-for="Form.VisitaID" type="hidden" />
                        <input asp-for="Form.UsuarioVisitadoID" type="hidden" />
                        <input asp-for="Form.CasaID" type="hidden" />
                        <input asp-for="Form.Autorizado" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group">
                            <label asp-for="Form.VisitanteNombre"></label>
                            <input asp-for="Form.VisitanteNombre" class="form-control" placeholder="Nombre completo del visitante" />
                            <span asp-validation-for="Form.VisitanteNombre" class="text-danger"></span>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label asp-for="Form.TipoIdentificacionID"></label>
                                <select asp-for="Form.TipoIdentificacionID" asp-items="Model.TipoIdentificacionOptions" class="form-control cq-reserva-select">
                                    <option value="">Selecciona un tipo</option>
                                </select>
                                <span asp-validation-for="Form.TipoIdentificacionID" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Form.NumeroIdentificacion"></label>
                                <input asp-for="Form.NumeroIdentificacion" class="form-control" placeholder="Folio o número" />
                                <span asp-validation-for="Form.NumeroIdentificacion" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label asp-for="Form.FechaEntrada"></label>
                                <input asp-for="Form.FechaEntrada" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                                <span asp-validation-for="Form.FechaEntrada" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Form.FechaSalida"></label>
                                <input asp-for="Form.FechaSalida" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                                <span asp-validation-for="Form.FechaSalida" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label asp-for="Form.DocumentoArchivo"></label>
                            <input asp-for="Form.DocumentoArchivo" type="file" class="form-control-file" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" />
                            <small class="form-text text-muted">Adjunta identificación o pase de referencia. Máximo 20 MB.</small>
                            <span asp-validation-for="Form.DocumentoArchivo" class="text-danger"></span>
                        </div>

                        <div class="cq-reserva-form-note">
                            <i class="mdi mdi-home-account"></i>
                            Quedará vinculada a <strong>@context.SelectedPropertyDisplay</strong> y autorizada a tu nombre.
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <button type="submit" class="btn btn-info" @(Model.PuedeGuardar ? null : "disabled")>Guardar visita</button>
                            <a href="/Residente/Visitas" class="btn btn-outline-secondary">Limpiar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card cq-reserva-preview-panel h-100">
                <div class="card-body">
                    <div class="cq-resident-section-head mb-3">
                        <div>
                            <span class="cq-resident-kicker">Historial</span>
                            <h4 class="card-title mb-1">Visitas visibles</h4>
                            <p class="text-muted mb-0">Solo ves registros de tu vivienda activa.</p>
                        </div>
                        <form method="get" action="/Residente/Visitas" class="d-flex align-items-center gap-2">
                            <label class="cq-tb-toggle @(Model.SoloProximas ? "active" : string.Empty)">
                                <input type="checkbox" name="soloProximas" value="true" @(Model.SoloProximas ? "checked" : string.Empty) onchange="this.form.submit()" />
                                <i class="mdi mdi-calendar-clock"></i> Solo próximas
                            </label>
                        </form>
                    </div>

                    @if (!Model.Items.Any())
                    {
                        <div class="cq-reserva-empty mt-3">
                            <div class="cq-reserva-empty-icon"><i class="mdi mdi-account-clock-outline"></i></div>
                            <h5 class="mb-2">Sin visitas registradas</h5>
                            <p class="text-muted mb-0">No hay visitas para el filtro actual.</p>
                        </div>
                    }
                    else
                    {
                        <div class="cq-resident-actions-grid">
                            @foreach (var item in Model.Items)
                            {
                                <article class="cq-resident-action-card">
                                    <span class="cq-resident-action-icon"><i class="mdi mdi-account-plus-outline"></i></span>
                                    <strong>@item.VisitanteNombre</strong>
                                    <p>
                                        @(item.FechaEntrada.ToString("dd/MM/yyyy HH:mm"))
                                        @if (item.FechaSalida.HasValue)
                                        {
                                            <span> - @item.FechaSalida.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                        }
                                        <br />
                                        @(string.IsNullOrWhiteSpace(item.TipoIdentificacionNombre) ? "Identificación" : item.TipoIdentificacionNombre): @item.NumeroIdentificacion
                                    </p>
                                    <span class="badge @item.EstadoTemporalClase mb-2">@item.EstadoTemporal</span>
                                    <small class="text-muted d-block mb-2">@(string.IsNullOrWhiteSpace(item.CasaDescripcion) ? context.SelectedPropertyDisplay : item.CasaDescripcion)</small>
                                    <div class="d-flex flex-wrap gap-2 mt-auto">
                                        @if (!string.IsNullOrWhiteSpace(item.RutaDocumento))
                                        {
                                            <a href="/@item.RutaDocumento" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm">Documento</a>
                                        }
                                        @if (item.EstadoTemporal != "Finalizada")
                                        {
                                            <form action="/Residente/Visitas/Cancelar" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="visitaId" value="@item.VisitaID" />
                                                <input type="hidden" name="soloProximas" value="@Model.SoloProximas.ToString().ToLowerInvariant()" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('¿Cancelar esta visita?');">Cancelar</button>
                                            </form>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-account-plus-outline"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Visitas</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge"><i class="mdi mdi-map-marker-radius-outline"></i>@context.SelectedPropertyDisplay</span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item"><a href="/Residente/Inicio">Portal residente</a></li>
                <li class="breadcrumb-item active">Visitas</li>
            </ol>
        </div>
    </div>
}