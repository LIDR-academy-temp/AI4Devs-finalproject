    <script type="text/javascript">
    // Toggle sidebar en mobile
    // En desktop custom.min.js ya maneja el toggle de mini-sidebar — no duplicar.
    document.addEventListener('DOMContentLoaded', function () {
        var toggleBtn = document.querySelector('.js-sidebar-toggle');
        var overlay   = document.getElementById('cq-sidebar-overlay');

        function openSidebar() {
            // Quitar mini-sidebar para mostrar el menú completo en mobile
            document.body.classList.remove('mini-sidebar');
            document.body.classList.add('cq-mobile-open');
            if (overlay) overlay.style.display = 'block';
        }
        function closeSidebar() {
            document.body.classList.remove('cq-mobile-open');
            // Restaurar mini-sidebar que custom.min.js aplica en < 1170px
            if (window.innerWidth < 1170) document.body.classList.add('mini-sidebar');
            if (overlay) overlay.style.display = 'none';
        }

        if (toggleBtn) {
            toggleBtn.addEventListener('click', function (e) {
                if (window.innerWidth < 768) {
                    // mobile: interceptar el click ANTES de que custom.min.js lo procese
                    e.stopImmediatePropagation();
                    e.preventDefault();
                    document.body.classList.contains('cq-mobile-open') ? closeSidebar() : openSidebar();
                }
                // desktop: dejar que custom.min.js maneje el toggle normalmente
            }, true); // capture=true para interceptar primero en mobile
        }
        if (overlay) {
            overlay.addEventListener('click', closeSidebar);
        }
    });
    </script>
