@using Web.Models.Admin
@model ResidentMenuViewModel

@{
    var residentContext = Model.ResidentContext;
    var parents   = Model.PermissionMenus.Where(m => m.PadreMenuID == null && !string.Equals(m.Ruta, "Residente/Perfil", StringComparison.OrdinalIgnoreCase) && !string.Equals(m.Ruta, "Gestion/Perfil", StringComparison.OrdinalIgnoreCase)).OrderBy(m => m.Orden).ToList();
    var profileRoute = residentContext?.IsResident == true ? "Residente/Perfil" : "Gestion/Perfil";
    var hasProfileAccess = Model.PermissionMenus.Any(m => string.Equals(m.Ruta, profileRoute, StringComparison.OrdinalIgnoreCase))
        || Model.PermissionMenus.SelectMany(m => m.Children).Any(m => string.Equals(m.Ruta, profileRoute, StringComparison.OrdinalIgnoreCase));
    var nombre    = CotoContext.GetNombreUsuario(User);
    var fotoUrl   = CotoContext.GetFotoUrl(User);
    var partes    = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var iniciales = partes.Length >= 2
        ? $"{char.ToUpper(partes[0][0])}{char.ToUpper(partes[1][0])}"
        : partes.Length == 1 ? char.ToUpper(partes[0][0]).ToString() : "?";
    var nombreCorto = partes.Length > 0 ? partes[0] : nombre;

    static string NormalizeMenuTitle(string? title) => title switch
    {
        "Gestion Residencial" => "Gestión residencial",
        "Administracion del Sistema" => "Administración del sistema",
        "Areas y Documentos" => "Áreas y documentos",
        "Areas Comunes" => "Áreas comunes",
        _ => title ?? string.Empty
    };
}

<ul id="sidebarnav">
    <li class="user-profile">
        <a class="has-arrow waves-effect waves-dark" href="#" aria-expanded="false" aria-label="Menú de usuario">
            @if (fotoUrl != null)
            {
                <img src="@fotoUrl" alt="@nombre" style="width:35px;height:35px;object-fit:cover;border-radius:50%;" />
            }
            else
            {
                <span class="cq-sidebar-avatar" aria-hidden="true">@iniciales</span>
            }
            <span class="hide-menu">@nombreCorto</span>
        </a>
        <ul aria-expanded="false" class="collapse">
            @if (residentContext?.IsResident == true)
            {
                <li class="cq-sidebar-resident-context-item">
                    <div class="cq-sidebar-resident-context">
                        <span class="cq-sidebar-resident-label">Vivienda activa</span>
                        <strong>@residentContext.SelectedPropertyDisplay</strong>
                        <a href="/Residente/Acceso?force=true" class="cq-sidebar-resident-link">Cambiar vivienda</a>
                    </div>
                </li>
            }
            @if (hasProfileAccess)
            {
                <li><a href="/@profileRoute">Mi Perfil</a></li>
            }
            <li><a asp-controller="Login" asp-action="Logout">Salir</a></li>
        </ul>
    </li>
    <li class="nav-devider"></li>

    @if (residentContext?.IsResident == true)
    {
        <li class="nav-small-cap">Mi portal</li>

        @if (Model.Badges.Any())
        {
            <li class="cq-sidebar-resident-badges">
                @foreach (var badge in Model.Badges.Where(item => item.Count > 0))
                {
                    if (!string.IsNullOrWhiteSpace(badge.Href))
                    {
                        <a href="@badge.Href" class="cq-sidebar-resident-pill cq-tone-@badge.ToneClass">
                            <i class="mdi @badge.Icon" aria-hidden="true"></i>
                            <span>@badge.Label</span>
                            <strong>@badge.Count</strong>
                        </a>
                    }
                    else
                    {
                        <span class="cq-sidebar-resident-pill cq-tone-@badge.ToneClass">
                            <i class="mdi @badge.Icon" aria-hidden="true"></i>
                            <span>@badge.Label</span>
                            <strong>@badge.Count</strong>
                        </span>
                    }
                }
            </li>
        }
    }
    else
    {
        <li class="nav-small-cap">Menú</li>
    }

    @foreach (var parent in parents)
    {
        var children = parent.Children.Where(c => c.bVisible).OrderBy(c => c.Orden).ToList();
        var parentTitle = NormalizeMenuTitle(parent.TituloMenu);

        if (children.Any())
        {
            <li>
                <a class="has-arrow waves-effect waves-dark" href="#" aria-expanded="false" aria-label="@parentTitle">
                    @if (!string.IsNullOrEmpty(parent.Icono))
                    {
                        <i class="mdi @parent.Icono" aria-hidden="true"></i>
                    }
                    <span class="hide-menu">@parentTitle</span>
                </a>
                <ul aria-expanded="false" class="collapse">
                    @foreach (var child in children)
                    {
                        var childTitle = NormalizeMenuTitle(child.TituloMenu);
                        <li>
                            <a href="/@child.Ruta" class="waves-effect waves-dark" aria-label="@childTitle">
                                <i class="mdi @(!string.IsNullOrEmpty(child.Icono) ? child.Icono : "mdi-circle-small")" aria-hidden="true"></i>
                                <span class="hide-menu">@childTitle</span>
                            </a>
                        </li>
                    }
                </ul>
            </li>
        }
        else if (!string.IsNullOrEmpty(parent.Ruta))
        {
            <li>
                <a href="/@parent.Ruta" class="waves-effect waves-dark" aria-label="@parentTitle">
                    @if (!string.IsNullOrEmpty(parent.Icono))
                    {
                        <i class="mdi @parent.Icono" aria-hidden="true"></i>
                    }
                    <span class="hide-menu">@parentTitle</span>
                </a>
            </li>
        }
    }
    @if (CotoContext.GetIsAdministrador(User))
    {
        <li class="nav-devider"></li>
        <li class="nav-small-cap">Sistema</li>
        <li>
            <a href="/Admin/TemaSitio" class="waves-effect waves-dark" aria-label="Template del sitio">
                <i class="mdi mdi-palette-outline" aria-hidden="true"></i>
                <span class="hide-menu">Template del sitio</span>
            </a>
        </li>
    }
</ul>
