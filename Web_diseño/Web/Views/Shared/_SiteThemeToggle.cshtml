@inject Web.Services.ISiteThemeService SiteTheme
@{
    var config = SiteTheme.GetConfig();
    var defaultThemeId = SiteTheme.GetDefaultThemeId();
    var defaultLabel = config.Themes.TryGetValue(defaultThemeId, out var theme)
        ? theme.Label.ToUpperInvariant()
        : defaultThemeId.ToUpperInvariant();
}
@if (config.AllowUserSwitch)
{
    <li class="nav-item cq-theme-toggle-item">
        <button id="cq-theme-toggle"
                type="button"
                class="btn btn-sm"
                aria-label="Cambiar template del sitio">
            <span aria-hidden="true">&#127912;</span>
            <span id="cq-theme-label">@defaultLabel</span>
        </button>
    </li>
}
