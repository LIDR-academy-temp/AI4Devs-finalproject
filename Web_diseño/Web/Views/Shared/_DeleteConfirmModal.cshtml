<div class="modal fade cq-confirm-modal" id="deleteConfirmModal" tabindex="-1"
     aria-labelledby="deleteConfirmModalLabel" aria-describedby="deleteConfirmModalCopy"
     aria-modal="true" role="dialog">
    <div class="modal-dialog modal-dialog-centered cq-confirm-modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center">
                    <div class="cq-confirm-modal-icon mr-3" aria-hidden="true">
                        <i class="mdi mdi-alert-outline"></i>
                    </div>
                    <div>
                        <p class="cq-confirm-modal-kicker mb-1">Confirmación requerida</p>
                        <h5 class="modal-title mb-0" id="deleteConfirmModalLabel">Confirmar eliminación</h5>
                    </div>
                </div>
                <button type="button" class="close ml-auto" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body pt-3">
                <p class="cq-confirm-copy mb-2" id="deleteConfirmModalCopy">
                    Esta acción no se puede deshacer.
                </p>
                <p class="cq-confirm-hint mb-0">Se eliminará el registro en cuanto confirmes.</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light cq-confirm-cancel" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger cq-confirm-submit" id="deleteConfirmModalSubmit">Eliminar</button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    function initDeleteConfirmModal() {
        var modalEl = document.getElementById('deleteConfirmModal');
        if (!modalEl || modalEl.dataset.cqDeleteModalReady === 'true') {
            return;
        }

        modalEl.dataset.cqDeleteModalReady = 'true';

        var titleEl = document.getElementById('deleteConfirmModalLabel');
        var copyEl = document.getElementById('deleteConfirmModalCopy');
        var confirmBtn = document.getElementById('deleteConfirmModalSubmit');
        var activeForm = null;

        function getJqModal() {
            if (window.jQuery && window.jQuery.fn && window.jQuery.fn.modal) {
                return window.jQuery(modalEl);
            }

            return null;
        }

        function getBs5Modal() {
            if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                return bootstrap.Modal.getOrCreateInstance(modalEl);
            }

            return null;
        }

        function resetModalState() {
            activeForm = null;
            titleEl.textContent = 'Confirmar eliminación';
            copyEl.textContent = 'Esta acción no se puede deshacer.';
            confirmBtn.textContent = 'Eliminar';
            confirmBtn.setAttribute('aria-label', 'Eliminar');
        }

        function showModal() {
            var jqModal = getJqModal();
            if (jqModal) {
                jqModal.modal('show');
                return true;
            }

            var bs5Modal = getBs5Modal();
            if (bs5Modal) {
                bs5Modal.show();
                return true;
            }

            return false;
        }

        document.addEventListener('click', function (event) {
            var trigger = event.target.closest('.js-delete-trigger');
            if (!trigger) {
                return;
            }

            event.preventDefault();

            var formId = trigger.getAttribute('data-delete-form');
            activeForm = formId ? document.getElementById(formId) : trigger.closest('form');
            if (!activeForm) {
                return;
            }

            var title = trigger.getAttribute('data-delete-title') || 'Confirmar eliminación';
            var message = trigger.getAttribute('data-delete-message') || 'Esta acción no se puede deshacer.';
            var confirmLabel = trigger.getAttribute('data-delete-confirm-label') || 'Eliminar';

            titleEl.textContent = title;
            copyEl.textContent = message;
            confirmBtn.textContent = confirmLabel;
            confirmBtn.setAttribute('aria-label', confirmLabel);

            showModal();
        });

        confirmBtn.addEventListener('click', function () {
            if (activeForm) {
                activeForm.submit();
            }
        });

        var jqModal = getJqModal();
        if (jqModal) {
            jqModal.on('hidden.bs.modal', resetModalState);
            return;
        }

        modalEl.addEventListener('hidden.bs.modal', resetModalState);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initDeleteConfirmModal);
        return;
    }

    initDeleteConfirmModal();
}());
</script>