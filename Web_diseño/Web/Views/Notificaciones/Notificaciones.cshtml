@model NotificacionesPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Notificaciones";
    var isEditing = Model.Form.NotificacionID.HasValue && Model.Form.NotificacionID.Value > 0;
    var totalConFecha = Model.Items.Count(item => item.FechaCreacionNotificacion.HasValue);
}

<div class="container-fluid">
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="mdi mdi-alert-circle mr-1"></i>@Model.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card cq-reserva-hero mb-4">
        <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="flex-grow-1">
                <span class="badge badge-pill cq-reserva-pill">Avisos internos</span>
                <h3 class="mb-2 mt-2">Gestiona notificaciones con lectura simple</h3>
                <p class="mb-0">Consulta estado, fecha y mensaje antes de editar o eliminar un aviso.</p>
            </div>
            <div class="d-flex flex-wrap gap-2 cq-reserva-stat-strip">
                <div class="cq-reserva-stat"><span>Notificaciones</span><strong>@Model.Items.Count</strong></div>
                <div class="cq-reserva-stat"><span>No leídas</span><strong>@Model.TotalNoLeidas</strong></div>
                <div class="cq-reserva-stat"><span>Con fecha</span><strong>@totalConFecha</strong></div>
            </div>
        </div>
    </div>

    <div class="cq-split @(isEditing ? "panel-open" : "")" id="cqSplit">
        <div class="cq-table-pane">
            <div class="card"><div class="card-body">
                <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-2 mb-3">
                    <div>
                        <h4 class="card-title mb-1">Listado de notificaciones</h4>
                        <p class="text-muted mb-0">Revisa el mensaje, identifica si fue leído y abre la ficha correcta desde aquí.</p>
                    </div>
                    <span class="badge badge-light">@Model.Items.Count registro(s)</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle cq-filterable">
                        <thead>
                            <tr>
                                <th data-type="text">Título</th>
                                <th data-type="text">Mensaje</th>
                                <th data-type="date">Fecha</th>
                                <th data-type="bool">Estado</th>
                                <th data-type="none">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items.Any())
                            {
                                foreach (var item in Model.Items)
                                {
                                    var rowActive = isEditing && Model.Form.NotificacionID == item.NotificacionID;
                                    <tr class="@(rowActive ? "cq-row-active" : "")">
                                        <td><strong>@item.Titulo</strong></td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(item.Mensaje))
                                            {
                                                <span class="text-muted small">@(item.Mensaje.Length > 80 ? item.Mensaje[..80] + "…" : item.Mensaje)</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.FechaCreacionNotificacion.HasValue)
                                            {
                                                <span>@item.FechaCreacionNotificacion.Value.ToString("dd/MM/yyyy")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.Leido)
                                            {
                                                <span class="badge badge-secondary">Leída</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-warning">No leída</span>
                                            }
                                        </td>
                                        <td class="cq-actions">
                                            <div class="cq-actions-group">
                                                <a cq-btn="edit" asp-action="Index" asp-controller="Notificaciones"
                                                   asp-route-editId="@item.NotificacionID"
                                                   asp-route-soloNoLeidas="@Model.SoloNoLeidas" title="Editar"></a>
                                                <form asp-action="Delete" asp-controller="Notificaciones" method="post" class="d-inline"
                                                      onsubmit="return confirm('¿Eliminar esta notificación?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="notificacionId" value="@item.NotificacionID" />
                                                    <input type="hidden" name="soloNoLeidas" value="@Model.SoloNoLeidas.ToString().ToLower()" />
                                                    <button cq-btn="delete" type="submit" title="Eliminar"></button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5">
                                        <div class="cq-reserva-empty cq-reserva-empty--table">
                                            <div class="cq-reserva-empty-icon"><i class="mdi mdi-bell-outline"></i></div>
                                            <h5 class="mb-2">Sin avisos registrados</h5>
                                            <p class="text-muted mb-0">Crea la primera notificación para comunicar cambios o incidencias del sistema.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div></div>
        </div>
        <div class="cq-form-pane" id="cqFormPane">
            <div class="card @(isEditing ? "cq-card-editing" : "")">
                <div class="cq-panel-header">
                    <div class="cq-panel-icon"><i class="mdi @(isEditing ? "mdi-pencil" : "mdi-plus")"></i></div>
                    <div class="flex-grow-1 min-width-0">
                        <h5 class="mb-0">@(isEditing ? "Editar notificación" : "Nueva notificación")</h5>
                        <small class="text-muted">Captura o corrige el aviso sin salir del tablero.</small>
                    </div>
                    <button type="button" class="cq-close-btn" id="btnCerrarPanel"><i class="mdi mdi-close"></i></button>
                </div>
                <div class="card-body pt-3">
                    <form asp-action="Save" asp-controller="Notificaciones" method="post" class="m-t-20">
                        @Html.AntiForgeryToken()
                        <input asp-for="Form.NotificacionID" type="hidden" />
                        <input type="hidden" name="soloNoLeidas" value="@Model.SoloNoLeidas.ToString().ToLower()" />

                        <div class="form-group">
                            <label asp-for="Form.Titulo">Título</label>
                            <input asp-for="Form.Titulo" class="form-control" placeholder="Ej. Aviso de corte de agua" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.Mensaje">Mensaje</label>
                            <textarea asp-for="Form.Mensaje" class="form-control" rows="4" placeholder="Detalle de la notificación..."></textarea>
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.UsuarioID">Usuario destino (ID)</label>
                            <input asp-for="Form.UsuarioID" class="form-control" type="number" placeholder="0 = todos" />
                        </div>
                        <div class="form-group form-check">
                            <input asp-for="Form.Leido" class="form-check-input" />
                            <label asp-for="Form.Leido" class="form-check-label">Marcada como leída</label>
                        </div>

                        <div class="cq-form-actions">
                            <button type="submit" class="btn btn-primary flex-grow-1"><i class="mdi mdi-content-save mr-1"></i>Guardar</button>
                            <a asp-action="Index" asp-controller="Notificaciones" asp-route-soloNoLeidas="@Model.SoloNoLeidas" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
    (function () {
        var split     = document.getElementById('cqSplit');
        var btnNuevo  = document.getElementById('btnNuevaNotificacion');
        var btnCerrar = document.getElementById('btnCerrarPanel');
        var isEditing = @(isEditing ? "true" : "false");
        var cancelUrl = '@Html.Raw(Url.Action("Index", "Notificaciones", new { soloNoLeidas = Model.SoloNoLeidas }))';
        function openPanel()  { split.classList.add('panel-open'); }
        function closePanel() {
            if (isEditing) { window.location.href = cancelUrl; }
            else { split.classList.remove('panel-open'); }
        }
        if (btnNuevo)  btnNuevo.addEventListener('click', openPanel);
        if (btnCerrar) btnCerrar.addEventListener('click', closePanel);
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && split.classList.contains('panel-open')) closePanel();
        });
    }());
    </script>
</div>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-bell"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Notificaciones</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge"><i class="mdi mdi-bell"></i><strong>@Model.Items.Count</strong></span>
                    <span class="cq-tb-badge"><i class="mdi mdi-bell-ring"></i><strong>@Model.TotalNoLeidas</strong> no leídas</span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <form method="get" asp-action="Index" asp-controller="Notificaciones"
                  class="cq-tb-filters d-inline-flex align-items-center gap-2" id="frmFiltrosTop">
                <input type="hidden" name="editId" value="" />
                <label class="cq-tb-toggle @(Model.SoloNoLeidas ? "active" : "")">
                    <input type="checkbox" name="soloNoLeidas" value="true"
                           @(Model.SoloNoLeidas ? "checked" : "")
                           onchange="document.getElementById('frmFiltrosTop').submit()" />
                    <i class="mdi mdi-check-circle-outline"></i> Solo no leídas
                </label>
            </form>
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item active">Notificaciones</li>
            </ol>
            <button type="button" class="btn btn-primary cq-tb-btn-new" id="btnNuevaNotificacion">
                <i class="mdi mdi-plus"></i><span>Nuevo</span>
            </button>
        </div>
    </div>
}
