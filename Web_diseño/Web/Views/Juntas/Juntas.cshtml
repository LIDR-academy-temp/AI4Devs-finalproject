@model JuntasPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Juntas";
    var isEditing = Model.Form.JuntaID.HasValue && Model.Form.JuntaID.Value > 0;
    var totalConFecha = Model.Items.Count(j => j.FechaProgramada.HasValue);
    var totalConUbicacion = Model.Items.Count(j => !string.IsNullOrWhiteSpace(j.Ubicacion));

    var calendarEvents = Model.Items
        .Where(j => j.FechaProgramada.HasValue)
        .Select(j => new {
            id       = j.JuntaID?.ToString() ?? "",
            title    = j.Titulo,
            start    = j.FechaProgramada!.Value.ToString("yyyy-MM-dd'T'HH:mm:ss"),
            color     = j.bActivo ? "#d97706" : "#6b7280",
            textColor = "#ffffff",
            extendedProps = new {
                descripcion = j.Descripcion ?? "",
                ubicacion   = j.Ubicacion   ?? "",
                activo      = j.bActivo
            }
        });
    var eventsJson = System.Text.Json.JsonSerializer.Serialize(calendarEvents);
}
<div class="container-fluid">
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="mdi mdi-alert-circle mr-1"></i>@Model.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card cq-reserva-hero mb-4">
        <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="flex-grow-1">
                <span class="badge badge-pill cq-reserva-pill">Agenda común</span>
                <h3 class="mb-2 mt-2">Programa juntas con lectura clara</h3>
                <p class="mb-0">Consulta fecha, ubicación y estado antes de editar o reagendar una junta.</p>
            </div>
            <div class="d-flex flex-wrap gap-2 cq-reserva-stat-strip">
                <div class="cq-reserva-stat"><span>Juntas</span><strong>@Model.Items.Count</strong></div>
                <div class="cq-reserva-stat"><span>Activas</span><strong>@Model.TotalActivas</strong></div>
                <div class="cq-reserva-stat"><span>Con ubicación</span><strong>@totalConUbicacion</strong></div>
            </div>
        </div>
    </div>

    <div class="cq-split @(isEditing ? "panel-open" : "")" id="cqSplit">
        <div class="cq-table-pane">
            <div class="card"><div class="card-body">
                <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-2 mb-3">
                    <div>
                        <h4 class="card-title mb-1">Listado de juntas</h4>
                        <p class="text-muted mb-0">Abre la sesión correcta y valida su contexto antes de enviarla al calendario.</p>
                    </div>
                    <span class="badge badge-light">@Model.Items.Count registro(s)</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle cq-filterable">
                        <thead>
                            <tr>
                                <th data-type="text">Título</th>
                                <th data-type="date">Fecha</th>
                                <th data-type="text">Ubicación</th>
                                <th data-type="bool">Estado</th>
                                <th data-type="none">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items.Any())
                            {
                                foreach (var item in Model.Items)
                                {
                                    var rowActive = isEditing && Model.Form.JuntaID == item.JuntaID;
                                    <tr class="@(rowActive ? "cq-row-active" : "")">
                                        <td>
                                            <strong>@item.Titulo</strong>
                                            @if (!string.IsNullOrWhiteSpace(item.Descripcion))
                                            {
                                                <div class="text-muted small">@item.Descripcion</div>
                                            }
                                        </td>
                                        <td>
                                            @if (item.FechaProgramada.HasValue)
                                            {
                                                <span>@item.FechaProgramada.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Sin fecha</span>
                                            }
                                        </td>
                                        <td>@(item.Ubicacion ?? "—")</td>
                                        <td>
                                            @if (item.bActivo)
                                            {
                                                <span class="badge badge-success">Activa</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">Inactiva</span>
                                            }
                                        </td>
                                        <td class="cq-actions">
                                            <div class="cq-actions-group">
                                                <a cq-btn="edit" asp-action="Index" asp-controller="Juntas"
                                                   asp-route-editId="@item.JuntaID"
                                                   asp-route-soloActivas="@Model.SoloActivas" title="Editar"></a>
                                                <form asp-action="Delete" asp-controller="Juntas" method="post" class="d-inline"
                                                      onsubmit="return confirm('¿Eliminar esta junta?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="juntaId" value="@item.JuntaID" />
                                                    <input type="hidden" name="soloActivas" value="@Model.SoloActivas.ToString().ToLower()" />
                                                    <button cq-btn="delete" type="submit" title="Eliminar"></button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5">
                                        <div class="cq-reserva-empty cq-reserva-empty--table">
                                            <div class="cq-reserva-empty-icon"><i class="mdi mdi-account-group-outline"></i></div>
                                            <h5 class="mb-2">Sin juntas registradas</h5>
                                            <p class="text-muted mb-0">Crea la primera junta para empezar a organizar agenda y asistencia.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div></div>
        </div>
        <div class="cq-form-pane" id="cqFormPane">
            <div class="card @(isEditing ? "cq-card-editing" : "")">
                <div class="cq-panel-header">
                    <div class="cq-panel-icon"><i class="mdi @(isEditing ? "mdi-pencil" : "mdi-plus")"></i></div>
                    <div class="flex-grow-1 min-width-0">
                        <h5 class="mb-0">@(isEditing ? "Editar junta" : "Nueva junta")</h5>
                        <small class="text-muted">Captura o ajusta la reunión sin salir de esta vista.</small>
                    </div>
                    <button type="button" class="cq-close-btn" id="btnCerrarPanel"><i class="mdi mdi-close"></i></button>
                </div>
                <div class="card-body pt-3">
                    <form asp-action="Save" asp-controller="Juntas" method="post" class="m-t-20">
                        @Html.AntiForgeryToken()
                        <input asp-for="Form.JuntaID" type="hidden" />
                        <input type="hidden" name="soloActivas" value="@Model.SoloActivas.ToString().ToLower()" />

                        <div class="form-group">
                            <label asp-for="Form.Titulo">Título</label>
                            <input asp-for="Form.Titulo" class="form-control" placeholder="Ej. Junta ordinaria enero" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.Descripcion">Descripción</label>
                            <textarea asp-for="Form.Descripcion" class="form-control" rows="3" placeholder="Temas a tratar..."></textarea>
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.FechaProgramada">Fecha programada</label>
                            <input asp-for="Form.FechaProgramada" class="form-control" type="datetime-local" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.Ubicacion">Ubicación</label>
                            <input asp-for="Form.Ubicacion" class="form-control" placeholder="Salón de usos múltiples" />
                        </div>
                        <div class="form-group form-check">
                            <input asp-for="Form.bActivo" class="form-check-input" />
                            <label asp-for="Form.bActivo" class="form-check-label">Activa</label>
                        </div>

                        <div class="cq-form-actions">
                            <button type="submit" class="btn btn-primary flex-grow-1"><i class="mdi mdi-content-save mr-1"></i>Guardar</button>
                            <a asp-action="Index" asp-controller="Juntas" asp-route-soloActivas="@Model.SoloActivas" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
    (function () {
        var split     = document.getElementById('cqSplit');
        var btnNuevo  = document.getElementById('btnNuevaJunta');
        var btnCerrar = document.getElementById('btnCerrarPanel');
        var isEditing = @(isEditing ? "true" : "false");
        var cancelUrl = '@Html.Raw(Url.Action("Index", "Juntas", new { soloActivas = Model.SoloActivas }))';
        function openPanel()  { split.classList.add('panel-open'); }
        function closePanel() {
            if (isEditing) { window.location.href = cancelUrl; }
            else { split.classList.remove('panel-open'); }
        }
        if (btnNuevo)  btnNuevo.addEventListener('click', openPanel);
        if (btnCerrar) btnCerrar.addEventListener('click', closePanel);
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && split.classList.contains('panel-open')) closePanel();
        });
    }());
    </script>

    @* Calendario de juntas *@
    <div class="row mt-3">
        <div class="col-12">
            <div class="card">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-2 mb-3">
                        <div>
                            <h4 class="card-title mb-1">Calendario de juntas</h4>
                            <p class="text-muted mb-0">Revisa el mes completo y abre el detalle de cada junta desde el calendario.</p>
                        </div>
                        <span class="badge badge-light">@totalConFecha fecha(s)</span>
                    </div>

                    <div class="cq-cal-legend" aria-label="Leyenda" role="note">
                        <span class="cq-cal-legend__item"><span class="cq-cal-legend__dot" style="background:#d97706;"></span>Junta activa</span>
                        <span class="cq-cal-legend__item"><span class="cq-cal-legend__dot" style="background:#6b7280;"></span>Junta inactiva</span>
                    </div>

                    <div class="cq-cal-wrap">
                        <div id="calendar-juntas"
                             role="application"
                             aria-label="Calendario de juntas del condominio"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Modal detalle junta *@
<div class="modal fade cq-cal-modal" id="calJuntaModal" tabindex="-1"
     aria-labelledby="calJuntaModalLabel" aria-modal="true" role="dialog">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-3">
                    <div class="cq-cal-modal-icon" style="background:rgba(217,119,6,.12);color:#d97706;">
                        <i class="mdi mdi-account-group" aria-hidden="true"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0" id="calJuntaModalLabel" style="font-size:.96rem;font-weight:700;"></h5>
                        <p class="mb-0 mt-1" id="junta-modal-fecha" style="font-size:.74rem;color:var(--cq-muted);font-weight:500;"></p>
                    </div>
                </div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body pt-3" id="junta-modal-body"></div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.14/index.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@@fullcalendar/core@6.1.14/locales/es.global.min.js"></script>
<script>
(function(){
'use strict';
function fmtDate(d){if(!d)return'';return d.toLocaleDateString('es-MX',{weekday:'long',year:'numeric',month:'long',day:'numeric',hour:'2-digit',minute:'2-digit'});}
function row(lbl,val){if(!val||val==='—')return'';return '<div class="cq-cal-detail-row"><span class="cq-cal-detail-label">'+lbl+'</span><span class="cq-cal-detail-val">'+val+'</span></div>';}
function estadoBadge(est,color){return '<span class="cq-cal-estado-badge" style="background:'+color+'22;color:'+color+';">'+est+'</span>';}

document.addEventListener('DOMContentLoaded',function(){
  var events = @Html.Raw(eventsJson);
  var cal = new FullCalendar.Calendar(document.getElementById('calendar-juntas'),{
    initialView: window.innerWidth<640?'listMonth':'dayGridMonth',
    locale:'es', height:'auto', firstDay:1,
    headerToolbar:{left:'prev,next today',center:'title',right:'dayGridMonth,listMonth'},
    buttonText:{today:'Hoy',month:'Mes',list:'Lista'},
    eventTimeFormat:{hour:'2-digit',minute:'2-digit',hour12:false},
    dayMaxEvents:3,
    moreLinkText:function(n){return'+'+n+' más';},
    events:events,
    eventDidMount:function(i){i.el.setAttribute('title',i.event.title);i.el.setAttribute('aria-label',i.event.title);},
    eventClick:function(info){
      var e=info.event, p=e.extendedProps, bg=e.backgroundColor;
      document.getElementById('calJuntaModalLabel').textContent=e.title;
      document.getElementById('junta-modal-fecha').textContent=fmtDate(e.start);
      var body=row('Estado',estadoBadge(p.activo?'Activa':'Inactiva',bg));
      if(p.ubicacion)body+=row('Ubicación',p.ubicacion);
      if(p.descripcion)body+=row('Descripción',p.descripcion);
      document.getElementById('junta-modal-body').innerHTML=body;
      new bootstrap.Modal(document.getElementById('calJuntaModal')).show();
    }
  });
  cal.render();
});
}());
</script>
}

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-account-multiple-check"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Juntas</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge"><i class="mdi mdi-account-multiple-check"></i><strong>@Model.Items.Count</strong></span>
                    <span class="cq-tb-badge"><i class="mdi mdi-check-circle"></i><strong>@Model.TotalActivas</strong> activas</span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <form method="get" asp-action="Index" asp-controller="Juntas"
                  class="cq-tb-filters d-inline-flex align-items-center gap-2" id="frmFiltrosTop">
                <input type="hidden" name="editId" value="" />
                <label class="cq-tb-toggle @(Model.SoloActivas ? "active" : "")">
                    <input type="checkbox" name="soloActivas" value="true"
                           @(Model.SoloActivas ? "checked" : "")
                           onchange="document.getElementById('frmFiltrosTop').submit()" />
                    <i class="mdi mdi-check-circle-outline"></i> Solo activas
                </label>
            </form>
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item active">Juntas</li>
            </ol>
            <button type="button" class="btn btn-primary cq-tb-btn-new" id="btnNuevaJunta">
                <i class="mdi mdi-plus"></i><span>Nuevo</span>
            </button>
        </div>
    </div>
}
