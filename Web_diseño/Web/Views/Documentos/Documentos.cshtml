@model ArchivosPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Documentos";
    var isEditing = Model.Form.ArchivoID.HasValue && Model.Form.ArchivoID.Value > 0;
    var totalPrivados = Model.Items.Count(item => item.EsPrivado);
}

<div class="container-fluid">
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="mdi mdi-alert-circle mr-1"></i>@Model.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card cq-reserva-hero mb-4">
        <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="flex-grow-1">
                <span class="badge badge-pill cq-reserva-pill">Biblioteca interna</span>
                <h3 class="mb-2 mt-2">Ordena documentos con acceso rápido</h3>
                <p class="mb-0">Consulta visibilidad, enlace y edición desde una sola bandeja.</p>
            </div>
            <div class="d-flex flex-wrap gap-2 cq-reserva-stat-strip">
                <div class="cq-reserva-stat"><span>Documentos</span><strong>@Model.Items.Count</strong></div>
                <div class="cq-reserva-stat"><span>Públicos</span><strong>@Model.TotalPublicos</strong></div>
                <div class="cq-reserva-stat"><span>Privados</span><strong>@totalPrivados</strong></div>
            </div>
        </div>
    </div>

    <div class="cq-split @(isEditing ? "panel-open" : "")" id="cqSplit">
        <div class="cq-table-pane">
            <div class="card"><div class="card-body">
                <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-2 mb-3">
                    <div>
                        <h4 class="card-title mb-1">Listado de documentos</h4>
                        <p class="text-muted mb-0">Abre el archivo correcto, valida su visibilidad o corrige su enlace desde aquí.</p>
                    </div>
                    <span class="badge badge-light">@Model.Items.Count registro(s)</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle cq-filterable">
                        <thead>
                            <tr>
                                <th data-type="text">Nombre</th>
                                <th data-type="select">Tipo</th>
                                <th data-type="select">Visibilidad</th>
                                <th data-type="none">Enlace</th>
                                <th data-type="none">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items.Any())
                            {
                                foreach (var item in Model.Items)
                                {
                                    var rowActive = isEditing && Model.Form.ArchivoID == item.ArchivoID;
                                    <tr class="@(rowActive ? "cq-row-active" : "")">
                                        <td><strong>@item.Nombre</strong></td>
                                        <td>@(item.TipoArchivo ?? "—")</td>
                                        <td>
                                            @if (item.EsPrivado)
                                            {
                                                <span class="badge badge-warning">Privado</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-success">Público</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(item.Ruta))
                                            {
                                                <a href="@item.Ruta" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">Abrir</a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Sin enlace</span>
                                            }
                                        </td>
                                        <td class="cq-actions">
                                            <div class="cq-actions-group">
                                                <a cq-btn="edit" asp-action="Index" asp-controller="Documentos"
                                                   asp-route-editId="@item.ArchivoID"
                                                   asp-route-soloPublicos="@Model.SoloPublicos" title="Editar"></a>
                                                <form asp-action="Delete" asp-controller="Documentos" method="post" class="d-inline"
                                                      onsubmit="return confirm('¿Eliminar este documento?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="archivoId" value="@item.ArchivoID" />
                                                    <input type="hidden" name="soloPublicos" value="@Model.SoloPublicos.ToString().ToLower()" />
                                                    <button cq-btn="delete" type="submit" title="Eliminar"></button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5">
                                        <div class="cq-reserva-empty cq-reserva-empty--table">
                                            <div class="cq-reserva-empty-icon"><i class="mdi mdi-file-document-outline"></i></div>
                                            <h5 class="mb-2">Sin documentos cargados</h5>
                                            <p class="text-muted mb-0">Crea el primer documento para empezar a compartir enlaces y archivos del sistema.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div></div>
        </div>
        <div class="cq-form-pane" id="cqFormPane">
            <div class="card @(isEditing ? "cq-card-editing" : "")">
                <div class="cq-panel-header">
                    <div class="cq-panel-icon"><i class="mdi @(isEditing ? "mdi-pencil" : "mdi-plus")"></i></div>
                    <div class="flex-grow-1 min-width-0">
                        <h5 class="mb-0">@(isEditing ? "Editar documento" : "Nuevo documento")</h5>
                        <small class="text-muted">Captura o ajusta el documento sin salir del catálogo.</small>
                    </div>
                    <button type="button" class="cq-close-btn" id="btnCerrarPanel"><i class="mdi mdi-close"></i></button>
                </div>
                <div class="card-body pt-3">
                    <form asp-action="Save" asp-controller="Documentos" method="post" class="m-t-20">
                        @Html.AntiForgeryToken()
                        <input asp-for="Form.ArchivoID" type="hidden" />
                        <input type="hidden" name="soloPublicos" value="@Model.SoloPublicos.ToString().ToLower()" />

                        <div class="form-group">
                            <label asp-for="Form.Nombre">Nombre</label>
                            <input asp-for="Form.Nombre" class="form-control" placeholder="Ej. Reglamento interno 2026" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.Ruta">URL / Ruta</label>
                            <input asp-for="Form.Ruta" class="form-control" placeholder="https://... o /uploads/doc.pdf" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.TipoArchivoID">Tipo (ID)</label>
                            <input asp-for="Form.TipoArchivoID" class="form-control" type="number" />
                        </div>
                        <div class="form-group form-check">
                            <input asp-for="Form.EsPrivado" class="form-check-input" />
                            <label asp-for="Form.EsPrivado" class="form-check-label">Privado (solo admin)</label>
                        </div>

                        <div class="cq-form-actions">
                            <button type="submit" class="btn btn-primary flex-grow-1"><i class="mdi mdi-content-save mr-1"></i>Guardar</button>
                            <a asp-action="Index" asp-controller="Documentos" asp-route-soloPublicos="@Model.SoloPublicos" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
    (function () {
        var split     = document.getElementById('cqSplit');
        var btnNuevo  = document.getElementById('btnNuevoDocumento');
        var btnCerrar = document.getElementById('btnCerrarPanel');
        var isEditing = @(isEditing ? "true" : "false");
        var cancelUrl = '@Html.Raw(Url.Action("Index", "Documentos", new { soloPublicos = Model.SoloPublicos }))';
        function openPanel()  { split.classList.add('panel-open'); }
        function closePanel() {
            if (isEditing) { window.location.href = cancelUrl; }
            else { split.classList.remove('panel-open'); }
        }
        if (btnNuevo)  btnNuevo.addEventListener('click', openPanel);
        if (btnCerrar) btnCerrar.addEventListener('click', closePanel);
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && split.classList.contains('panel-open')) closePanel();
        });
    }());
    </script>
</div>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-file-document"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Documentos</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge"><i class="mdi mdi-file-document"></i><strong>@Model.Items.Count</strong></span>
                    <span class="cq-tb-badge"><i class="mdi mdi-eye"></i><strong>@Model.TotalPublicos</strong> públicos</span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <form method="get" asp-action="Index" asp-controller="Documentos"
                  class="cq-tb-filters d-inline-flex align-items-center gap-2" id="frmFiltrosTop">
                <input type="hidden" name="editId" value="" />
                <label class="cq-tb-toggle @(Model.SoloPublicos ? "active" : "")">
                    <input type="checkbox" name="soloPublicos" value="true"
                           @(Model.SoloPublicos ? "checked" : "")
                           onchange="document.getElementById('frmFiltrosTop').submit()" />
                    <i class="mdi mdi-check-circle-outline"></i> Solo públicos
                </label>
            </form>
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item active">Documentos</li>
            </ol>
            <button type="button" class="btn btn-primary cq-tb-btn-new" id="btnNuevoDocumento">
                <i class="mdi mdi-plus"></i><span>Nuevo</span>
            </button>
        </div>
    </div>
}
