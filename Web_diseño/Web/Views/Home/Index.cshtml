@model Web.Models.Admin.DashboardViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Inicio";
    var displayName = User.Identity?.Name ?? "Invitado";
    var m = Model ?? new Web.Models.Admin.DashboardViewModel();
    var cotoName = CotoContext.GetSelectedCondominioName(User);
    var today = DateTime.Now.ToString("dddd, d 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-MX"));
    today = char.ToUpper(today[0]) + today.Substring(1);
}

<div class="container-fluid cq-dashboard">

    <!-- Welcome bar -->
    <div class="cq-dash-welcome">
        <div>
            <h4 class="cq-dash-greeting mb-0">Hola, <strong>@displayName.Split('@')[0]</strong></h4>
            <span class="cq-dash-sub">
                <i class="mdi mdi-home-city-outline" aria-hidden="true"></i> @cotoName &nbsp;·&nbsp; @today
            </span>
        </div>
        <div class="cq-dash-topactions">
            <a asp-controller="Visitas" asp-action="Index" class="btn btn-primary btn-sm" aria-label="Registrar visita">
                <i class="mdi mdi-account-plus-outline mr-1" aria-hidden="true"></i>Registrar visita
            </a>
            <a asp-controller="PaseQr" asp-action="Index" class="btn btn-outline-primary btn-sm" aria-label="Pase QR">
                <i class="mdi mdi-qrcode mr-1" aria-hidden="true"></i>Pase QR
            </a>
            <a asp-controller="Tickets" asp-action="Index" class="btn btn-outline-secondary btn-sm" aria-label="Tickets">
                <i class="mdi mdi-ticket-outline mr-1" aria-hidden="true"></i>Tickets
            </a>
        </div>
    </div>

    <!-- KPI Fila 1: métricas de alerta -->
    <div class="row cq-kpi-row mt-3">
        <div class="col-lg-3 col-md-6 col-6 mb-3">
            <a asp-controller="CuotasFin" asp-action="Index" class="cq-kpi-card @(m.CuotasPendientes > 0 ? "cq-kpi-danger" : "cq-kpi-ok")" aria-label="@($"{m.CuotasPendientes} cuotas pendientes")">
                <div class="cq-kpi-icon-wrap cq-kpi-icon-danger">
                    <i class="mdi mdi-cash-clock" aria-hidden="true"></i>
                </div>
                <div class="cq-kpi-body">
                    <span class="cq-kpi-num">@m.CuotasPendientes</span>
                    <span class="cq-kpi-lbl">Cuotas pendientes</span>
                </div>
            </a>
        </div>
        <div class="col-lg-3 col-md-6 col-6 mb-3">
            <a asp-controller="Tickets" asp-action="Index" class="cq-kpi-card @(m.TicketsAbiertos > 0 ? "cq-kpi-warning" : "cq-kpi-ok")" aria-label="@($"{m.TicketsAbiertos} tickets abiertos")">
                <div class="cq-kpi-icon-wrap cq-kpi-icon-warning">
                    <i class="mdi mdi-ticket-outline" aria-hidden="true"></i>
                </div>
                <div class="cq-kpi-body">
                    <span class="cq-kpi-num">@m.TicketsAbiertos</span>
                    <span class="cq-kpi-lbl">Tickets abiertos</span>
                </div>
            </a>
        </div>
        <div class="col-lg-3 col-md-6 col-6 mb-3">
            <a asp-controller="Visitas" asp-action="Index" class="cq-kpi-card cq-kpi-info" aria-label="@($"{m.VisitasHoy} visitas hoy")">
                <div class="cq-kpi-icon-wrap cq-kpi-icon-info">
                    <i class="mdi mdi-account-arrow-right-outline" aria-hidden="true"></i>
                </div>
                <div class="cq-kpi-body">
                    <span class="cq-kpi-num">@m.VisitasHoy</span>
                    <span class="cq-kpi-lbl">Visitas hoy</span>
                </div>
            </a>
        </div>
        <div class="col-lg-3 col-md-6 col-6 mb-3">
            <a asp-controller="PaseQr" asp-action="Index" class="cq-kpi-card cq-kpi-info" aria-label="@($"{m.PasesVigentes} pases QR vigentes")">
                <div class="cq-kpi-icon-wrap cq-kpi-icon-info">
                    <i class="mdi mdi-qrcode-scan" aria-hidden="true"></i>
                </div>
                <div class="cq-kpi-body">
                    <span class="cq-kpi-num">@m.PasesVigentes</span>
                    <span class="cq-kpi-lbl">Pases QR vigentes</span>
                </div>
            </a>
        </div>
    </div>

    <!-- KPI Fila 2: métricas informativas -->
    <div class="row cq-kpi-row">
        <div class="col-lg-3 col-md-6 col-6 mb-3">
            <a asp-controller="Condominios" asp-action="Index" class="cq-kpi-card cq-kpi-neutral" aria-label="@($"{m.CondominiosActivos} condominios activos")">
                <div class="cq-kpi-icon-wrap cq-kpi-icon-neutral">
                    <i class="mdi mdi-office-building-outline" aria-hidden="true"></i>
                </div>
                <div class="cq-kpi-body">
                    <span class="cq-kpi-num">@m.CondominiosActivos</span>
                    <span class="cq-kpi-lbl">Condominios activos</span>
                </div>
            </a>
        </div>
        <div class="col-lg-3 col-md-6 col-6 mb-3">
            <a asp-controller="Casas" asp-action="Index" class="cq-kpi-card cq-kpi-neutral" aria-label="@($"{m.CasasActivas} casas activas")">
                <div class="cq-kpi-icon-wrap cq-kpi-icon-neutral">
                    <i class="mdi mdi-home-outline" aria-hidden="true"></i>
                </div>
                <div class="cq-kpi-body">
                    <span class="cq-kpi-num">@m.CasasActivas</span>
                    <span class="cq-kpi-lbl">Casas activas</span>
                </div>
            </a>
        </div>
        <div class="col-lg-3 col-md-6 col-6 mb-3">
            <a asp-controller="ReservasAmenidades" asp-action="Index" class="cq-kpi-card cq-kpi-neutral" aria-label="@($"{m.ReservasProximas} reservas próximas")">
                <div class="cq-kpi-icon-wrap cq-kpi-icon-neutral">
                    <i class="mdi mdi-calendar-clock" aria-hidden="true"></i>
                </div>
                <div class="cq-kpi-body">
                    <span class="cq-kpi-num">@m.ReservasProximas</span>
                    <span class="cq-kpi-lbl">Reservas próximas</span>
                </div>
            </a>
        </div>
        <div class="col-lg-3 col-md-6 col-6 mb-3">
            <a asp-controller="Encuestas" asp-action="Index" class="cq-kpi-card cq-kpi-neutral" aria-label="@($"{m.EncuestasActivas} encuestas activas")">
                <div class="cq-kpi-icon-wrap cq-kpi-icon-neutral">
                    <i class="mdi mdi-poll" aria-hidden="true"></i>
                </div>
                <div class="cq-kpi-body">
                    <span class="cq-kpi-num">@m.EncuestasActivas</span>
                    <span class="cq-kpi-lbl">Encuestas activas</span>
                </div>
            </a>
        </div>
    </div>

    <!-- Accesos rápidos -->
    <div class="row mt-2">
        <div class="col-12 mb-2">
            <span class="cq-section-title">Accesos rápidos</span>
        </div>
        <div class="col-6 col-md-3 col-lg-2 mb-3">
            <a asp-controller="Condominios" asp-action="Index" class="cq-quick-card" aria-label="Condominios">
                <i class="mdi mdi-office-building-outline" aria-hidden="true"></i>
                <span>Condominios</span>
            </a>
        </div>
        <div class="col-6 col-md-3 col-lg-2 mb-3">
            <a asp-controller="Casas" asp-action="Index" class="cq-quick-card" aria-label="Casas">
                <i class="mdi mdi-home-outline" aria-hidden="true"></i>
                <span>Casas</span>
            </a>
        </div>
        <div class="col-6 col-md-3 col-lg-2 mb-3">
            <a asp-controller="Visitas" asp-action="Index" class="cq-quick-card" aria-label="Visitas">
                <i class="mdi mdi-account-group-outline" aria-hidden="true"></i>
                <span>Visitas</span>
            </a>
        </div>
        <div class="col-6 col-md-3 col-lg-2 mb-3">
            <a asp-controller="PaseQr" asp-action="Index" class="cq-quick-card" aria-label="Pases QR">
                <i class="mdi mdi-qrcode" aria-hidden="true"></i>
                <span>Pases QR</span>
            </a>
        </div>
        <div class="col-6 col-md-3 col-lg-2 mb-3">
            <a asp-controller="AreasComunes" asp-action="Index" class="cq-quick-card" aria-label="Áreas comunes">
                <i class="mdi mdi-pool" aria-hidden="true"></i>
                <span>Áreas comunes</span>
            </a>
        </div>
        <div class="col-6 col-md-3 col-lg-2 mb-3">
            <a asp-controller="ReservasAmenidades" asp-action="Index" class="cq-quick-card" aria-label="Reservas">
                <i class="mdi mdi-calendar-check-outline" aria-hidden="true"></i>
                <span>Reservas</span>
            </a>
        </div>
        <div class="col-6 col-md-3 col-lg-2 mb-3">
            <a asp-controller="Tickets" asp-action="Index" class="cq-quick-card" aria-label="Tickets">
                <i class="mdi mdi-ticket-outline" aria-hidden="true"></i>
                <span>Tickets</span>
            </a>
        </div>
        <div class="col-6 col-md-3 col-lg-2 mb-3">
            <a asp-controller="Documentos" asp-action="Index" class="cq-quick-card" aria-label="Documentos">
                <i class="mdi mdi-file-document-outline" aria-hidden="true"></i>
                <span>Documentos</span>
            </a>
        </div>
        <div class="col-6 col-md-3 col-lg-2 mb-3">
            <a asp-controller="Juntas" asp-action="Index" class="cq-quick-card" aria-label="Juntas">
                <i class="mdi mdi-account-voice" aria-hidden="true"></i>
                <span>Juntas</span>
            </a>
        </div>
        <div class="col-6 col-md-3 col-lg-2 mb-3">
            <a asp-controller="Notificaciones" asp-action="Index" class="cq-quick-card" aria-label="Notificaciones">
                <i class="mdi mdi-bell-outline" aria-hidden="true"></i>
                <span>Notificaciones</span>
            </a>
        </div>
        <div class="col-6 col-md-3 col-lg-2 mb-3">
            <a asp-controller="Encuestas" asp-action="Index" class="cq-quick-card" aria-label="Encuestas">
                <i class="mdi mdi-poll" aria-hidden="true"></i>
                <span>Encuestas</span>
            </a>
        </div>
        <div class="col-6 col-md-3 col-lg-2 mb-3">
            <a asp-controller="CuotasFin" asp-action="Index" class="cq-quick-card" aria-label="Finanzas">
                <i class="mdi mdi-bank-outline" aria-hidden="true"></i>
                <span>Finanzas</span>
            </a>
        </div>
        @if (CotoContext.GetIsAdministrador(User))
        {
            <div class="col-6 col-md-3 col-lg-2 mb-3">
                <a asp-controller="SiteThemeAdmin" asp-action="Index" class="cq-quick-card" aria-label="Template del sitio">
                    <i class="mdi mdi-palette-outline" aria-hidden="true"></i>
                    <span>Template sitio</span>
                </a>
            </div>
        }
    </div>

</div>
