@using Web.Models.Login
@model LoginForgotViewModel


                    <form asp-action="ForgotPassword" asp-controller="Login" method="post" class="form-horizontal cq-recover-form" id="recoverform" style="display:none;">
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <div class="col-xs-12">
                                <h3>Recuperar contraseña</h3>
                                <p class="text-muted cq-login-footnote">Ingresa tu correo y te enviaremos un enlace para recuperar el acceso.</p>
                            </div>
                        </div>
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group">
                            <div class="col-xs-12">
                                <label asp-for="EmailForgot" class="cq-login-label"></label>
                                <input asp-for="EmailForgot" class="form-control" placeholder="Correo electrónico" autocomplete="email" />
                                <span asp-validation-for="EmailForgot" class="text-danger"></span>
                            </div>
                        </div>
                         <input type="hidden" asp-for="ReturnUrl" />
                        <div class="form-group text-center m-t-20">
                            <div class="col-xs-12">
                                <button class="btn btn-primary btn-lg btn-block text-uppercase waves-effect waves-light" type="submit">Enviar enlace</button>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-12">
                                <a href="javascript:void(0)" id="to-login" class="text-dark pull-right"><i class="fa fa-lock m-r-5"></i> Volver al acceso</a>
                            </div>
                        </div>
                    </form>
