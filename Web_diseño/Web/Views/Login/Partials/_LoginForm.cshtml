@using Web.Models.Login
@model LoginViewModel

                    <form asp-action="Login" asp-controller="Login" method="post" class="form-horizontal form-material cq-login-form" id="loginform">
                        @Html.AntiForgeryToken()
                        <h3 class="box-title m-b-10">Bienvenido</h3>
                        <p class="text-muted cq-login-footnote">Selecciona el coto y entra con tu usuario o correo.</p>

                        <div class="form-group">
                            <div class="col-xs-12">
                                <label asp-for="CondominioID" class="control-label"></label>
                                <select asp-for="CondominioID" asp-items="Model.CondominioOptions" class="form-control"></select>
                                <small class="text-muted d-block m-t-5">Por defecto inicia en @Model.SelectedCondominioName.</small>
                            </div>
                        </div>

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group">
                            <div class="col-xs-12">
                                <label asp-for="Username" class="cq-login-label"></label>
                                <input asp-for="Username" class="form-control" placeholder="Usuario o correo" autocomplete="username email" autocapitalize="none" autocorrect="off" spellcheck="false" inputmode="email" />
                                <span asp-validation-for="Username" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-xs-12">
                                <label asp-for="Password" class="cq-login-label"></label>
                                <input asp-for="Password" class="form-control" placeholder="Contraseña" autocomplete="current-password" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                        </div>

                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="form-group row">
                            <div class="col-md-12">
                                <a href="javascript:void(0)" id="to-recover" class="text-dark pull-right"><i class="fa fa-lock m-r-5"></i> ¿Olvidaste tu contraseña?</a>
                            </div>
                        </div>

                        <div class="form-group text-center cq-login-meta">
                            <div class="col-xs-12 p-b-20">
                                <button class="btn btn-block btn-lg btn-info btn-rounded" type="submit">Entrar al portal</button>
                            </div>
                        </div>

                        @if (TempData["Msg"] is string msg)
                        {
                            <div class="alert alert-info">@msg</div>
                        }
                    </form>

                   