@using Web.Models.Login
@model ResetPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Restablecer contraseña — Cuarta Quinientos</title>
    <link rel="icon" type="image/png" sizes="16x16" href="~/assets/images/favicon.png" />

    @await Html.PartialAsync("_SiteThemeHead")
    @await Html.PartialAsync("_SiteStyles")
    <link href="~/css/pages/login-register-lock.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="card-no-border cq-login">

<main id="login-main" class="cq-login-shell">
    <section class="cq-login-hero" aria-label="Presentación">
        <div class="cq-login-brand">
            <img src="~/assets/images/logo-icon.png" alt="Cuarta Quinientos Residencial" />
            <span>Cuarta Quinientos Residencial</span>
        </div>
        <h1>Restablecer contraseña</h1>
        <p>Ingresa tu nueva contraseña. Debe tener al menos 6 caracteres.</p>
    </section>

    <section class="cq-login-card card" aria-label="Formulario restablecimiento">
        <div class="card-body">
            <div class="cq-login-card-head">
                <h2>Nueva contraseña</h2>
                <p>Elige una contraseña segura que no hayas usado antes.</p>
            </div>

            <form asp-action="ResetPassword" asp-controller="Login" method="post" class="form-horizontal">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Token" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="form-group">
                    <label>Nueva contraseña</label>
                    <div class="input-group">
                        <input asp-for="PasswordNuevo" type="password" class="form-control"
                               placeholder="Mínimo 6 caracteres" autocomplete="new-password"
                               id="pwdNuevo" />
                        <div class="input-group-append">
                            <button type="button" class="btn btn-outline-secondary" id="btnTogglePwd" tabindex="-1"
                                    title="Mostrar/ocultar">
                                <i class="mdi mdi-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                    </div>
                    <span asp-validation-for="PasswordNuevo" class="text-danger small"></span>
                </div>

                <div class="form-group">
                    <label>Confirmar contraseña</label>
                    <input asp-for="PasswordConfirmar" type="password" class="form-control"
                           placeholder="Repite la contraseña" autocomplete="new-password" />
                    <span asp-validation-for="PasswordConfirmar" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-block btn-lg">
                    Guardar nueva contraseña
                </button>
            </form>

            <div class="text-center mt-3">
                <a asp-action="Login" asp-controller="Login" class="text-muted small">
                    <i class="mdi mdi-arrow-left mr-1"></i>Volver al inicio de sesión
                </a>
            </div>
        </div>
    </section>
</main>

<script src="~/assets/plugins/jquery/jquery.min.js"></script>
<script>
    $('#btnTogglePwd').on('click', function () {
        var inp = $('#pwdNuevo');
        var isPass = inp.attr('type') === 'password';
        inp.attr('type', isPass ? 'text' : 'password');
        $('#eyeIcon').toggleClass('mdi-eye mdi-eye-off');
    });
</script>
</body>
</html>
