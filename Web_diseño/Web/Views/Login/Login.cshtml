@using Web.Models.Login
@model LoginViewModel
@{
    Layout = null; // pantalla full, sin _Layout
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/assets/images/favicon.png" />
    <title>Cuarta Quinientos Residencial - Acceso</title>

    @await Html.PartialAsync("_SiteThemeHead")
    @await Html.PartialAsync("_SiteStyles")
    <link href="~/css/pages/login-register-lock.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="card-no-border cq-login">
    <a class="cq-skip-link" href="#login-main">Saltar al contenido</a>
    <div class="preloader">
        <div class="loader">
            <div class="loader__figure"></div>
            <p class="loader__label">Cuarta Quinientos Residencial</p>
        </div>
    </div>

    <main id="login-main" class="cq-login-shell">
        <section class="cq-login-hero" aria-label="Presentación del portal">
            <div class="cq-login-brand">
                <img src="~/assets/images/logo-icon.png" alt="Cuarta Quinientos Residencial" />
                <span>Cuarta Quinientos Residencial</span>
            </div>
            <h1>Acceso, visitas y servicios en una sola plataforma.</h1>
            <p>Selecciona el coto correcto antes de entrar. El sistema abre por defecto en @Model.SelectedCondominioName.</p>
            <ul class="cq-login-points">
                <li>Entra con el coto correcto desde el inicio.</li>
                <li>Recupera tu acceso sin salir del flujo.</li>
                <li>Diseño claro en escritorio y móvil.</li>
            </ul>
        </section>

        <section class="cq-login-card card" aria-label="Formulario de acceso">
            <div class="card-body">
                <div class="cq-login-card-head">
                    <h2>Iniciar sesión</h2>
                    <p>Ingresa con tus credenciales para entrar al portal.</p>
                </div>

                @await Html.PartialAsync("Partials/_LoginForm", Model ?? new Web.Models.Login.LoginViewModel())

                <div class="cq-login-divider">o</div>

                @await Html.PartialAsync("Partials/_ForgotPasswordForm", new Web.Models.Login.LoginForgotViewModel { ReturnUrl = Model?.ReturnUrl })
            </div>
        </section>
    </main>

    <script src="~/assets/plugins/jquery/jquery.min.js"></script>
    <script src="~/assets/plugins/bootstrap/js/popper.min.js"></script>
    <script src="~/assets/plugins/bootstrap/js/bootstrap.min.js"></script>
    <!--Custom JavaScript -->
    <script type="text/javascript">
        $(function() {
            $(".preloader").fadeOut();
        });
        $(function() {
            $('[data-toggle="tooltip"]').tooltip()
        });

        $('#to-recover').on("click", function() {
            $("#loginform").slideUp();
            $("#recoverform").fadeIn();
        });

         $('#to-login').on("click", function() {
            $("#recoverform").slideUp();
            $("#loginform").fadeIn();
        });
    </script>
</body>
</html>
