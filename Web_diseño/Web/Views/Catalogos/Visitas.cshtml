@model VisitasPageViewModel
@using Web.Models.Admin
@{
    Layout = "_Layout";
    ViewData["Title"] = "Visitas";
    var isEditing = Model.Form.VisitaID.HasValue && Model.Form.VisitaID.Value > 0;
    var totalVisitas = Model.Items.Count;
    var totalAutorizadas = Model.Items.Count(item => item.Autorizado && !item.bEliminado);
    var totalConDocumento = Model.Items.Count(item => !string.IsNullOrWhiteSpace(item.RutaDocumento));
}

<div class="container-fluid">

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="mdi mdi-alert-circle mr-1"></i>@Model.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card cq-reserva-hero mb-4">
        <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="flex-grow-1">
                <span class="badge badge-pill cq-reserva-pill">Control de visitas</span>
                <h3 class="mb-2 mt-2">Gestiona accesos con menos pasos</h3>
                <p class="mb-0">Consulta el listado, abre una ficha y guarda documentos desde una sola vista.</p>
            </div>
            <div class="d-flex flex-wrap gap-2 cq-reserva-stat-strip">
                <div class="cq-reserva-stat"><span>Visitas</span><strong>@totalVisitas</strong></div>
                <div class="cq-reserva-stat"><span>Autorizadas</span><strong>@totalAutorizadas</strong></div>
                <div class="cq-reserva-stat"><span>Con archivo</span><strong>@totalConDocumento</strong></div>
            </div>
        </div>
    </div>

    <div class="cq-split @(isEditing ? "panel-open" : "")" id="cqSplit">
        <div class="cq-table-pane">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-2 mb-3">
                        <div>
                            <h4 class="card-title mb-1">Listado de visitas</h4>
                            <p class="text-muted mb-0">Edita, elimina o abre la ficha correcta desde el mismo tablero.</p>
                        </div>
                        <span class="badge badge-light">@totalVisitas registro(s)</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle cq-filterable">
                            <thead>
                                <tr>
                                    <th data-type="text">Visitante</th>
                                    <th data-type="text">Usuario visitado</th>
                                    <th data-type="text">Casa</th>
                                    <th data-type="select">Identificación</th>
                                    <th data-type="date">Entrada</th>
                                    <th data-type="date">Salida</th>
                                    <th data-type="none">Documento</th>
                                    <th data-type="select">Estado</th>
                                    <th data-type="none">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Items.Any())
                                {
                                    <tr>
                                        <td colspan="9">
                                            <div class="cq-reserva-empty cq-reserva-empty--table">
                                                <div class="cq-reserva-empty-icon"><i class="mdi mdi-account-clock-outline"></i></div>
                                                <h5 class="mb-2">Sin visitas visibles</h5>
                                                <p class="text-muted mb-0">Abre una ficha nueva para registrar la primera visita.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model.Items)
                                    {
                                        var rowActive = isEditing && Model.Form.VisitaID == item.VisitaID;
                                        <tr class="@(rowActive ? "cq-row-active" : "")">
                                            <td>@item.VisitanteNombre</td>
                                            <td>
                                                <strong>@(string.IsNullOrWhiteSpace(item.UsuarioVisitadoNombre) ? "Sin usuario" : item.UsuarioVisitadoNombre)</strong>
                                            </td>
                                            <td>
                                                <strong>@(string.IsNullOrWhiteSpace(item.CasaDescripcion) ? "Sin casa" : item.CasaDescripcion)</strong>
                                            </td>
                                            <td>@(string.IsNullOrWhiteSpace(item.TipoIdentificacionNombre) ? "Sin tipo" : item.TipoIdentificacionNombre)</td>
                                            <td>@(item.FechaEntrada == default ? string.Empty : item.FechaEntrada.ToString("dd/MM/yyyy HH:mm"))</td>
                                            <td>@(item.FechaSalida.HasValue ? item.FechaSalida.Value.ToString("dd/MM/yyyy HH:mm") : string.Empty)</td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(item.RutaDocumento))
                                                {
                                                    <a cq-btn="file" href="@Url.Content("~/" + item.RutaDocumento)" target="_blank" rel="noopener noreferrer" title="Ver documento"></a>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-light">Sin archivo</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge @item.EstadoTemporalClase">@item.EstadoTemporal</span>
                                                @if (!item.bEliminado && item.Autorizado)
                                                {
                                                    <span class="badge badge-success ms-1">Autorizada</span>
                                                }
                                            </td>
                                            <td class="cq-actions">
                                                <div class="cq-actions-group">
                                                    <a cq-btn="edit" asp-action="Index" asp-route-editId="@item.VisitaID" asp-route-soloProximas="@Model.SoloProximas" title="Editar"></a>
                                                    <form asp-action="Delete" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="visitaId" value="@item.VisitaID" />
                                                        <button cq-btn="delete" type="submit" title="Eliminar" onclick="return confirm('¿Eliminar la visita?');"></button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="cq-form-pane" id="cqFormPane">
            <div class="card @(isEditing ? "cq-card-editing" : "")">
                <div class="cq-panel-header">
                    <div class="cq-panel-icon"><i class="mdi @(isEditing ? "mdi-pencil" : "mdi-plus")"></i></div>
                    <div class="flex-grow-1 min-width-0">
                        <h5 class="mb-0">@(isEditing ? "Editar visita" : "Nueva visita")</h5>
                        <small class="text-muted">Captura o ajusta la visita en esta misma vista.</small>
                    </div>
                    <button type="button" class="cq-close-btn" id="btnCerrarPanel"><i class="mdi mdi-close"></i></button>
                </div>
                <div class="card-body pt-3">
                    <form asp-action="Save" method="post" enctype="multipart/form-data" class="m-t-20">
                        @Html.AntiForgeryToken()
                        <input asp-for="Form.VisitaID" type="hidden" />
                        <input asp-for="Form.RutaDocumento" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group">
                            <label asp-for="Form.VisitanteNombre"></label>
                            <input asp-for="Form.VisitanteNombre" class="form-control" />
                            <span asp-validation-for="Form.VisitanteNombre" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.UsuarioVisitadoID"></label>
                            <select asp-for="Form.UsuarioVisitadoID" asp-items="Model.UsuarioOptions" class="form-control">
                                <option value="">Seleccione un usuario</option>
                            </select>
                            <span asp-validation-for="Form.UsuarioVisitadoID" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.CasaID"></label>
                            <select asp-for="Form.CasaID" asp-items="Model.CasaOptions" class="form-control">
                                <option value="">Sin casa asignada</option>
                            </select>
                            <span asp-validation-for="Form.CasaID" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.TipoIdentificacionID"></label>
                            <select asp-for="Form.TipoIdentificacionID" asp-items="Model.TipoIdentificacionOptions" class="form-control">
                                <option value="">Seleccione un tipo</option>
                            </select>
                            <span asp-validation-for="Form.TipoIdentificacionID" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.NumeroIdentificacion"></label>
                            <input asp-for="Form.NumeroIdentificacion" class="form-control" />
                            <span asp-validation-for="Form.NumeroIdentificacion" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.DocumentoArchivo"></label>
                            @if (!string.IsNullOrWhiteSpace(Model.Form.RutaDocumento))
                            {
                                <div class="alert alert-info cq-ticket-alert">
                                    Documento actual:
                                    <a href="@Url.Content("~/" + Model.Form.RutaDocumento)" target="_blank" rel="noopener noreferrer">@Model.Form.RutaDocumento</a>
                                </div>
                            }
                            <input asp-for="Form.DocumentoArchivo" type="file" class="form-control" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" />
                            <small class="text-muted d-block mt-2">Si no eliges uno nuevo, se conserva el archivo actual.</small>
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.FechaEntrada"></label>
                            <input asp-for="Form.FechaEntrada" class="form-control" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                            <span asp-validation-for="Form.FechaEntrada" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.FechaSalida"></label>
                            <input asp-for="Form.FechaSalida" class="form-control" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                        </div>
                        <div class="form-group form-check">
                            <input asp-for="Form.Autorizado" class="form-check-input" />
                            <label asp-for="Form.Autorizado" class="form-check-label"></label>
                        </div>
                        <div class="form-group form-check">
                            <input asp-for="Form.bEliminado" class="form-check-input" />
                            <label asp-for="Form.bEliminado" class="form-check-label"></label>
                        </div>

                        <div class="cq-form-actions">
                            <button type="submit" class="btn btn-primary flex-grow-1"><i class="mdi mdi-content-save mr-1"></i>Guardar</button>
                            <a asp-action="Index" asp-route-soloProximas="@Model.SoloProximas" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var split     = document.getElementById('cqSplit');
    var btnNuevo  = document.getElementById('btnNuevaVisita');
    var btnCerrar = document.getElementById('btnCerrarPanel');
    var isEditing = @(isEditing ? "true" : "false");
    var cancelUrl = '@Html.Raw(Url.Action("Index", "Visitas", new { soloProximas = Model.SoloProximas }))';
    function openPanel()  { split.classList.add('panel-open'); }
    function closePanel() {
        if (isEditing) { window.location.href = cancelUrl; }
        else { split.classList.remove('panel-open'); }
    }
    if (btnNuevo)  btnNuevo.addEventListener('click', openPanel);
    if (btnCerrar) btnCerrar.addEventListener('click', closePanel);
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && split.classList.contains('panel-open')) closePanel();
    });
}());
</script>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-account-group"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Visitas</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge"><i class="mdi mdi-account-group"></i><strong>@Model.Items.Count</strong></span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <form method="get" asp-action="Index" asp-controller="Visitas" class="cq-tb-filters d-inline-flex align-items-center gap-2" id="frmFiltrosTop">
                <input type="hidden" name="editId" value="" />
                <label class="cq-tb-toggle @(Model.SoloProximas ? "active" : "")">
                    <input type="checkbox" name="soloProximas" value="true"
                           @(Model.SoloProximas ? "checked" : "")
                           onchange="document.getElementById('frmFiltrosTop').submit()" />
                    <i class="mdi mdi-check-circle-outline"></i> Solo próximas
                </label>
            </form>
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item active">Visitas</li>
            </ol>
            <button type="button" class="btn btn-primary cq-tb-btn-new" id="btnNuevaVisita">
                <i class="mdi mdi-plus"></i><span>Nuevo</span>
            </button>
        </div>
    </div>
}
