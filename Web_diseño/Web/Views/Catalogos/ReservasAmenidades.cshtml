                    <span class="cq-tb-dot"></span>
                    <span class="cq-tb-badge cq-tb-green"><i class="mdi mdi-domain"></i><strong>@Model.TotalAmenidades</strong> amenidades</span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
