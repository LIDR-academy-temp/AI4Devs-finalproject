@model Web.Models.Admin.PaseQrPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Pase QR";
    var isEdit = Model.Form.VisitaGeneradaID.HasValue;
    var fechaEmisionValue = Model.Form.FechaEmision ?? DateTime.Now;
    var fechaExpiraValue = Model.Form.FechaExpira ?? fechaEmisionValue.AddMinutes(Model.Form.DuracionMinutos > 0 ? Model.Form.DuracionMinutos : 240);
}

<div class="container-fluid">

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="mdi mdi-alert-circle mr-1"></i>@Model.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card cq-reserva-hero mb-4">
        <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="flex-grow-1">
                <span class="badge badge-pill cq-reserva-pill">Acceso QR</span>
                <h3 class="mb-2 mt-2">Genera y comparte pases al momento</h3>
                <p class="mb-0">Ajusta la duración, revisa el enlace y compártelo desde la misma pantalla.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Validar" class="btn btn-light">Validar un pase</a>
                <a asp-controller="Visitas" asp-action="Index" class="btn btn-outline-secondary">Ir a visitas</a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-7">
            <div class="card cq-qr-panel">
                <div class="card-body">
                    <form asp-action="Save" method="post" class="cq-qr-form" id="qrForm">
                        @Html.AntiForgeryToken()
                        <input asp-for="Form.VisitaGeneradaID" type="hidden" />
                        <input asp-for="Form.CodigoQR" type="hidden" />
                        <input asp-for="Form.bUsado" type="hidden" />
                        <input asp-for="Form.bEliminado" type="hidden" />
                        <input asp-for="Form.DuracionMinutos" type="hidden" id="DuracionMinutos" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="Form.NombreVisitante"></label>
                                    <input asp-for="Form.NombreVisitante" class="form-control" placeholder="Nombre completo del visitante" />
                                    <span asp-validation-for="Form.NombreVisitante" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="Form.UsuarioVisitadoID"></label>
                                    <select asp-for="Form.UsuarioVisitadoID" asp-items="Model.UsuarioOptions" class="form-control">
                                        <option value="">Selecciona un vecino</option>
                                    </select>
                                    <span asp-validation-for="Form.UsuarioVisitadoID" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="Form.CasaID"></label>
                                    <select asp-for="Form.CasaID" asp-items="Model.CasaOptions" class="form-control">
                                        <option value="">Sin casa asignada</option>
                                    </select>
                                    <span asp-validation-for="Form.CasaID" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="Form.TipoIdentificacionID"></label>
                                    <select asp-for="Form.TipoIdentificacionID" asp-items="Model.TipoIdentificacionOptions" class="form-control">
                                        <option value="">Selecciona una identificación</option>
                                    </select>
                                    <span asp-validation-for="Form.TipoIdentificacionID" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="Form.NumeroIdentificacion"></label>
                                    <input asp-for="Form.NumeroIdentificacion" class="form-control" placeholder="Documento o número de identificación" />
                                    <span asp-validation-for="Form.NumeroIdentificacion" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="Form.RutaDocumento"></label>
                                    <input asp-for="Form.RutaDocumento" class="form-control" placeholder="Opcional: foto o PDF del documento" />
                                    <span asp-validation-for="Form.RutaDocumento" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="cq-qr-duration-box">
                            <div class="d-flex flex-column flex-lg-row justify-content-between gap-2 align-items-lg-center">
                                <div>
                                    <h5 class="mb-1">Duración rápida</h5>
                                    <p class="text-muted mb-0">Elige un tiempo estándar o ajusta fechas manualmente.</p>
                                </div>
                                <div class="cq-qr-duration-toolbar">
                                    <button type="button" class="btn btn-light cq-duration-btn" data-minutes="60">1 h</button>
                                    <button type="button" class="btn btn-light cq-duration-btn is-active" data-minutes="240">4 h</button>
                                    <button type="button" class="btn btn-light cq-duration-btn" data-minutes="480">8 h</button>
                                    <button type="button" class="btn btn-light cq-duration-btn" data-minutes="1440">24 h</button>
                                    <button type="button" class="btn btn-light cq-duration-btn" data-minutes="10080">7 días</button>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="Form.FechaEmision"></label>
                                    <input asp-for="Form.FechaEmision" type="datetime-local" class="form-control" id="FechaEmision" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                                    <span asp-validation-for="Form.FechaEmision" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="Form.FechaExpira"></label>
                                    <input asp-for="Form.FechaExpira" type="datetime-local" class="form-control" id="FechaExpira" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                                    <span asp-validation-for="Form.FechaExpira" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <button type="submit" class="btn btn-info">@(isEdit ? "Actualizar pase" : "Generar pase")</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-xl-5">
            <div class="card cq-qr-preview">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between gap-2">
                        <div>
                            <h5 class="card-title mb-1">Pase listo</h5>
                            <p class="text-muted mb-0">El QR real aparece al guardar el pase.</p>
                        </div>
                        <span class="badge @Model.Form.EstadoClase">@Model.Form.EstadoTexto</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Form.QrImageDataUrl))
                    {
                        <div class="cq-qr-code-wrap mt-4 text-center">
                            <img src="@Model.Form.QrImageDataUrl" alt="Código QR del pase" class="cq-qr-code-image" />
                        </div>

                        <div class="mt-4">
                            <h5 class="mb-2">@Model.Form.NombreVisitante</h5>
                            <p class="text-muted mb-2">@Model.Form.NombreVisitado</p>
                            <div class="cq-qr-meta-grid">
                                <div>
                                    <small class="text-muted d-block">Emitido</small>
                                    <strong>@fechaEmisionValue.ToString("dd/MM/yyyy HH:mm")</strong>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Casa</small>
                                    <strong>@(string.IsNullOrWhiteSpace(Model.Form.DireccionCasa) ? "Sin asignar" : $"{Model.Form.DireccionCasa} {Model.Form.NumeroExtCasa}".Trim())</strong>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Vence</small>
                                    <strong>@fechaExpiraValue.ToString("dd/MM/yyyy HH:mm")</strong>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Estado</small>
                                    <strong>@Model.Form.EstadoTexto</strong>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Código</small>
                                    <strong>@Model.Form.CodigoQR</strong>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mt-4">
                                <a href="@Model.Form.ValidationUrl" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Abrir validación</a>
                                <a href="@Model.Form.WhatsAppUrl" target="_blank" rel="noopener noreferrer" class="btn btn-success">Compartir por WhatsApp</a>
                                <button type="button" class="btn btn-outline-secondary cq-copy-link" data-copy-text="@Model.Form.ValidationUrl">Copiar enlace</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="cq-qr-empty mt-4">
                            <div class="cq-qr-empty-icon"><i class="mdi mdi-qrcode-scan"></i></div>
                            <h6>El QR aparecerá aquí después de guardar.</h6>
                            <p class="text-muted mb-0">Completa los datos, guarda el pase y compártelo desde aquí.</p>
                        </div>
                    }
                </div>
            </div>

            <div class="card cq-qr-tips mt-3">
                <div class="card-body">
                    <h5 class="card-title mb-3">Qué resuelve este pase</h5>
                    <ul class="cq-qr-checklist mb-0">
                        <li>La duración rápida cambia el vencimiento sin capturar fechas a mano.</li>
                        <li>El enlace de validación puede enviarse por WhatsApp de inmediato.</li>
                        <li>La validación indica si el pase está vigente, usado, vencido o eliminado.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card cq-qr-list">
                <div class="card-body">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                        <div>
                            <h5 class="card-title mb-1">Pases recientes</h5>
                            <p class="text-muted mb-0">Consulta, edita o elimina los últimos pases generados.</p>
                        </div>
                        <span class="badge badge-pill">@Model.Items.Count registros</span>
                    </div>

                    <form method="get" asp-action="Index" asp-controller="PaseQr" class="d-flex flex-wrap align-items-center gap-3 mt-3 mb-2">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" name="soloVigentes" value="true"
                                   id="chkVigentes" @(Model.SoloVigentes ? "checked" : "") onchange="this.form.submit()" />
                            <label class="form-check-label" for="chkVigentes">Solo vigentes</label>
                        </div>
                        <small class="text-muted">
                            @Model.Items.Count mostrado(s) &mdash;
                            <span class="text-success font-weight-bold">@Model.TotalVigentes vigente(s)</span>
                            @if (Model.TotalUsados > 0) { <span class="text-muted">&mdash; @Model.TotalUsados usado(s)</span> }
                        </small>
                    </form>

                    <div class="table-responsive mt-3">
                        <table class="table table-hover cq-qr-table">
                            <thead>
                                <tr>
                                    <th>Visitante</th>
                                    <th>Vecino</th>
                                    <th>Casa</th>
                                    <th>Vence</th>
                                    <th>Estado</th>
                                    <th class="text-right">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Items.Any())
                                {
                                    foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@item.NombreVisitante</strong>
                                                <div class="text-muted small">@item.TipoIdentificacion - @item.NumeroIdentificacion</div>
                                            </td>
                                            <td>
                                                <strong>@item.NombreVisitado</strong>
                                                <div class="text-muted small">@item.CorreoVisitado</div>
                                            </td>
                                            <td>
                                                <strong>@(string.IsNullOrWhiteSpace(item.DireccionCasa) ? "Sin casa" : $"{item.DireccionCasa} {item.NumeroExtCasa}".Trim())</strong>
                                            </td>
                                            <td>
                                                @if (item.FechaExpira.HasValue)
                                                {
                                                    <span>@item.FechaExpira.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                                }
                                                else
                                                {
                                                    <span>Sin fecha</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge @item.EstadoClase">@item.EstadoTexto</span>
                                            </td>
                                            <td class="text-right">
                                                <div class="d-flex justify-content-end flex-wrap gap-2 cq-qr-table-actions">
                                                    @if (!string.IsNullOrWhiteSpace(item.ValidationUrl))
                                                    {
                                                        <a href="@item.ValidationUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary">Validar</a>
                                                    }

                                                    @if (!string.IsNullOrWhiteSpace(item.WhatsAppUrl))
                                                    {
                                                        <a href="@item.WhatsAppUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-success">WhatsApp</a>
                                                    }

                                                    <a asp-action="Index" asp-route-editId="@item.VisitaGeneradaID" asp-route-soloVigentes="@Model.SoloVigentes" class="btn btn-sm btn-light">Editar</a>

                                                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar este pase QR?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="paseQrId" value="@item.VisitaGeneradaID" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6">
                                            <div class="cq-qr-empty cq-qr-empty--table py-4">
                                                <div class="cq-qr-empty-icon"><i class="mdi mdi-qrcode-scan"></i></div>
                                                <h6 class="mb-2">Todavía no has generado pases.</h6>
                                                <p class="text-muted mb-0">Crea el primer pase desde el formulario superior para verlo aquí.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var durationButtons = document.querySelectorAll('.cq-duration-btn');
        var durationField = document.getElementById('DuracionMinutos');
        var emissionField = document.getElementById('FechaEmision');
        var expirationField = document.getElementById('FechaExpira');
        var copyButtons = document.querySelectorAll('.cq-copy-link');

        function pad(value) {
            return String(value).padStart(2, '0');
        }

        function toInputValue(date) {
            return [
                date.getFullYear(),
                '-',
                pad(date.getMonth() + 1),
                '-',
                pad(date.getDate()),
                'T',
                pad(date.getHours()),
                ':',
                pad(date.getMinutes())
            ].join('');
        }

        function parseInputValue(value) {
            return value ? new Date(value) : new Date();
        }

        function applyDuration(minutes) {
            if (!durationField || !emissionField || !expirationField) {
                return;
            }

            var emission = parseInputValue(emissionField.value);
            var expiration = new Date(emission.getTime() + (minutes * 60000));
            durationField.value = minutes;
            expirationField.value = toInputValue(expiration);

            durationButtons.forEach(function (button) {
                button.classList.toggle('is-active', Number(button.dataset.minutes) === Number(minutes));
            });
        }

        function syncActiveButton(minutes) {
            durationButtons.forEach(function (button) {
                button.classList.toggle('is-active', Number(button.dataset.minutes) === Number(minutes));
            });
        }

        durationButtons.forEach(function (button) {
            button.addEventListener('click', function () {
                applyDuration(Number(button.dataset.minutes || 240));
            });
        });

        if (emissionField && expirationField && durationField) {
            var currentMinutes = Number(durationField.value || 240);

            syncActiveButton(currentMinutes);

            if (!durationButtons.length) {
                durationField.value = currentMinutes;
            }

            if (!expirationField.value) {
                applyDuration(currentMinutes);
            }

            emissionField.addEventListener('change', function () {
                applyDuration(Number(durationField.value || currentMinutes));
            });
        }

        copyButtons.forEach(function (button) {
            button.addEventListener('click', async function () {
                var text = button.dataset.copyText || '';

                if (!text || !navigator.clipboard) {
                    return;
                }

                await navigator.clipboard.writeText(text);
                var originalText = button.innerText;
                button.innerText = 'Copiado';
                window.setTimeout(function () {
                    button.innerText = originalText;
                }, 1500);
            });
        });
    })();
</script>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-qrcode"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Pase QR</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge">Genera y comparte accesos por QR</span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item active">Pase QR</li>
            </ol>
        </div>
    </div>
}