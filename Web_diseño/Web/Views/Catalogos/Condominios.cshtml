@model CondominiosPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Condominios";
    var isEditing = Model.Form.CondominioID.HasValue && Model.Form.CondominioID.Value > 0;
    var totalConDireccion = Model.Items.Count(item => !string.IsNullOrWhiteSpace(item.DireccionCondominio));
}

<div class="container-fluid">

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="mdi mdi-alert-circle mr-1"></i>@Model.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card cq-reserva-hero mb-4">
        <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="flex-grow-1">
                <span class="badge badge-pill cq-reserva-pill">Configuración principal</span>
                <h3 class="mb-2 mt-2">Ordena condominios con vista clara</h3>
                <p class="mb-0">Consulta estado, dirección y acceso a casas desde una sola bandeja.</p>
            </div>
            <div class="d-flex flex-wrap gap-2 cq-reserva-stat-strip">
                <div class="cq-reserva-stat"><span>Condominios</span><strong>@Model.Items.Count</strong></div>
                <div class="cq-reserva-stat"><span>Activos</span><strong>@Model.TotalActivos</strong></div>
                <div class="cq-reserva-stat"><span>Con dirección</span><strong>@totalConDireccion</strong></div>
            </div>
        </div>
    </div>

    <div class="cq-split @(isEditing ? "panel-open" : "")" id="cqSplit">
        <div class="cq-table-pane">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-2 mb-3">
                        <div>
                            <h4 class="card-title mb-1">Listado de condominios</h4>
                            <p class="text-muted mb-0">Edita el catálogo o entra a las casas del conjunto correcto desde aquí.</p>
                        </div>
                        <span class="badge badge-light">@Model.Items.Count registro(s)</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle cq-filterable">
                            <thead>
                                <tr>
                                    <th data-type="text">Condominio</th>
                                    <th data-type="text">Dirección</th>
                                    <th data-type="select">Estado</th>
                                    <th data-type="none">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Items.Any())
                                {
                                    <tr>
                                        <td colspan="4">
                                            <div class="cq-reserva-empty cq-reserva-empty--table">
                                                <div class="cq-reserva-empty-icon"><i class="mdi mdi-city-variant-outline"></i></div>
                                                <h5 class="mb-2">Sin condominios cargados</h5>
                                                <p class="text-muted mb-0">Crea el primer condominio para habilitar casas, accesos y catálogos relacionados.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model.Items)
                                    {
                                        var rowActive = isEditing && Model.Form.CondominioID == item.CondominioID;
                                        <tr class="@(rowActive ? "cq-row-active" : "")">
                                            <td><strong>@item.NombreCondominio</strong></td>
                                            <td>@item.DireccionCondominio</td>
                                            <td>
                                                <span class="badge @(item.bEliminado == true ? "badge-danger" : "badge-success")">
                                                    @(item.bEliminado == true ? "Eliminado" : "Activo")
                                                </span>
                                            </td>
                                            <td class="cq-actions">
                                                <div class="cq-actions-group">
                                                    <a cq-btn="edit" asp-action="Index" asp-route-editId="@item.CondominioID" asp-route-soloActivos="@Model.SoloActivos" title="Editar"></a>
                                                    <a cq-btn="view" cq-icon="home-variant" asp-controller="Casas" asp-action="Index" asp-route-filtroCondominioId="@item.CondominioID" title="Ver casas"></a>
                                                    <form asp-action="Delete" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="condominioId" value="@item.CondominioID" />
                                                        <button cq-btn="delete" type="submit" title="Eliminar" onclick="return confirm('¿Eliminar el condominio?');"></button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="cq-form-pane" id="cqFormPane">
            <div class="card @(isEditing ? "cq-card-editing" : "")">
                <div class="cq-panel-header">
                    <div class="cq-panel-icon"><i class="mdi @(isEditing ? "mdi-pencil" : "mdi-plus")"></i></div>
                    <div class="flex-grow-1 min-width-0">
                        <h5 class="mb-0">@(isEditing ? "Editar condominio" : "Nuevo condominio")</h5>
                        <small class="text-muted">Captura o ajusta el condominio sin salir del catálogo.</small>
                    </div>
                    <button type="button" class="cq-close-btn" id="btnCerrarPanel"><i class="mdi mdi-close"></i></button>
                </div>
                <div class="card-body pt-3">
                    <form asp-action="Save" method="post" class="m-t-20">
                        @Html.AntiForgeryToken()
                        <input asp-for="Form.CondominioID" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group">
                            <label asp-for="Form.NombreCondominio"></label>
                            <input asp-for="Form.NombreCondominio" class="form-control" />
                            <span asp-validation-for="Form.NombreCondominio" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Form.DireccionCondominio"></label>
                            <input asp-for="Form.DireccionCondominio" class="form-control" />
                            <span asp-validation-for="Form.DireccionCondominio" class="text-danger"></span>
                        </div>

                        <div class="form-group form-check">
                            <input asp-for="Form.bEliminado" class="form-check-input" />
                            <label asp-for="Form.bEliminado" class="form-check-label"></label>
                        </div>

                        <div class="cq-form-actions">
                            <button type="submit" class="btn btn-primary flex-grow-1"><i class="mdi mdi-content-save mr-1"></i>Guardar</button>
                            <a asp-action="Index" asp-route-soloActivos="@Model.SoloActivos" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var split     = document.getElementById('cqSplit');
    var btnNuevo  = document.getElementById('btnNuevoCondominio');
    var btnCerrar = document.getElementById('btnCerrarPanel');
    var isEditing = @(isEditing ? "true" : "false");
    var cancelUrl = '@Html.Raw(Url.Action("Index", "Condominios", new { soloActivos = Model.SoloActivos }))';
    function openPanel()  { split.classList.add('panel-open'); }
    function closePanel() {
        if (isEditing) { window.location.href = cancelUrl; }
        else { split.classList.remove('panel-open'); }
    }
    if (btnNuevo)  btnNuevo.addEventListener('click', openPanel);
    if (btnCerrar) btnCerrar.addEventListener('click', closePanel);
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && split.classList.contains('panel-open')) closePanel();
    });
}());
</script>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-city"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Condominios</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge"><i class="mdi mdi-city"></i><strong>@Model.Items.Count</strong></span>
                    <span class="cq-tb-dot"></span>
                    <span class="cq-tb-badge cq-tb-green"><i class="mdi mdi-check-circle-outline"></i><strong>@Model.TotalActivos</strong> activos</span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <form method="get" asp-action="Index" asp-controller="Condominios" class="cq-tb-filters d-inline-flex align-items-center gap-2" id="frmFiltrosTop">
                <input type="hidden" name="editId" value="" />
                <label class="cq-tb-toggle @(Model.SoloActivos ? "active" : "")">
                    <input type="checkbox" name="soloActivos" value="true"
                           @(Model.SoloActivos ? "checked" : "")
                           onchange="document.getElementById('frmFiltrosTop').submit()" />
                    <i class="mdi mdi-check-circle-outline"></i> Solo activos
                </label>
            </form>
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item active">Condominios</li>
            </ol>
            <button type="button" class="btn btn-primary cq-tb-btn-new" id="btnNuevoCondominio">
                <i class="mdi mdi-plus"></i><span>Nuevo</span>
            </button>
        </div>
    </div>
}
