@model AreasComunesPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Áreas comunes";
    var isEditing = Model.Form.AreasComunesID.HasValue && Model.Form.AreasComunesID.Value > 0;
    var totalReservables = Model.Items.Count(item => item.RequiereReservacion == true && item.bEliminado != true);
}

<div class="container-fluid">

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="mdi mdi-alert-circle mr-1"></i>@Model.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card cq-reserva-hero mb-4">
        <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="flex-grow-1">
                <span class="badge badge-pill cq-reserva-pill">Catálogo base</span>
                <h3 class="mb-2 mt-2">Organiza amenidades con lectura rápida</h3>
                <p class="mb-0">Revisa capacidad, reservación y estado sin abrir varias pantallas.</p>
            </div>
            <div class="d-flex flex-wrap gap-2 cq-reserva-stat-strip">
                <div class="cq-reserva-stat"><span>Áreas</span><strong>@Model.Items.Count</strong></div>
                <div class="cq-reserva-stat"><span>Activas</span><strong>@Model.TotalActivas</strong></div>
                <div class="cq-reserva-stat"><span>Reservables</span><strong>@totalReservables</strong></div>
            </div>
        </div>
    </div>

    <div class="cq-split @(isEditing ? "panel-open" : "")" id="cqSplit">
        <div class="cq-table-pane">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-2 mb-3">
                        <div>
                            <h4 class="card-title mb-1">Listado de áreas comunes</h4>
                            <p class="text-muted mb-0">Abre la ficha correcta o revisa qué áreas ya admiten reservación.</p>
                        </div>
                        <span class="badge badge-light">@Model.Items.Count registro(s)</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle cq-filterable">
                            <thead>
                                <tr>
                                    <th data-type="text">Área</th>
                                    <th data-type="text">Descripción</th>
                                    <th data-type="number">Capacidad</th>
                                    <th data-type="select">Reservación</th>
                                    <th data-type="select">Estado</th>
                                    <th data-type="none">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Items.Any())
                                {
                                    <tr>
                                        <td colspan="6">
                                            <div class="cq-reserva-empty cq-reserva-empty--table">
                                                <div class="cq-reserva-empty-icon"><i class="mdi mdi-pool"></i></div>
                                                <h5 class="mb-2">Sin áreas cargadas</h5>
                                                <p class="text-muted mb-0">Crea la primera área común para habilitar reservas y consulta.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model.Items)
                                    {
                                        var rowActive = isEditing && Model.Form.AreasComunesID == item.AreasComunesID;
                                        <tr class="@(rowActive ? "cq-row-active" : "")">
                                            <td><strong>@item.AreasComunes</strong></td>
                                            <td>@item.DescripcionAreasComunes</td>
                                            <td>@item.Capacidad</td>
                                            <td>@(item.RequiereReservacion == true ? "Sí" : "No")</td>
                                            <td>
                                                <span class="badge @(item.bEliminado == true ? "badge-danger" : "badge-success")">
                                                    @(item.bEliminado == true ? "Eliminada" : "Activa")
                                                </span>
                                            </td>
                                            <td class="cq-actions">
                                                <div class="cq-actions-group">
                                                    @if (item.RequiereReservacion == true)
                                                    {
                                                        <a cq-btn="reserve" asp-controller="ReservasAmenidades" asp-action="Index" asp-route-areaId="@item.AreasComunesID" title="Reservar"></a>
                                                        <a cq-btn="list" asp-controller="ReservasAmenidades" asp-action="Index" asp-route-filtroAreaId="@item.AreasComunesID" title="Ver reservas"></a>
                                                    }
                                                    <a cq-btn="edit" asp-action="Index" asp-route-editId="@item.AreasComunesID" asp-route-soloActivas="@Model.SoloActivas" title="Editar"></a>
                                                    <form asp-action="Delete" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="areaComunId" value="@item.AreasComunesID" />
                                                        <button cq-btn="delete" type="submit" title="Eliminar" onclick="return confirm('¿Eliminar área común?');"></button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="cq-form-pane" id="cqFormPane">
            <div class="card @(isEditing ? "cq-card-editing" : "")">
                <div class="cq-panel-header">
                    <div class="cq-panel-icon"><i class="mdi @(isEditing ? "mdi-pencil" : "mdi-plus")"></i></div>
                    <div class="flex-grow-1 min-width-0">
                        <h5 class="mb-0">@(isEditing ? "Editar área" : "Nueva área")</h5>
                        <small class="text-muted">Captura o corrige el catálogo sin salir de esta vista.</small>
                    </div>
                    <button type="button" class="cq-close-btn" id="btnCerrarPanel"><i class="mdi mdi-close"></i></button>
                </div>
                <div class="card-body pt-3">
                    <form asp-action="Save" method="post" class="m-t-20">
                        @Html.AntiForgeryToken()
                        <input asp-for="Form.AreasComunesID" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group">
                            <label asp-for="Form.AreasComunes"></label>
                            <input asp-for="Form.AreasComunes" class="form-control" />
                            <span asp-validation-for="Form.AreasComunes" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.DescripcionAreasComunes"></label>
                            <input asp-for="Form.DescripcionAreasComunes" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.Capacidad"></label>
                            <input asp-for="Form.Capacidad" class="form-control" type="number" />
                        </div>
                        <div class="form-group form-check">
                            <input asp-for="Form.RequiereReservacion" class="form-check-input" />
                            <label asp-for="Form.RequiereReservacion" class="form-check-label"></label>
                        </div>
                        <div class="form-group form-check">
                            <input asp-for="Form.bEliminado" class="form-check-input" />
                            <label asp-for="Form.bEliminado" class="form-check-label"></label>
                        </div>

                        <div class="cq-form-actions">
                            <button type="submit" class="btn btn-primary flex-grow-1"><i class="mdi mdi-content-save mr-1"></i>Guardar</button>
                            <a asp-action="Index" asp-route-soloActivas="@Model.SoloActivas" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var split     = document.getElementById('cqSplit');
    var btnNuevo  = document.getElementById('btnNuevaArea');
    var btnCerrar = document.getElementById('btnCerrarPanel');
    var isEditing = @(isEditing ? "true" : "false");
    var cancelUrl = '@Html.Raw(Url.Action("Index", "AreasComunes", new { soloActivas = Model.SoloActivas }))';
    function openPanel()  { split.classList.add('panel-open'); }
    function closePanel() {
        if (isEditing) { window.location.href = cancelUrl; }
        else { split.classList.remove('panel-open'); }
    }
    if (btnNuevo)  btnNuevo.addEventListener('click', openPanel);
    if (btnCerrar) btnCerrar.addEventListener('click', closePanel);
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && split.classList.contains('panel-open')) closePanel();
    });
}());
</script>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-pool"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Áreas comunes</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge"><i class="mdi mdi-pool"></i><strong>@Model.Items.Count</strong></span>
                    <span class="cq-tb-dot"></span>
                    <span class="cq-tb-badge cq-tb-green"><i class="mdi mdi-check-circle-outline"></i><strong>@Model.TotalActivas</strong> activas</span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <form method="get" asp-action="Index" asp-controller="AreasComunes" class="cq-tb-filters d-inline-flex align-items-center gap-2" id="frmFiltrosTop">
                <input type="hidden" name="editId" value="" />
                <label class="cq-tb-toggle @(Model.SoloActivas ? "active" : "")">
                    <input type="checkbox" name="soloActivas" value="true"
                           @(Model.SoloActivas ? "checked" : "")
                           onchange="document.getElementById('frmFiltrosTop').submit()" />
                    <i class="mdi mdi-check-circle-outline"></i> Solo activas
                </label>
            </form>
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item active">Áreas comunes</li>
            </ol>
            <button type="button" class="btn btn-primary cq-tb-btn-new" id="btnNuevaArea">
                <i class="mdi mdi-plus"></i><span>Nuevo</span>
            </button>
        </div>
    </div>
}
