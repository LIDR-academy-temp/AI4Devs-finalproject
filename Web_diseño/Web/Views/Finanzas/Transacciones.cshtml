@model Web.Models.Admin.TransaccionesPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Transacciones";
    bool isEditing = Model.Form.TransaccionID.HasValue && Model.Form.TransaccionID > 0;
    var totalConCargo = Model.Items.Count(item => item.Cargo.HasValue && item.Cargo.Value > 0);
    var totalConAbono = Model.Items.Count(item => item.Abono.HasValue && item.Abono.Value > 0);
}

<div class="container-fluid">

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="mdi mdi-alert-circle mr-1"></i>@Model.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card cq-reserva-hero mb-4">
        <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="flex-grow-1">
                <span class="badge badge-pill cq-reserva-pill">Movimientos</span>
                <h3 class="mb-2 mt-2">Revisa cargos y abonos con más claridad</h3>
                <p class="mb-0">Filtra por cuenta, distingue cargo de abono y corrige el movimiento correcto desde la misma vista.</p>
            </div>
            <div class="d-flex flex-wrap gap-2 cq-reserva-stat-strip">
                <div class="cq-reserva-stat"><span>Transacciones</span><strong>@Model.Items.Count</strong></div>
                <div class="cq-reserva-stat"><span>Con cargo</span><strong>@totalConCargo</strong></div>
                <div class="cq-reserva-stat"><span>Con abono</span><strong>@totalConAbono</strong></div>
            </div>
        </div>
    </div>

    <div class="cq-split @(isEditing ? "panel-open" : "")" id="cqSplit">
        <div class="cq-table-pane">
            <div class="card"><div class="card-body">
                <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-2 mb-3">
                    <div>
                        <h4 class="card-title mb-1">Listado de transacciones</h4>
                        <p class="text-muted mb-0">Filtra la cuenta correcta y revisa si el movimiento fue cargo o abono antes de editar.</p>
                    </div>
                    <span class="badge badge-light">@Model.Items.Count registro(s)</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle cq-filterable">
                        <thead>
                            <tr>
                                <th data-type="text">Cuenta</th>
                                <th data-type="text">Usuario</th>
                                <th data-type="select">Tipo mov.</th>
                                <th data-type="number" class="text-end text-danger">Cargo</th>
                                <th data-type="number" class="text-end text-success">Abono</th>
                                <th data-type="text">Motivo</th>
                                <th data-type="select">Estado</th>
                                <th data-type="none">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Items.Any())
                            {
                                <tr>
                                    <td colspan="8">
                                        <div class="cq-reserva-empty cq-reserva-empty--table">
                                            <div class="cq-reserva-empty-icon"><i class="mdi mdi-swap-horizontal"></i></div>
                                            <h5 class="mb-2">Sin movimientos visibles</h5>
                                            <p class="text-muted mb-0">Registra la primera transacción para ver cargos y abonos en esta bandeja.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.Items)
                                {
                                    var rowActive = isEditing && Model.Form.TransaccionID == item.TransaccionID;
                                    <tr class="@(rowActive ? "cq-row-active" : "")">
                                        <td>
                                            <span>@(item.NombreCuenta ?? "—")</span>
                                            @if (!string.IsNullOrEmpty(item.TipoCuenta))
                                            {
                                                <br /><small class="text-muted">@item.TipoCuenta</small>
                                            }
                                        </td>
                                        <td>@(item.NombreUsuario ?? "—")</td>
                                        <td>@(item.TipoMovimiento ?? "—")</td>
                                        <td class="text-end text-danger">
                                            @if (item.Cargo.HasValue && item.Cargo > 0)
                                            {
                                                <span>$@item.Cargo.Value.ToString("N2")</span>
                                            }
                                        </td>
                                        <td class="text-end text-success">
                                            @if (item.Abono.HasValue && item.Abono > 0)
                                            {
                                                <span>$@item.Abono.Value.ToString("N2")</span>
                                            }
                                        </td>
                                        <td>@(item.Motivo ?? "—")</td>
                                        <td>
                                            <span class="badge @(item.bEliminado ? "badge-secondary" : "badge-success")">
                                                @(item.bEliminado ? "Eliminada" : "Activa")
                                            </span>
                                        </td>
                                        <td class="cq-actions">
                                            <div class="cq-actions-group">
                                                <a cq-btn="edit" asp-action="Index" asp-route-editId="@item.TransaccionID" asp-route-soloActivas="@Model.SoloActivas" asp-route-filtroCuentaId="@Model.FiltroCuentaId" title="Editar"></a>
                                                <form asp-action="Delete" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="transaccionId" value="@item.TransaccionID" />
                                                    <button cq-btn="delete" type="submit" onclick="return confirm('Eliminar transacción?');"></button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div></div>
        </div>

        <div class="cq-form-pane" id="cqFormPane">
            <div class="card @(isEditing ? "cq-card-editing" : "")">
                <div class="cq-panel-header">
                    <div class="cq-panel-icon"><i class="mdi @(isEditing ? "mdi-pencil" : "mdi-plus")"></i></div>
                    <div class="flex-grow-1 min-width-0">
                        <h5 class="mb-0">@(isEditing ? "Editar transacción" : "Nueva transacción")</h5>
                        <small class="text-muted">Captura o corrige el movimiento sin salir del tablero.</small>
                    </div>
                    <button type="button" class="cq-close-btn" id="btnCerrarPanel"><i class="mdi mdi-close"></i></button>
                </div>
                <div class="card-body pt-3">
                    <form asp-action="Save" method="post" class="m-t-20">
                        @Html.AntiForgeryToken()
                        <input asp-for="Form.TransaccionID" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group">
                            <label asp-for="Form.CuentaID"></label>
                            <select asp-for="Form.CuentaID" asp-items="Model.CuentaOptions" class="form-control"></select>
                            <span asp-validation-for="Form.CuentaID" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.UsuarioID"></label>
                            <select asp-for="Form.UsuarioID" asp-items="Model.UsuarioOptions" class="form-control"></select>
                            <span asp-validation-for="Form.UsuarioID" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.TipoMovimientoID"></label>
                            <select asp-for="Form.TipoMovimientoID" asp-items="Model.TipoMovimientoOptions" class="form-control"></select>
                            <span asp-validation-for="Form.TipoMovimientoID" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.Cargo"></label>
                            <input asp-for="Form.Cargo" type="number" step="0.01" class="form-control" placeholder="0.00" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.Abono"></label>
                            <input asp-for="Form.Abono" type="number" step="0.01" class="form-control" placeholder="0.00" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.Motivo"></label>
                            <input asp-for="Form.Motivo" class="form-control" />
                        </div>
                        <div class="form-group form-check">
                            <input asp-for="Form.bEliminado" class="form-check-input" />
                            <label asp-for="Form.bEliminado" class="form-check-label">Eliminado</label>
                        </div>

                        <div class="cq-form-actions">
                            <button type="submit" class="btn btn-primary flex-grow-1"><i class="mdi mdi-content-save mr-1"></i>Guardar</button>
                            <a asp-action="Index" asp-route-soloActivas="@Model.SoloActivas" asp-route-filtroCuentaId="@Model.FiltroCuentaId" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
    (function () {
        var split     = document.getElementById('cqSplit');
        var btnNuevo  = document.getElementById('btnNuevaTransaccion');
        var btnCerrar = document.getElementById('btnCerrarPanel');
        var isEditing = @(isEditing ? "true" : "false");
        var cancelUrl = '@Html.Raw(Url.Action("Index", "TransaccionesFin", new { soloActivas = Model.SoloActivas, filtroCuentaId = Model.FiltroCuentaId }))';
        function openPanel()  { split.classList.add('panel-open'); }
        function closePanel() {
            if (isEditing) { window.location.href = cancelUrl; }
            else { split.classList.remove('panel-open'); }
        }
        if (btnNuevo)  btnNuevo.addEventListener('click', openPanel);
        if (btnCerrar) btnCerrar.addEventListener('click', closePanel);
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && split.classList.contains('panel-open')) closePanel();
        });
    }());
    </script>

</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-swap-horizontal"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Transacciones</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge"><i class="mdi mdi-swap-horizontal"></i><strong>@Model.Items.Count</strong></span>
                    <span class="cq-tb-dot"></span>
                    <span class="cq-tb-badge" style="color:#16a34a"><i class="mdi mdi-check-circle-outline"></i><strong>@Model.TotalActivas</strong> activa(s)</span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <form method="get" asp-action="Index" asp-controller="TransaccionesFin"
                  class="cq-tb-filters d-inline-flex align-items-center gap-2" id="frmFiltrosTop">
                <input type="hidden" name="editId" value="" />
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" name="soloActivas" value="true"
                           id="chkActivasTop" @(Model.SoloActivas ? "checked" : "") onchange="this.form.submit()" />
                    <label class="form-check-label" for="chkActivasTop">Solo activas</label>
                </div>
                <div class="cq-tb-sel-wrap">
                    <select name="filtroCuentaId" class="cq-tb-select" onchange="this.form.submit()"
                            asp-items="Model.FiltroCuentaOptions">
                    </select>
                </div>
            </form>
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item active">Transacciones</li>
            </ol>
            <button type="button" class="btn btn-primary cq-tb-btn-new" id="btnNuevaTransaccion">
                <i class="mdi mdi-plus"></i><span>Nuevo</span>
            </button>
        </div>
    </div>
}