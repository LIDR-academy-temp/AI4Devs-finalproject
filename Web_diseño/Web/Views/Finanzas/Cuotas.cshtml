@model Web.Models.Admin.CuotasPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Cuotas";
    bool isEditing = Model.Form.CuotaID.HasValue && Model.Form.CuotaID > 0;
}

<div class="container-fluid">

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="mdi mdi-alert-circle mr-1"></i>@Model.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card cq-reserva-hero mb-4">
        <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="flex-grow-1">
                <span class="badge badge-pill cq-reserva-pill">Cobranza</span>
                <h3 class="mb-2 mt-2">Controla cuotas con lectura directa</h3>
                <p class="mb-0">Revisa propietario, vencimiento y estado desde una sola bandeja operativa.</p>
            </div>
            <div class="d-flex flex-wrap gap-2 cq-reserva-stat-strip">
                <div class="cq-reserva-stat"><span>Cuotas</span><strong>@Model.Items.Count</strong></div>
                <div class="cq-reserva-stat"><span>Pendientes</span><strong>@Model.TotalPendientes</strong></div>
                <div class="cq-reserva-stat"><span>Vencidas</span><strong>@Model.TotalVencidas</strong></div>
            </div>
        </div>
    </div>

    <div class="cq-split @(isEditing ? "panel-open" : "")" id="cqSplit">
        <div class="cq-table-pane">
            <div class="card"><div class="card-body">
                <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-2 mb-3">
                    <div>
                        <h4 class="card-title mb-1">Listado de cuotas</h4>
                        <p class="text-muted mb-0">Filtra vencimientos y abre la cuota correcta sin salir del tablero.</p>
                    </div>
                    <span class="badge badge-light">@Model.Items.Count registro(s)</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle cq-filterable">
                        <thead>
                            <tr>
                                <th data-type="text">Propietario</th>
                                <th data-type="text">Casa / Condominio</th>
                                <th data-type="number">Monto</th>
                                <th data-type="date">Vencimiento</th>
                                <th data-type="select">Estado</th>
                                <th data-type="none">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Items.Any())
                            {
                                <tr>
                                    <td colspan="6">
                                        <div class="cq-reserva-empty cq-reserva-empty--table">
                                            <div class="cq-reserva-empty-icon"><i class="mdi mdi-cash-clock"></i></div>
                                            <h5 class="mb-2">Sin cuotas visibles</h5>
                                            <p class="text-muted mb-0">Crea la primera cuota para iniciar el seguimiento de cobranza.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.Items)
                                {
                                    var rowActive = isEditing && Model.Form.CuotaID == item.CuotaID;
                                    <tr class="@(rowActive ? "cq-row-active" : "")">
                                        <td>@(item.NombrePropietario ?? "—")</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.DireccionCasa))
                                            {
                                                <small>@item.NombreCondominio</small><br />
                                                <span>@item.DireccionCasa</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="text-end">$@item.Monto.ToString("N2")</td>
                                        <td>@(item.FechaVencimiento != default ? item.FechaVencimiento.ToString("dd/MM/yyyy") : "—")</td>
                                        <td>
                                            <span class="@item.EstadoCuotaClase">@item.EstadoCuota</span>
                                        </td>
                                        <td class="cq-actions">
                                            <div class="cq-actions-group">
                                                <a cq-btn="edit" asp-action="Index" asp-route-editId="@item.CuotaID" asp-route-soloPendientes="@Model.SoloPendientes" title="Editar"></a>
                                                <form asp-action="Delete" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="cuotaId" value="@item.CuotaID" />
                                                    <button cq-btn="delete" type="submit" onclick="return confirm('Eliminar cuota?');"></button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div></div>
        </div>

        <div class="cq-form-pane" id="cqFormPane">
            <div class="card @(isEditing ? "cq-card-editing" : "")">
                <div class="cq-panel-header">
                    <div class="cq-panel-icon"><i class="mdi @(isEditing ? "mdi-pencil" : "mdi-plus")"></i></div>
                    <div class="flex-grow-1 min-width-0">
                        <h5 class="mb-0">@(isEditing ? "Editar cuota" : "Nueva cuota")</h5>
                        <small class="text-muted">Captura la cuota y su pago sin salir de esta vista.</small>
                    </div>
                    <button type="button" class="cq-close-btn" id="btnCerrarPanel"><i class="mdi mdi-close"></i></button>
                </div>
                <div class="card-body pt-3">
                    <form asp-action="Save" method="post" class="m-t-20">
                        @Html.AntiForgeryToken()
                        <input asp-for="Form.CuotaID" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group">
                            <label asp-for="Form.UsuarioID"></label>
                            <select asp-for="Form.UsuarioID" asp-items="Model.UsuarioOptions" class="form-control"></select>
                            <span asp-validation-for="Form.UsuarioID" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.CasaID"></label>
                            <select asp-for="Form.CasaID" asp-items="Model.CasaOptions" class="form-control"></select>
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.Monto"></label>
                            <input asp-for="Form.Monto" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="Form.Monto" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.PeriodoInicio"></label>
                            <input asp-for="Form.PeriodoInicio" type="date" class="form-control"
                                   value="@Model.Form.PeriodoInicio.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.PeriodoFin"></label>
                            <input asp-for="Form.PeriodoFin" type="date" class="form-control"
                                   value="@Model.Form.PeriodoFin.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.FechaVencimiento"></label>
                            <input asp-for="Form.FechaVencimiento" type="date" class="form-control"
                                   value="@Model.Form.FechaVencimiento.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="form-group form-check">
                            <input asp-for="Form.Pagado" class="form-check-input" id="chkPagado"
                                   onchange="togglePagoFields(this.checked)" />
                            <label asp-for="Form.Pagado" class="form-check-label">Pagado</label>
                        </div>
                        <div id="pagoFields" style="@(Model.Form.Pagado ? "" : "display:none")">
                            <div class="form-group">
                                <label asp-for="Form.FechaPago"></label>
                                <input asp-for="Form.FechaPago" type="date" class="form-control"
                                       value="@(Model.Form.FechaPago.HasValue ? Model.Form.FechaPago.Value.ToString("yyyy-MM-dd") : "")" />
                            </div>
                            <div class="form-group">
                                <label asp-for="Form.MetodoPago"></label>
                                <input asp-for="Form.MetodoPago" class="form-control" placeholder="Efectivo, Transferencia..." />
                            </div>
                            <div class="form-group">
                                <label asp-for="Form.ReferenciaPago"></label>
                                <input asp-for="Form.ReferenciaPago" class="form-control" />
                            </div>
                        </div>
                        <div class="form-group form-check">
                            <input asp-for="Form.bEliminado" class="form-check-input" />
                            <label asp-for="Form.bEliminado" class="form-check-label">Eliminado</label>
                        </div>

                        <div class="cq-form-actions">
                            <button type="submit" class="btn btn-primary flex-grow-1"><i class="mdi mdi-content-save mr-1"></i>Guardar</button>
                            <a asp-action="Index" asp-route-soloPendientes="@Model.SoloPendientes" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
    (function () {
        var split     = document.getElementById('cqSplit');
        var btnNuevo  = document.getElementById('btnNuevaCuota');
        var btnCerrar = document.getElementById('btnCerrarPanel');
        var isEditing = @(isEditing ? "true" : "false");
        var cancelUrl = '@Html.Raw(Url.Action("Index", "CuotasFin", new { soloPendientes = Model.SoloPendientes }))';
        function openPanel()  { split.classList.add('panel-open'); }
        function closePanel() {
            if (isEditing) { window.location.href = cancelUrl; }
            else { split.classList.remove('panel-open'); }
        }
        if (btnNuevo)  btnNuevo.addEventListener('click', openPanel);
        if (btnCerrar) btnCerrar.addEventListener('click', closePanel);
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && split.classList.contains('panel-open')) closePanel();
        });
    }());
    </script>

</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        function togglePagoFields(show) {
            document.getElementById('pagoFields').style.display = show ? '' : 'none';
        }
    </script>
}

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-currency-usd"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Cuotas</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge"><i class="mdi mdi-currency-usd"></i><strong>@Model.Items.Count</strong></span>
                    <span class="cq-tb-dot"></span>
                    <span class="cq-tb-badge" style="color:#d97706"><i class="mdi mdi-clock-alert-outline"></i><strong>@Model.TotalPendientes</strong> pend.</span>
                    @if (Model.TotalVencidas > 0)
                    {
                        <span class="cq-tb-dot"></span>
                        <span class="cq-tb-badge" style="color:#dc2626"><i class="mdi mdi-alert-circle-outline"></i><strong>@Model.TotalVencidas</strong> venc.</span>
                    }
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <form method="get" asp-action="Index" asp-controller="CuotasFin"
                  class="cq-tb-filters d-inline-flex align-items-center gap-2" id="frmFiltrosTop">
                <input type="hidden" name="editId" value="" />
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" name="soloPendientes" value="true"
                           id="chkPendientesTop" @(Model.SoloPendientes ? "checked" : "") onchange="this.form.submit()" />
                    <label class="form-check-label" for="chkPendientesTop">Solo pendientes</label>
                </div>
            </form>
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item active">Cuotas</li>
            </ol>
            <button type="button" class="btn btn-primary cq-tb-btn-new" id="btnNuevaCuota">
                <i class="mdi mdi-plus"></i><span>Nuevo</span>
            </button>
        </div>
    </div>
}