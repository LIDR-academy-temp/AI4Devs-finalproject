@model SgrUsuariosPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Usuarios";
    var isEditing = Model.Form.UsuarioID.HasValue && Model.Form.UsuarioID.Value > 0;
}

<div class="container-fluid">

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="mdi mdi-alert-circle mr-1"></i>@Model.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card cq-reserva-hero mb-4">
        <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="flex-grow-1">
                <span class="badge badge-pill cq-reserva-pill">Accesos</span>
                <h3 class="mb-2 mt-2">Revisa usuarios con menos fricción</h3>
                <p class="mb-0">Consulta correo, perfil y estado antes de editar el acceso de cada usuario.</p>
            </div>
            <div class="d-flex flex-wrap gap-2 cq-reserva-stat-strip">
                <div class="cq-reserva-stat"><span>Usuarios</span><strong>@Model.Items.Count</strong></div>
                <div class="cq-reserva-stat"><span>Activos</span><strong>@Model.Items.Count(item => item.bActivo)</strong></div>
                <div class="cq-reserva-stat"><span>Inactivos</span><strong>@Model.Items.Count(item => !item.bActivo)</strong></div>
            </div>
        </div>
    </div>

    <div class="cq-split @(isEditing ? "panel-open" : "")" id="cqSplit">
        <div class="cq-table-pane">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-2 mb-3">
                        <div>
                            <h4 class="card-title mb-1">Usuarios registrados</h4>
                            <p class="text-muted mb-0">Abre el usuario correcto y ajusta su perfil o estado desde el mismo tablero.</p>
                        </div>
                        <span class="badge badge-light">@Model.Items.Count registro(s)</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle cq-filterable">
                            <thead>
                                <tr>
                                    <th data-type="text">Nombre</th>
                                    <th data-type="text">Correo</th>
                                    <th data-type="select">Perfil</th>
                                    <th data-type="select" class="text-center">Activo</th>
                                    <th data-type="none" class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Items.Any())
                                {
                                    <tr>
                                        <td colspan="5">
                                            <div class="cq-reserva-empty cq-reserva-empty--table">
                                                <div class="cq-reserva-empty-icon"><i class="mdi mdi-account-circle-outline"></i></div>
                                                <h5 class="mb-2">Sin usuarios visibles</h5>
                                                <p class="text-muted mb-0">No hay usuarios para mostrar con el filtro actual.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model.Items)
                                    {
                                        var perfilNombre = Model.Perfiles.FirstOrDefault(p => p.PerfilID == item.PerfilID)?.Perfil ?? "—";
                                        var rowActive = isEditing && Model.Form.UsuarioID == item.UsuarioID;
                                        <tr class="@(rowActive ? "cq-row-active" : "")">
                                            <td>@item.Nombre</td>
                                            <td>@item.Correo</td>
                                            <td>@perfilNombre</td>
                                            <td class="text-center">
                                                @if (item.bActivo)
                                                {
                                                    <span class="badge badge-success">Activo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">Inactivo</span>
                                                }
                                            </td>
                                            <td class="cq-actions text-center">
                                                <div class="cq-actions-group justify-content-center">
                                                    <a cq-btn="edit"
                                                       asp-controller="UsuariosAdmin" asp-action="Index"
                                                       asp-route-editId="@item.UsuarioID"
                                                       title="Editar"></a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="cq-form-pane" id="cqFormPane">
            <div class="card @(isEditing ? "cq-card-editing" : "")">
                <div class="cq-panel-header">
                    <div class="cq-panel-icon"><i class="mdi mdi-pencil"></i></div>
                    <div class="flex-grow-1 min-width-0">
                        <h5 class="mb-0">Editar usuario</h5>
                        <small class="text-muted">Actualiza contacto, perfil y estado sin salir del listado.</small>
                    </div>
                    <button type="button" class="cq-close-btn" id="btnCerrarPanel"><i class="mdi mdi-close"></i></button>
                </div>
                <div class="card-body pt-3">
                    <form asp-controller="UsuariosAdmin" asp-action="Save" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="Form.UsuarioID" type="hidden" />

                        <div class="form-group">
                            <label asp-for="Form.Nombre">Nombre</label>
                            <input asp-for="Form.Nombre" class="form-control" required maxlength="100" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.Correo">Correo electrónico</label>
                            <input asp-for="Form.Correo" class="form-control" type="email" required maxlength="200"
                                   placeholder="correo@dominio.com" />
                            <small class="form-text text-muted">Debe ser único. El usuario usará este correo para iniciar sesión.</small>
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.Telefono">Teléfono</label>
                            <input asp-for="Form.Telefono" class="form-control" type="tel" maxlength="30" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.FotoUrl">URL de foto</label>
                            <input asp-for="Form.FotoUrl" class="form-control" type="url" maxlength="500" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.PerfilID">Perfil de acceso</label>
                            <select asp-for="Form.PerfilID" class="form-control"
                                    asp-items="@(new SelectList(Model.Perfiles, "PerfilID", "Perfil", Model.Form.PerfilID))">
                                <option value="">-- Sin perfil --</option>
                            </select>
                        </div>
                        <div class="form-group form-check">
                            <input asp-for="Form.bActivo" class="form-check-input" type="checkbox" />
                            <label asp-for="Form.bActivo" class="form-check-label">Activo</label>
                        </div>
                        <div class="cq-form-actions">
                            <button type="submit" class="btn btn-primary flex-grow-1"><i class="mdi mdi-content-save mr-1"></i>Guardar</button>
                            <a asp-controller="UsuariosAdmin" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var split=document.getElementById('cqSplit'),btnCerrar=document.getElementById('btnCerrarPanel');
    var isEditing=@(isEditing ? "true" : "false");
    var cancelUrl='@Html.Raw(Url.Action("Index","UsuariosAdmin"))';
    function closePanel(){if(isEditing){window.location.href=cancelUrl;}else{split.classList.remove('panel-open');}}
    if(btnCerrar)btnCerrar.addEventListener('click',closePanel);
    document.addEventListener('keydown',function(e){if(e.key==='Escape'&&split.classList.contains('panel-open'))closePanel();});
}());
</script>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-account-circle"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Usuarios</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge"><i class="mdi mdi-account-circle"></i><strong>@Model.Items.Count</strong></span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item active">Usuarios</li>
            </ol>
        </div>
    </div>
}
