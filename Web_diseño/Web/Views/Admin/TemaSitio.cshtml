@model Web.Models.SiteTheme.SiteThemeAdminPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Template del sitio";
}

<div class="container-fluid">
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="mdi mdi-alert-circle mr-1"></i>@Model.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card cq-reserva-hero mb-4">
        <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="flex-grow-1">
                <span class="badge badge-pill cq-reserva-pill">Apariencia global</span>
                <h3 class="mb-2 mt-2">Template del sitio</h3>
                <p class="mb-0">Define el template por defecto, fuentes y colores clave con vista previa en vivo.</p>
            </div>
            <div class="d-flex flex-wrap gap-2 cq-reserva-stat-strip">
                <div class="cq-reserva-stat"><span>Templates</span><strong>@Model.Themes.Count</strong></div>
                <div class="cq-reserva-stat"><span>Activo</span><strong>@Model.DefaultTheme</strong></div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-5 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h4 class="card-title mb-1">Configuración general</h4>
                    <p class="text-muted mb-4">Los cambios se guardan en <code>@Model.ConfigPath</code>.</p>

                    <form asp-controller="SiteThemeAdmin" asp-action="Save" method="post" id="cqThemeSettingsForm">
                        @Html.AntiForgeryToken()

                        <div class="form-group">
                            <label for="DefaultTheme">Template por defecto</label>
                            <select class="form-control js-theme-default-select" id="DefaultTheme" name="DefaultTheme">
                                @foreach (var theme in Model.Themes)
                                {
                                    if (theme.IsDefault)
                                    {
                                        <option value="@theme.Id" selected="selected">@theme.Label (@theme.Id)</option>
                                    }
                                    else
                                    {
                                        <option value="@theme.Id">@theme.Label (@theme.Id)</option>
                                    }
                                }
                            </select>
                            <small class="form-text text-muted">La vista previa se actualiza al cambiar esta opción.</small>
                        </div>

                        <input type="hidden" name="AllowUserSwitch" value="false" />
                        <div class="form-group form-check">
                            <input type="checkbox" class="form-check-input" id="AllowUserSwitch" name="AllowUserSwitch" value="true" @(Model.AllowUserSwitch ? "checked" : null) />
                            <label class="form-check-label" for="AllowUserSwitch">Permitir cambio de template en el topbar</label>
                        </div>

                        <div class="form-group">
                            <label for="GoogleFontsUrl">Google Fonts URL</label>
                            <input type="url" class="form-control" id="GoogleFontsUrl" name="GoogleFontsUrl" value="@Model.Fonts.GoogleFontsUrl" required />
                        </div>

                        <div class="form-group">
                            <label for="FontBody">Fuente body</label>
                            <input type="text" class="form-control" id="FontBody" name="FontBody" value="@Model.Fonts.Body" required />
                        </div>

                        <div class="form-group">
                            <label for="FontHeading">Fuente headings</label>
                            <input type="text" class="form-control" id="FontHeading" name="FontHeading" value="@Model.Fonts.Heading" required />
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="mdi mdi-content-save-outline mr-1"></i>Guardar configuración
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-xl-7 mb-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="card-title mb-1">Vista previa en vivo</h4>
                    <p class="text-muted mb-3">Muestra cómo se verían botones, superficies y sidebar con los colores actuales.</p>
                    <div class="cq-theme-preview-strip">
                        <div class="cq-theme-preview-swatch" style="background:var(--cq-primary);">Primary</div>
                        <div class="cq-theme-preview-swatch" style="background:var(--cq-accent);">Accent</div>
                        <div class="cq-theme-preview-swatch" style="background:var(--cq-sidebar-bg);color:#fff;">Sidebar</div>
                        <div class="cq-theme-preview-swatch" style="background:var(--cq-bg);border:1px solid var(--cq-border);">Fondo</div>
                        <button type="button" class="btn btn-primary btn-sm">Botón primario</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm">Secundario</button>
                    </div>
                </div>
            </div>

            <div class="card h-100">
                <div class="card-body">
                    <h4 class="card-title mb-1">Templates y colores</h4>
                    <p class="text-muted mb-4">Ajusta los tokens principales por template. Los cambios se previsualizan al instante.</p>

                    <div class="row">
                        @foreach (var theme in Model.Themes)
                        {
                            <div class="col-md-6 mb-3">
                                <div class="card h-100 @(theme.IsDefault ? "border-primary" : "")">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center justify-content-between mb-3">
                                            <div>
                                                <strong>@theme.Label</strong>
                                                <div class="text-muted small">@theme.Id</div>
                                            </div>
                                            @if (theme.IsDefault)
                                            {
                                                <span class="badge badge-primary">Activo</span>
                                            }
                                        </div>

                                        <form asp-controller="SiteThemeAdmin" asp-action="SaveThemeTokens" method="post" class="js-theme-token-form" data-theme-id="@theme.Id">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="ThemeId" value="@theme.Id" />

                                            <div class="cq-theme-color-grid mb-3">
                                                <label class="cq-theme-color-field">
                                                    <span>Primary</span>
                                                    <input type="color" class="js-theme-color" name="PrimaryColor" value="@theme.PrimaryColor" data-token="--cq-primary" />
                                                </label>
                                                <label class="cq-theme-color-field">
                                                    <span>Accent</span>
                                                    <input type="color" class="js-theme-color" name="AccentColor" value="@theme.AccentColor" data-token="--cq-accent" />
                                                </label>
                                                <label class="cq-theme-color-field">
                                                    <span>Sidebar</span>
                                                    <input type="color" class="js-theme-color" name="SidebarColor" value="@theme.SidebarColor" data-token="--cq-sidebar-bg" />
                                                </label>
                                                <label class="cq-theme-color-field">
                                                    <span>Fondo</span>
                                                    <input type="color" class="js-theme-color" name="BgColor" value="@theme.BgColor" data-token="--cq-bg" />
                                                </label>
                                                <label class="cq-theme-color-field">
                                                    <span>Meta</span>
                                                    <input type="color" class="js-theme-color" name="MetaThemeColor" value="@theme.MetaThemeColor" data-meta="true" />
                                                </label>
                                            </div>

                                            <div class="d-flex flex-wrap gap-2">
                                                <button type="button" class="btn btn-outline-secondary btn-sm js-preview-theme" data-theme-id="@theme.Id">
                                                    Vista previa
                                                </button>
                                                <button type="submit" class="btn btn-primary btn-sm">
                                                    <i class="mdi mdi-content-save-outline"></i> Guardar colores
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-palette-outline"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Template del sitio</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge">@Model.Themes.Count template(s) · activo: @Model.DefaultTheme</span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item active">Template del sitio</li>
            </ol>
        </div>
    </div>
}

@section Scripts {
<script>
    (function () {
        function collectTokenOverrides(form) {
            var overrides = {};
            form.querySelectorAll('.js-theme-color').forEach(function (input) {
                var token = input.getAttribute('data-token');
                if (token) {
                    overrides[token] = input.value;
                    if (token === '--cq-primary') {
                        overrides['--color-primary'] = input.value;
                    }
                    if (token === '--cq-accent') {
                        overrides['--color-accent'] = input.value;
                    }
                }
            });

            var metaInput = form.querySelector('.js-theme-color[data-meta="true"]');
            return {
                overrides: overrides,
                metaThemeColor: metaInput ? metaInput.value : null
            };
        }

        function previewFormTheme(form) {
            if (!window.CqThemeEngine || !form) return;
            var themeId = form.getAttribute('data-theme-id');
            var payload = collectTokenOverrides(form);
            window.CqThemeEngine.previewTokenOverrides(themeId, payload.overrides, payload.metaThemeColor);
        }

        document.querySelectorAll('.js-theme-token-form').forEach(function (form) {
            form.querySelectorAll('.js-theme-color').forEach(function (input) {
                input.addEventListener('input', function () {
                    previewFormTheme(form);
                });
            });
        });

        document.querySelectorAll('.js-preview-theme').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var form = btn.closest('.js-theme-token-form');
                if (form) {
                    previewFormTheme(form);
                    return;
                }

                if (window.CqThemeEngine) {
                    window.CqThemeEngine.applyTheme(btn.getAttribute('data-theme-id'));
                }
            });
        });

        var defaultSelect = document.querySelector('.js-theme-default-select');
        if (defaultSelect) {
            defaultSelect.addEventListener('change', function () {
                if (!window.CqThemeEngine) return;
                window.CqThemeEngine.applyTheme(defaultSelect.value);
            });
        }
    })();
</script>
}
