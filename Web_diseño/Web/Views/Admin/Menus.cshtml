@model SgrMenusAdminPageViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = "_Layout";
    ViewData["Title"] = "Gestión de menús";
    var isEditing  = Model.Form.MenuID.HasValue && Model.Form.MenuID.Value > 0;
    var padres     = Model.Items.Where(m => m.PadreMenuID == null).OrderBy(m => m.Orden).ToList();
    var hijos      = Model.Items.Where(m => m.PadreMenuID != null).OrderBy(m => m.Orden).ToList();
    var padreIds   = padres.Select(p => p.MenuID).ToHashSet();
    var huerfanos  = hijos.Where(h => !padreIds.Contains(h.PadreMenuID)).ToList();
}

<style>
.mn-group           { margin-bottom:1.25rem; }
.mn-group-header    { display:flex;align-items:center;gap:.5rem;padding:.55rem .85rem;
                      background:var(--cq-surface-alt);border-radius:var(--cq-radius-sm);
                      font-weight:700;font-size:.82rem;color:var(--cq-text);
                      border-left:3px solid var(--cq-primary); }
.mn-group-header i  { font-size:1rem;color:var(--cq-primary); }
.mn-children        { padding-left:1.1rem;margin-top:.3rem;display:flex;flex-direction:column;gap:.3rem; }
.mn-row             { display:flex;align-items:center;gap:.5rem;padding:.4rem .75rem;
                      border-radius:var(--cq-radius-sm);border:1px solid var(--cq-border);
                      background:var(--cq-surface);font-size:.82rem;transition:box-shadow .12s; }
.mn-row:hover       { box-shadow:var(--cq-shadow); }
.mn-row i           { font-size:.95rem;color:var(--cq-muted);flex-shrink:0; }
.mn-row-title       { flex:1;font-weight:600;color:var(--cq-text); }
.mn-row-ruta        { font-size:.74rem;color:var(--cq-muted);font-family:monospace; }
.mn-row-orden       { font-size:.72rem;font-weight:700;background:var(--cq-surface-alt);
                      border-radius:12px;padding:.1em .55em;color:var(--cq-muted);flex-shrink:0; }
.mn-row-actions     { display:flex;gap:.3rem;flex-shrink:0; }
.mn-orphan-section  { margin-top:1.5rem; }
.mn-orphan-label    { font-size:.72rem;font-weight:700;text-transform:uppercase;
                      letter-spacing:.04em;color:var(--cq-muted);margin-bottom:.4rem; }
.mn-editing-badge   { display:inline-flex;align-items:center;gap:.3rem;font-size:.7rem;
                      font-weight:700;background:rgba(217,119,6,.12);color:#d97706;
                      border-radius:20px;padding:.2em .7em;margin-bottom:.5rem; }
</style>

<div class="container-fluid">
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="mdi mdi-alert-circle mr-1"></i>@Model.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card cq-reserva-hero mb-4">
        <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="flex-grow-1">
                <span class="badge badge-pill cq-reserva-pill">Navegación</span>
                <h3 class="mb-2 mt-2">Organiza menús sin perder el árbol completo</h3>
                <p class="mb-0">Edita grupos, rutas e iconos mientras conservas la lectura jerárquica del sistema.</p>
            </div>
            <div class="d-flex flex-wrap gap-2 cq-reserva-stat-strip">
                <div class="cq-reserva-stat"><span>Menús</span><strong>@Model.Items.Count</strong></div>
                <div class="cq-reserva-stat"><span>Grupos</span><strong>@padres.Count</strong></div>
                <div class="cq-reserva-stat"><span>Submenús</span><strong>@hijos.Count</strong></div>
            </div>
        </div>
    </div>

    <div class="row">

        @* ═══════ FORMULARIO ═══════ *@
        <div class="col-lg-4 mb-4">
            <div class="card h-100" style="border:2px solid @(isEditing ? "var(--cq-warning)" : "var(--cq-border)");border-radius:var(--cq-radius-md);">
                <div class="card-body p-4">

                    @if (isEditing)
                    {
                        <div class="mn-editing-badge">
                            <i class="mdi mdi-pencil"></i> Editando menú
                        </div>
                    }

                    <h5 class="fw-bold mb-3" style="font-size:.95rem;">
                        <i class="mdi mdi-menu" style="color:var(--cq-primary);"></i>
                        @(isEditing ? "Editar ítem" : "Nuevo ítem de menú")
                    </h5>

                    <form asp-controller="MenusAdmin" asp-action="Save" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="MenuID" value="@Model.Form.MenuID" />

                        <div class="form-group">
                            <label class="fw-semibold" style="font-size:.82rem;">
                                Título <span class="text-danger">*</span>
                            </label>
                            <input class="form-control" type="text" name="TituloMenu"
                                   value="@Model.Form.TituloMenu" required maxlength="100"
                                   placeholder="Ej. Encuestas" />
                        </div>

                        <div class="form-group">
                            <label class="fw-semibold" style="font-size:.82rem;">
                                Ruta
                                <span class="text-muted" style="font-weight:400;font-size:.76rem;">(dejar vacío si es grupo padre)</span>
                            </label>
                            <input class="form-control" type="text" name="Ruta"
                                   value="@Model.Form.Ruta" maxlength="200"
                                   placeholder="Ej. Encuestas/Responder" />
                            <small class="text-muted">Sin barra inicial. Ejemplo: <code>Admin/Menus</code></small>
                        </div>

                        <div class="form-group">
                            <label class="fw-semibold" style="font-size:.82rem;">Icono MDI</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text" style="min-width:42px;justify-content:center;">
                                        <i class="mdi @(string.IsNullOrWhiteSpace(Model.Form.Icono) ? "mdi-circle-small" : Model.Form.Icono)"
                                           id="iconPreviewIcon" style="font-size:1.2rem;color:var(--cq-primary);"></i>
                                    </span>
                                </div>
                                <input class="form-control" type="text" name="Icono" id="inputIcono"
                                       value="@Model.Form.Icono" maxlength="80"
                                       placeholder="mdi-home-variant" autocomplete="off" />
                            </div>
                            <small class="text-muted">
                                Ver iconos: <a href="https://pictogrammers.com/library/mdi/" target="_blank" rel="noopener">pictogrammers.com <i class="mdi mdi-open-in-new"></i></a>
                            </small>
                        </div>

                        <div class="row">
                            <div class="col-5">
                                <div class="form-group">
                                    <label class="fw-semibold" style="font-size:.82rem;">Orden</label>
                                    <input class="form-control" type="number" name="Orden"
                                           value="@(Model.Form.Orden == 0 && !isEditing ? "" : Model.Form.Orden.ToString())"
                                           min="1" max="999" placeholder="10" />
                                </div>
                            </div>
                            <div class="col-7">
                                <div class="form-group">
                                    <label class="fw-semibold" style="font-size:.82rem;">Grupo padre</label>
                                    <select class="form-control" name="PadreMenuID">
                                        <option value="">-- Raíz (sin padre) --</option>
                                        @foreach (var padre in padres)
                                        {
                                            var sel = Model.Form.PadreMenuID == padre.MenuID ? "selected" : null;
                                            <option value="@padre.MenuID" selected="@sel">@padre.TituloMenu</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex" style="gap:.5rem;margin-top:.5rem;">
                            <button type="submit" class="btn btn-primary btn-sm px-4">
                                <i class="mdi mdi-check mr-1"></i>
                                @(isEditing ? "Actualizar" : "Agregar")
                            </button>
                            @if (isEditing)
                            {
                                <a asp-controller="MenusAdmin" asp-action="Index"
                                   class="btn btn-outline-secondary btn-sm">Cancelar</a>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @* ═══════ ARBOL DE MENUS ═══════ *@
        <div class="col-lg-8 mb-4">
            <div class="card">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h4 class="card-title mb-0">
                        <i class="mdi mdi-sitemap mr-1" style="color:var(--cq-primary);"></i>
                        Menús configurados
                        <span class="badge badge-light ml-1" style="font-size:.72rem;">@Model.Items.Count</span>
                    </h4>
                </div>
                <div class="card-body p-3">

                    @if (!Model.Items.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="mdi mdi-menu-open" style="font-size:2.5rem;opacity:.35;display:block;margin-bottom:.5rem;"></i>
                            <p style="font-size:.84rem;">No hay menús registrados. Crea el primero.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var padre in padres)
                        {
                            var hijosDePadre = hijos.Where(h => h.PadreMenuID == padre.MenuID).ToList();
                            <div class="mn-group">
                                <div class="mn-group-header">
                                    <i class="mdi @(padre.Icono ?? "mdi-folder-outline")"></i>
                                    <span>@padre.TituloMenu</span>
                                    <span class="mn-row-orden">@padre.Orden</span>
                                    <div class="ml-auto d-flex" style="gap:.3rem;">
                                        <a cq-btn="edit"
                                           asp-controller="MenusAdmin" asp-action="Index"
                                           asp-route-editId="@padre.MenuID"
                                           title="Editar grupo"></a>
                                        <form asp-controller="MenusAdmin" asp-action="Delete" method="post" class="d-inline"
                                              onsubmit="return confirm('Eliminar este grupo?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="menuId" value="@padre.MenuID" />
                                            <button cq-btn="delete" type="submit" title="Eliminar"></button>
                                        </form>
                                    </div>
                                </div>

                                @if (hijosDePadre.Any())
                                {
                                    <div class="mn-children">
                                        @foreach (var hijo in hijosDePadre)
                                        {
                                            <div class="mn-row @(hijo.MenuID == Model.Form.MenuID ? "border-warning" : "")">
                                                <i class="mdi @(hijo.Icono ?? "mdi-circle-small")"></i>
                                                <span class="mn-row-title">@hijo.TituloMenu</span>
                                                @if (!string.IsNullOrWhiteSpace(hijo.Ruta))
                                                {
                                                    <span class="mn-row-ruta">/@hijo.Ruta</span>
                                                }
                                                <span class="mn-row-orden">@hijo.Orden</span>
                                                <div class="mn-row-actions">
                                                    <a cq-btn="edit"
                                                       asp-controller="MenusAdmin" asp-action="Index"
                                                       asp-route-editId="@hijo.MenuID"
                                                       title="Editar"></a>
                                                    <form asp-controller="MenusAdmin" asp-action="Delete" method="post" class="d-inline"
                                                            onsubmit="return confirm('¿Eliminar este ítem?')">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="menuId" value="@hijo.MenuID" />
                                                        <button cq-btn="delete" type="submit" title="Eliminar"></button>
                                                    </form>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="mn-children">
                                        <div class="text-muted" style="font-size:.76rem;padding:.3rem .5rem;">
                                            <i class="mdi mdi-subdirectory-arrow-right"></i> Sin submenús
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @if (huerfanos.Any())
                        {
                            <div class="mn-orphan-section">
                                <div class="mn-orphan-label text-warning">
                                    <i class="mdi mdi-alert-outline"></i> Sin grupo padre válido
                                </div>
                                <div class="d-flex flex-column" style="gap:.3rem;">
                                    @foreach (var h in huerfanos)
                                    {
                                        <div class="mn-row">
                                            <i class="mdi @(h.Icono ?? "mdi-circle-small")"></i>
                                            <span class="mn-row-title">@h.TituloMenu</span>
                                            @if (!string.IsNullOrWhiteSpace(h.Ruta))
                                            {
                                                <span class="mn-row-ruta">/@h.Ruta</span>
                                            }
                                            <span class="mn-row-orden">@h.Orden</span>
                                            <div class="mn-row-actions">
                                                <a cq-btn="edit" asp-controller="MenusAdmin" asp-action="Index"
                                                   asp-route-editId="@h.MenuID" title="Editar"></a>
                                                <form asp-controller="MenusAdmin" asp-action="Delete" method="post" class="d-inline"
                                                      onsubmit="return confirm('Eliminar este item?')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="menuId" value="@h.MenuID" />
                                                    <button cq-btn="delete" type="submit" title="Eliminar"></button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }

                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
(function () {
    var input   = document.getElementById('inputIcono');
    var preview = document.getElementById('iconPreviewIcon');
    if (!input || !preview) return;
    input.addEventListener('input', function () {
        var val = input.value.trim();
        preview.className = 'mdi ' + (val || 'mdi-circle-small');
    });
})();
</script>
}

<script>
(function(){
    var btn=document.getElementById('btnNuevoMenu');
    if(btn)btn.addEventListener('click',function(){
        var inp=document.querySelector('input[name="TituloMenu"]');
        if(inp){inp.focus();inp.scrollIntoView({behavior:'smooth',block:'center'});}
    });
}());
</script>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-menu"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Gestión de Menús</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge"><i class="mdi mdi-menu"></i><strong>@Model.Items.Count</strong></span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item">Admin</li>
                <li class="breadcrumb-item active">Gestión de Menús</li>
            </ol>
            <button type="button" class="btn btn-primary cq-tb-btn-new" id="btnNuevoMenu">
                <i class="mdi mdi-plus"></i><span>Nuevo</span>
            </button>
        </div>
    </div>
}
