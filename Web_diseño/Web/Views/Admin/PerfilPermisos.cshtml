@model PerfilPermisosPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Permisos de Perfil";
    var totalMenus   = Model.Menus.Count(m => m.bVisible);
    var totalBotones = Model.Botones.Count(b => b.bActivo);
    var totalPerfiles = Model.Perfiles.Count;
}

<div class="container-fluid">

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="mdi mdi-alert-circle mr-1"></i>@Model.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card cq-reserva-hero mb-4">
        <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="flex-grow-1">
                <span class="badge badge-pill cq-reserva-pill">Permisos</span>
                <h3 class="mb-2 mt-2">@(Model.PerfilID > 0 ? $"Configura accesos para {Model.NombrePerfil}" : "Selecciona un perfil para configurar accesos")</h3>
                <p class="mb-0">Activa o bloquea módulos y acciones sin cambiar de pantalla.</p>
            </div>
            <div class="d-flex flex-wrap gap-2 cq-reserva-stat-strip">
                <div class="cq-reserva-stat"><span>Perfiles</span><strong>@totalPerfiles</strong></div>
                <div class="cq-reserva-stat"><span>Módulos</span><strong>@totalMenus</strong></div>
                <div class="cq-reserva-stat"><span>Acciones</span><strong>@totalBotones</strong></div>
            </div>
        </div>
    </div>

    @* Selector de perfil *@
    <div class="card mb-3">
        <div class="card-body py-3">
            <form method="get" asp-controller="PerfilPermisos" asp-action="Index"
                  class="d-flex align-items-center gap-3 flex-wrap">
                <label class="mb-0 font-weight-500 text-muted" style="white-space:nowrap;font-size:.85rem;">
                    <i class="mdi mdi-account-key-outline mr-1"></i>Perfil:
                </label>
                <div class="cq-tb-sel-wrap" style="min-width:200px;">
                    <i class="mdi mdi-account-multiple-outline cq-tb-sel-icon"></i>
                    <select name="perfilId" class="cq-tb-select" onchange="this.form.submit()">
                        <option value="0">-- Selecciona un perfil --</option>
                        @foreach (var p in Model.Perfiles)
                        {
                            <option value="@p.PerfilID" selected="@(p.PerfilID == Model.PerfilID)">@p.Perfil</option>
                        }
                    </select>
                    <i class="mdi mdi-chevron-down cq-tb-sel-chev"></i>
                </div>
                @if (Model.PerfilID > 0)
                {
                    <span class="cq-tb-badge ml-2">
                        <i class="mdi mdi-menu"></i><strong>@totalMenus</strong> módulos activos
                    </span>
                    <span class="cq-tb-badge cq-tb-green">
                        <i class="mdi mdi-gesture-tap-button"></i><strong>@totalBotones</strong> acciones activas
                    </span>
                }
            </form>
        </div>
    </div>

    @if (Model.PerfilID > 0)
    {
        <div class="row">

            @* Módulos / Menús *@
            <div class="col-lg-6 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h5 class="card-title mb-0">
                                <i class="mdi mdi-view-list mr-1 text-primary"></i>Acceso a módulos
                            </h5>
                            <span class="badge badge-pill" style="background:#e8f0fe;color:#1565c0;font-size:.75rem;font-weight:600;">
                                @totalMenus activos
                            </span>
                        </div>

                        @if (!Model.Menus.Any())
                        {
                            <div class="cq-empty-state py-3">
                                <i class="mdi mdi-menu-open cq-empty-icon" style="font-size:2rem;"></i>
                                <p class="cq-empty-title">Sin módulos asignados</p>
                            </div>
                        }
                        else
                        {
                            <div class="cq-perm-list">
                                @foreach (var menu in Model.Menus.OrderBy(m => m.PadreMenuID ?? m.MenuID).ThenBy(m => m.Orden))
                                {
                                    <div class="cq-perm-row @(menu.bVisible ? "cq-perm-active" : "cq-perm-inactive")">
                                        <div class="cq-perm-label">
                                            @if (menu.PadreMenuID.HasValue)
                                            {
                                                <i class="mdi mdi-subdirectory-arrow-right cq-perm-indent text-muted"></i>
                                            }
                                            else
                                            {
                                                <i class="mdi mdi-folder-outline cq-perm-folder"></i>
                                            }
                                            <span>@menu.TituloMenu</span>
                                        </div>
                                        <div class="cq-perm-actions">
                                            <span class="cq-perm-badge @(menu.bVisible ? "cq-perm-on" : "cq-perm-off")">
                                                <i class="mdi @(menu.bVisible ? "mdi-eye-outline" : "mdi-eye-off-outline")"></i>
                                                @(menu.bVisible ? "Visible" : "Oculto")
                                            </span>
                                            <form asp-controller="PerfilPermisos" asp-action="SetMenu" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="perfilId" value="@Model.PerfilID" />
                                                <input type="hidden" name="menuId" value="@menu.MenuID" />
                                                <input type="hidden" name="bVisible" value="@(!menu.bVisible)" />
                                                <button type="submit"
                                                        class="cq-perm-toggle @(menu.bVisible ? "cq-perm-toggle-off" : "cq-perm-toggle-on")"
                                                        title="@(menu.bVisible ? "Quitar acceso" : "Dar acceso")">
                                                    @(menu.bVisible ? "Quitar" : "Dar acceso")
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @* Agregar módulo disponible *@
                        @if (Model.MenusDisponibles.Any())
                        {
                            <div class="cq-perm-add-wrap mt-3">
                                <form asp-controller="PerfilPermisos" asp-action="AddMenu" method="post"
                                      class="d-flex align-items-center gap-2 flex-wrap">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="perfilId" value="@Model.PerfilID" />
                                    <div class="cq-tb-sel-wrap flex-grow-1" style="min-width:180px;">
                                        <i class="mdi mdi-plus-circle-outline cq-tb-sel-icon"></i>
                                        <select name="menuId" class="cq-tb-select" required>
                                            <option value="">Selecciona un módulo…</option>
                                            @foreach (var m in Model.MenusDisponibles)
                                            {
                                                <option value="@m.MenuID">
                                                    @(m.PadreMenuID.HasValue ? "↳ " : "")@m.TituloMenu
                                                </option>
                                            }
                                        </select>
                                        <i class="mdi mdi-chevron-down cq-tb-sel-chev"></i>
                                    </div>
                                    <button type="submit" class="btn btn-sm btn-primary">
                                        <i class="mdi mdi-plus mr-1"></i>Agregar
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Acciones / Botones *@
            <div class="col-lg-6 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h5 class="card-title mb-0">
                                <i class="mdi mdi-gesture-tap-button mr-1 text-primary"></i>Permisos de acciones
                            </h5>
                            <span class="badge badge-pill" style="background:#e8f5e9;color:#2e7d32;font-size:.75rem;font-weight:600;">
                                @totalBotones activos
                            </span>
                        </div>

                        @if (!Model.Botones.Any())
                        {
                            <div class="cq-empty-state py-3">
                                <i class="mdi mdi-cursor-pointer cq-empty-icon" style="font-size:2rem;"></i>
                                <p class="cq-empty-title">Sin acciones asignadas</p>
                            </div>
                        }
                        else
                        {
                            <div class="cq-perm-list">
                                @foreach (var boton in Model.Botones.OrderBy(b => b.MenuID).ThenBy(b => b.Accion))
                                {
                                    <div class="cq-perm-row @(boton.bActivo ? "cq-perm-active" : "cq-perm-inactive")">
                                        <div class="cq-perm-label">
                                            <i class="mdi mdi-gesture-tap cq-perm-folder"></i>
                                            <div>
                                                <span>@boton.Boton</span>
                                                <code class="cq-perm-code">@boton.Accion</code>
                                            </div>
                                        </div>
                                        <div class="cq-perm-actions">
                                            <span class="cq-perm-badge @(boton.bActivo ? "cq-perm-on" : "cq-perm-off")">
                                                <i class="mdi @(boton.bActivo ? "mdi-check-circle-outline" : "mdi-close-circle-outline")"></i>
                                                @(boton.bActivo ? "Activo" : "Inactivo")
                                            </span>
                                            <form asp-controller="PerfilPermisos" asp-action="SetBoton" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="perfilId" value="@Model.PerfilID" />
                                                <input type="hidden" name="menuBotonId" value="@boton.MenuBotonID" />
                                                <input type="hidden" name="bActivo" value="@(!boton.bActivo)" />
                                                <button type="submit"
                                                        class="cq-perm-toggle @(boton.bActivo ? "cq-perm-toggle-off" : "cq-perm-toggle-on")"
                                                        title="@(boton.bActivo ? "Desactivar" : "Activar")">
                                                    @(boton.bActivo ? "Desactivar" : "Activar")
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>
    }
    else
    {
        <div class="cq-empty-state" style="min-height:220px;">
            <i class="mdi mdi-account-key-outline cq-empty-icon"></i>
            <p class="cq-empty-title">Selecciona un perfil para ver sus permisos</p>
            <p class="text-muted">Usa el selector de arriba para elegir el perfil a configurar.</p>
        </div>
    }

</div>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon">
                <i class="mdi mdi-account-key-outline"></i>
            </div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Permisos@(Model.PerfilID > 0 ? $" — {Model.NombrePerfil}" : "")</span>
                <div class="cq-tb-meta">
                    @if (Model.PerfilID > 0)
                    {
                        <span class="cq-tb-badge"><i class="mdi mdi-menu"></i><strong>@totalMenus</strong> módulos</span>
                        <span class="cq-tb-dot"></span>
                        <span class="cq-tb-badge cq-tb-green"><i class="mdi mdi-check-circle-outline"></i><strong>@totalBotones</strong> acciones</span>
                    }
                    else
                    {
                        <span class="cq-tb-badge">Configura accesos por perfil</span>
                    }
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item"><a asp-controller="PerfilesAdmin" asp-action="Index">Perfiles</a></li>
                <li class="breadcrumb-item active">Permisos</li>
            </ol>
        </div>
    </div>
}
