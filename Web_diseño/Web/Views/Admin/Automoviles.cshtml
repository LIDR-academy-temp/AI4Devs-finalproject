@model AutomovilesAdminPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Automóviles";
    var isEditing = Model.Form.AutomovilID.HasValue && Model.Form.AutomovilID.Value > 0;
    var cancelUrl = Url.Action("Index", "AutomovilesAdmin", new { /* filtros actuales */ });
    var totalConPlacas = Model.Items.Count(item => !string.IsNullOrWhiteSpace(item.Placas));
}

<div class="container-fluid">

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="mdi mdi-alert-circle mr-1"></i>@Model.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card cq-reserva-hero mb-4">
        <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="flex-grow-1">
                <span class="badge badge-pill cq-reserva-pill">Vehículos</span>
                <h3 class="mb-2 mt-2">Ordena automóviles con contexto útil</h3>
                <p class="mb-0">Consulta residente, dirección y placas antes de corregir o depurar un registro.</p>
            </div>
            <div class="d-flex flex-wrap gap-2 cq-reserva-stat-strip">
                <div class="cq-reserva-stat"><span>Automóviles</span><strong>@Model.Items.Count</strong></div>
                <div class="cq-reserva-stat"><span>Con placas</span><strong>@totalConPlacas</strong></div>
                <div class="cq-reserva-stat"><span>Con dirección</span><strong>@Model.Items.Count(item => !string.IsNullOrWhiteSpace(item.DireccionCondomino))</strong></div>
            </div>
        </div>
    </div>

    <div class="cq-split @(isEditing ? "panel-open" : "")" id="cqSplit">
        <div class="cq-table-pane">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-2 mb-3">
                        <div>
                            <h4 class="card-title mb-1">Automóviles registrados</h4>
                            <p class="text-muted mb-0">Abre el vehículo correcto y revisa su residente antes de hacer cambios.</p>
                        </div>
                        <span class="badge badge-light">@Model.Items.Count registro(s)</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle cq-filterable">
                            <thead>
                                <tr>
                                    <th data-type="text">Residente</th>
                                    <th data-type="text">Dirección</th>
                                    <th data-type="text">Modelo</th>
                                    <th data-type="text">Placas</th>
                                    <th data-type="none" class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Items.Any())
                                {
                                    <tr>
                                        <td colspan="5">
                                            <div class="cq-reserva-empty cq-reserva-empty--table">
                                                <div class="cq-reserva-empty-icon"><i class="mdi mdi-car-outline"></i></div>
                                                <h5 class="mb-2">Sin automóviles visibles</h5>
                                                <p class="text-muted mb-0">Crea el primer registro para controlar vehículos del condominio.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model.Items)
                                    {
                                        var rowActive = isEditing && Model.Form.AutomovilID == item.AutomovilID;
                                        <tr class="@(rowActive ? "cq-row-active" : "")">
                                            <td>@item.NombreUsuario</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.DireccionCondomino) ? "Sin dirección" : item.DireccionCondomino)</td>
                                            <td>@item.ModeloLibre</td>
                                            <td>@item.Placas</td>
                                            <td class="cq-actions text-center">
                                                <div class="cq-actions-group justify-content-center">
                                                    <a cq-btn="edit"
                                                       asp-controller="AutomovilesAdmin" asp-action="Index"
                                                       asp-route-editId="@item.AutomovilID"
                                                       title="Editar"></a>
                                                    <form asp-action="Delete" method="post" class="d-inline" id="delete-automovil-@item.AutomovilID">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="automovilId" value="@item.AutomovilID" />
                                                        <button cq-btn="delete"
                                                                type="button"
                                                                class="js-delete-trigger"
                                                                title="Eliminar"
                                                                aria-label="Eliminar automóvil @item.ModeloLibre"
                                                                aria-haspopup="dialog"
                                                                data-delete-form="delete-automovil-@item.AutomovilID"
                                                                data-delete-title="Eliminar automóvil"
                                                                data-delete-message="Se eliminará el automóvil @item.ModeloLibre con placas @item.Placas. Esta acción no se puede deshacer."
                                                                data-delete-confirm-label="Sí, eliminar"></button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="cq-form-pane" id="cqFormPane">
            <div class="card @(isEditing ? "cq-card-editing" : "")">
                <div class="cq-panel-header">
                    <div class="cq-panel-icon"><i class="mdi mdi-pencil"></i></div>
                    <div class="flex-grow-1 min-width-0">
                        <h5 class="mb-0">@(isEditing ? "Editar automóvil" : "Nuevo automóvil")</h5>
                        <small class="text-muted">Captura o corrige el vehículo sin salir del listado.</small>
                    </div>
                    <button type="button" class="cq-close-btn" id="btnCerrarPanel"><i class="mdi mdi-close"></i></button>
                </div>
                <div class="card-body pt-3">
                    <form asp-controller="AutomovilesAdmin" asp-action="Save" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="Form.AutomovilID" type="hidden" />

                        <div class="form-group">
                            <label asp-for="Form.UsuarioID">Residente</label>
                            <select asp-for="Form.UsuarioID" class="form-control" asp-items="Model.Usuarios.Select(u => new SelectListItem { Value = u.UsuarioID.ToString(), Text = u.NombreUsuario })" required>
                                <option value="">Seleccionar residente</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.ModeloLibre">Modelo</label>
                            <input asp-for="Form.ModeloLibre" class="form-control" required maxlength="200" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.Placas">Placas</label>
                            <input asp-for="Form.Placas" class="form-control" required maxlength="10" />
                        </div>
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">@(isEditing ? "Actualizar" : "Crear")</button>
                            @if (isEditing)
                            {
                                <a href="@cancelUrl" class="btn btn-secondary ml-2">Cancelar</a>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_DeleteConfirmModal")

<script>
(function () {
    var split = document.getElementById('cqSplit');
    var btnNuevo = document.getElementById('btnNuevoRegistro');
    var btnCerrar = document.getElementById('btnCerrarPanel');
    var isEditing = @(isEditing ? "true" : "false");
    var cancelUrl = '@Html.Raw(cancelUrl)';

    function openPanel() {
        if (split) {
            split.classList.add('panel-open');
        }
    }

    function closePanel() {
        if (isEditing) {
            window.location.href = cancelUrl;
            return;
        }

        if (split) {
            split.classList.remove('panel-open');
        }
    }

    if (btnNuevo) {
        btnNuevo.addEventListener('click', openPanel);
    }

    if (btnCerrar) {
        btnCerrar.addEventListener('click', closePanel);
    }

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && split && split.classList.contains('panel-open')) {
            closePanel();
        }
    });
}());
</script>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon">
                <i class="mdi mdi-car"></i>
            </div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Automóviles</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge">
                        <i class="mdi mdi-car"></i>
                        <strong>@Model.Items.Count</strong>
                    </span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item active">Automóviles</li>
            </ol>
            <button type="button" class="btn btn-primary cq-tb-btn-new" id="btnNuevoRegistro">
                <i class="mdi mdi-plus"></i><span>Nuevo automóvil</span>
            </button>
        </div>
    </div>
}