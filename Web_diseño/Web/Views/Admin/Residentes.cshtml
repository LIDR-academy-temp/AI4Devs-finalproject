@model ResidentesAdminPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Residentes";
    var isEditing = Model.Form.UsuarioID.HasValue && Model.Form.UsuarioID.Value > 0;
    var cancelUrl = Url.Action("Index", "ResidentesAdmin", new { /* filtros actuales */ });
    var totalConCasa = Model.Items.Count(item => item.Casas.Any());
}

<div class="container-fluid">

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="mdi mdi-alert-circle mr-1"></i>@Model.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card cq-reserva-hero mb-4">
        <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="flex-grow-1">
                <span class="badge badge-pill cq-reserva-pill">Padrón residente</span>
                <h3 class="mb-2 mt-2">Administra residentes con contexto claro</h3>
                <p class="mb-0">Consulta correo, dirección y viviendas ligadas antes de editar o eliminar un perfil.</p>
            </div>
            <div class="d-flex flex-wrap gap-2 cq-reserva-stat-strip">
                <div class="cq-reserva-stat"><span>Residentes</span><strong>@Model.Items.Count</strong></div>
                <div class="cq-reserva-stat"><span>Activos</span><strong>@Model.Items.Count(i => i.bActivo)</strong></div>
                <div class="cq-reserva-stat"><span>Con casa</span><strong>@totalConCasa</strong></div>
            </div>
        </div>
    </div>

    <div class="cq-split @(isEditing ? "panel-open" : "")" id="cqSplit">
        <div class="cq-table-pane">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-2 mb-3">
                        <div>
                            <h4 class="card-title mb-1">Residentes registrados</h4>
                            <p class="text-muted mb-0">Abre el perfil correcto y revisa su vivienda antes de hacer cambios.</p>
                        </div>
                        <span class="badge badge-light">@Model.Items.Count registro(s)</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle cq-filterable">
                            <thead>
                                <tr>
                                    <th data-type="text">Nombre</th>
                                    <th data-type="text">Correo</th>
                                    <th data-type="text">Dirección</th>
                                    <th data-type="text">Casas</th>
                                    <th data-type="select" class="text-center">Activo</th>
                                    <th data-type="none" class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Items.Any())
                                {
                                    <tr>
                                        <td colspan="6">
                                            <div class="cq-reserva-empty cq-reserva-empty--table">
                                                <div class="cq-reserva-empty-icon"><i class="mdi mdi-account-group-outline"></i></div>
                                                <h5 class="mb-2">Sin residentes visibles</h5>
                                                <p class="text-muted mb-0">Crea el primer residente para empezar a asignar accesos y viviendas.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model.Items)
                                    {
                                        var casasStr = string.Join(", ", item.Casas.Select(c => c.NumeroExtCasa).Where(c => !string.IsNullOrWhiteSpace(c)));
                                        var rowActive = isEditing && Model.Form.UsuarioID == item.UsuarioID;
                                        <tr class="@(rowActive ? "cq-row-active" : "")">
                                            <td>@item.Nombre</td>
                                            <td>@item.Correo</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.DireccionCondomino) ? "Sin dirección" : item.DireccionCondomino)</td>
                                            <td>@(string.IsNullOrWhiteSpace(casasStr) ? "Sin casa" : casasStr)</td>
                                            <td class="text-center">
                                                @if (item.bActivo)
                                                {
                                                    <span class="badge badge-success">Activo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">Inactivo</span>
                                                }
                                            </td>
                                            <td class="cq-actions text-center">
                                                <div class="cq-actions-group justify-content-center">
                                                    <a cq-btn="edit"
                                                       asp-controller="ResidentesAdmin" asp-action="Index"
                                                       asp-route-editId="@item.UsuarioID"
                                                       title="Editar"></a>
                                                    <form asp-action="Delete" method="post" class="d-inline" id="delete-residente-@item.UsuarioID">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="usuarioId" value="@item.UsuarioID" />
                                                        <button cq-btn="delete"
                                                                type="button"
                                                                class="js-delete-trigger"
                                                                title="Eliminar"
                                                                aria-label="Eliminar residente @item.Nombre"
                                                                aria-haspopup="dialog"
                                                                data-delete-form="delete-residente-@item.UsuarioID"
                                                                data-delete-title="Eliminar residente"
                                                                data-delete-message="Se eliminará el residente @item.Nombre. Esta acción no se puede deshacer."
                                                                data-delete-confirm-label="Sí, eliminar"></button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="cq-form-pane" id="cqFormPane">
            <div class="card @(isEditing ? "cq-card-editing" : "")">
                <div class="cq-panel-header">
                    <div class="cq-panel-icon"><i class="mdi mdi-pencil"></i></div>
                    <div class="flex-grow-1 min-width-0">
                        <h5 class="mb-0">@(isEditing ? "Editar residente" : "Nuevo residente")</h5>
                        <small class="text-muted">Captura o corrige el perfil sin salir del padrón.</small>
                    </div>
                    <button type="button" class="cq-close-btn" id="btnCerrarPanel"><i class="mdi mdi-close"></i></button>
                </div>
                <div class="card-body pt-3">
                    <form asp-controller="ResidentesAdmin" asp-action="Save" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="Form.UsuarioID" type="hidden" />

                        <div class="form-group">
                            <label asp-for="Form.Nombre">Nombre</label>
                            <input asp-for="Form.Nombre" class="form-control" required maxlength="100" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Form.Correo">Correo electrónico</label>
                            <input asp-for="Form.Correo" class="form-control" type="email" required maxlength="200" />
                            <small class="form-text text-muted">Debe ser único.</small>
                        </div>
                        <div class="form-group">
                            <div class="custom-control custom-checkbox">
                                <input asp-for="Form.bActivo" class="custom-control-input" />
                                <label class="custom-control-label" asp-for="Form.bActivo">Activo</label>
                            </div>
                        </div>
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">@(isEditing ? "Actualizar" : "Crear")</button>
                            @if (isEditing)
                            {
                                <a href="@cancelUrl" class="btn btn-secondary ml-2">Cancelar</a>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_DeleteConfirmModal")

<script>
(function () {
    var split = document.getElementById('cqSplit');
    var btnNuevo = document.getElementById('btnNuevoRegistro');
    var btnCerrar = document.getElementById('btnCerrarPanel');
    var isEditing = @(isEditing ? "true" : "false");
    var cancelUrl = '@Html.Raw(cancelUrl)';

    function openPanel() {
        if (split) {
            split.classList.add('panel-open');
        }
    }

    function closePanel() {
        if (isEditing) {
            window.location.href = cancelUrl;
            return;
        }

        if (split) {
            split.classList.remove('panel-open');
        }
    }

    if (btnNuevo) {
        btnNuevo.addEventListener('click', openPanel);
    }

    if (btnCerrar) {
        btnCerrar.addEventListener('click', closePanel);
    }

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && split && split.classList.contains('panel-open')) {
            closePanel();
        }
    });
}());
</script>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon">
                <i class="mdi mdi-account-group"></i>
            </div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Residentes</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge">
                        <i class="mdi mdi-account"></i>
                        <strong>@Model.Items.Count</strong>
                    </span>
                    <span class="cq-tb-dot"></span>
                    <span class="cq-tb-badge cq-tb-green">
                        <i class="mdi mdi-check-circle-outline"></i>
                        <strong>@Model.Items.Count(i => i.bActivo)</strong> activos
                    </span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item active">Residentes</li>
            </ol>
            <button type="button" class="btn btn-primary cq-tb-btn-new" id="btnNuevoRegistro">
                <i class="mdi mdi-plus"></i><span>Nuevo residente</span>
            </button>
        </div>
    </div>
}