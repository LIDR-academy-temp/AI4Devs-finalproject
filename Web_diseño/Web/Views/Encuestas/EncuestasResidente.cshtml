@model EncuestasResidentePageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Encuestas";
    var pendientes = Model.Items.Count(item => !item.YaRespondio);
    var respondidas = Model.Items.Count(item => item.YaRespondio);
}

<div class="container-fluid">

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            <i class="mdi mdi-check-circle mr-1"></i>@Model.Message
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            @Model.Error
        </div>
    }

    <div class="card cq-reserva-hero mb-4">
        <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="flex-grow-1">
                <span class="badge badge-pill cq-reserva-pill">Participación</span>
                <h3 class="mb-2 mt-2">Encuestas activas</h3>
                <p class="mb-0">Responde lo pendiente y consulta las encuestas que ya completaste.</p>
            </div>
            <div class="d-flex flex-wrap gap-2 cq-reserva-stat-strip">
                <div class="cq-reserva-stat"><span>Activas</span><strong>@Model.Items.Count</strong></div>
                <div class="cq-reserva-stat"><span>Pendientes</span><strong>@pendientes</strong></div>
                <div class="cq-reserva-stat"><span>Respondidas</span><strong>@respondidas</strong></div>
            </div>
        </div>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="card">
            <div class="card-body cq-reserva-empty cq-reserva-empty--table py-5">
                <div class="cq-reserva-empty-icon"><i class="mdi mdi-clipboard-text-outline"></i></div>
                <h5 class="mb-2">Sin encuestas activas</h5>
                <p class="text-muted mb-0">No hay encuestas disponibles en este momento.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model.Items)
            {
                var description = string.IsNullOrWhiteSpace(item.Encuesta.Descripcion)
                    ? null
                    : item.Encuesta.Descripcion.Length > 120
                        ? item.Encuesta.Descripcion[..120] + "..."
                        : item.Encuesta.Descripcion;

                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2 gap-2">
                                <h5 class="card-title mb-0">@item.Encuesta.Titulo</h5>
                                @if (item.YaRespondio)
                                {
                                    <span class="badge badge-success">Respondida</span>
                                }
                                else
                                {
                                    <span class="badge badge-primary">Pendiente</span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(description))
                            {
                                <p class="text-muted mb-2" style="font-size:.83rem;">@description</p>
                            }

                            @if (item.Encuesta.FechaFin.HasValue)
                            {
                                <small class="text-muted d-block mb-3">
                                    <i class="mdi mdi-calendar-clock"></i>
                                    Cierra: @item.Encuesta.FechaFin.Value.ToString("dd/MM/yyyy")
                                </small>
                            }

                            <div class="mt-auto pt-2">
                                @if (item.YaRespondio)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" disabled>
                                        <i class="mdi mdi-check-circle"></i> Ya respondiste
                                    </button>
                                }
                                else
                                {
                                    <a asp-controller="EncuestaResponder"
                                       asp-action="Responder"
                                       asp-route-encuestaId="@item.Encuesta.EncuestaID"
                                       class="btn btn-sm btn-primary">
                                        <i class="mdi mdi-pencil-box-outline"></i> Responder
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-clipboard-list"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">Encuestas</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge">@pendientes pendiente(s) · @Model.Items.Count activa(s)</span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item active">Encuestas</li>
            </ol>
        </div>
    </div>
}
