@model EncuestaResponderViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Responder encuesta";
    var totalPreguntas = Model.Preguntas.Count;
    var requeridas = Model.Preguntas.Count(p => p.Requerida);
}

<div class="container-fluid">

    <div class="card cq-reserva-hero mb-4">
        <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="flex-grow-1">
                <span class="badge badge-pill cq-reserva-pill">Encuesta</span>
                <h3 class="mb-2 mt-2">@Model.Encuesta.Titulo</h3>
                @if (!string.IsNullOrWhiteSpace(Model.Encuesta.Descripcion))
                {
                    <p class="mb-0">@Model.Encuesta.Descripcion</p>
                }
                else
                {
                    <p class="mb-0">Completa el formulario y envía tus respuestas.</p>
                }
            </div>
            <div class="d-flex flex-wrap gap-2 cq-reserva-stat-strip">
                <div class="cq-reserva-stat"><span>Preguntas</span><strong>@totalPreguntas</strong></div>
                <div class="cq-reserva-stat"><span>Obligatorias</span><strong>@requeridas</strong></div>
            </div>
        </div>
    </div>

    @if (Model.YaRespondio)
    {
        <div class="card">
            <div class="card-body cq-reserva-empty cq-reserva-empty--table py-5">
                <div class="cq-reserva-empty-icon"><i class="mdi mdi-check-circle" style="color:var(--cq-success);"></i></div>
                <h5 class="mb-2">Ya respondiste esta encuesta</h5>
                <p class="text-muted mb-3">Tu respuesta ya fue registrada. Solo se permite una respuesta por casa.</p>
                <a asp-controller="EncuestaResponder" asp-action="Index" class="btn btn-primary">
                    <i class="mdi mdi-arrow-left"></i> Volver a encuestas
                </a>
            </div>
        </div>
    }
    else if (!Model.Preguntas.Any())
    {
        <div class="card">
            <div class="card-body cq-reserva-empty cq-reserva-empty--table py-5">
                <div class="cq-reserva-empty-icon"><i class="mdi mdi-clipboard-alert-outline"></i></div>
                <h5 class="mb-2">Encuesta sin preguntas</h5>
                <p class="text-muted mb-3">Esta encuesta aún no tiene preguntas configuradas.</p>
                <a asp-controller="EncuestaResponder" asp-action="Index" class="btn btn-secondary">
                    <i class="mdi mdi-arrow-left"></i> Volver
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-body p-4">
                        <form asp-controller="EncuestaResponder"
                              asp-action="Responder"
                              asp-route-encuestaId="@Model.Encuesta.EncuestaID"
                              method="post" novalidate>
                            @Html.AntiForgeryToken()

                            @for (int i = 0; i < Model.Preguntas.Count; i++)
                            {
                                var pregunta = Model.Preguntas[i];
                                var opciones = Model.Opciones
                                    .Where(o => o.PreguntaID == pregunta.PreguntaID && !o.bEliminado)
                                    .OrderBy(o => o.Orden)
                                    .ToList();
                                var fieldName = $"p_{pregunta.PreguntaID}";

                                <div class="mb-4 pb-3 @(i < Model.Preguntas.Count - 1 ? "border-bottom" : "")">
                                    <label class="font-weight-bold d-block mb-2" style="font-size:.92rem;">
                                        <span class="badge badge-light mr-1" style="font-size:.75rem;color:var(--cq-primary);border:1px solid var(--cq-border);">@(i + 1)</span>
                                        @pregunta.Texto
                                        @if (pregunta.Requerida)
                                        {
                                            <span class="text-danger ml-1" title="Obligatoria">*</span>
                                        }
                                    </label>

                                    @if (pregunta.TipoPreguntaID == 1)
                                    {
                                        <textarea class="form-control" name="@fieldName" rows="3"
                                                  placeholder="Escribe tu respuesta..."
                                                  @(pregunta.Requerida ? "required" : "")></textarea>
                                    }
                                    else if (pregunta.TipoPreguntaID == 2)
                                    {
                                        @foreach (var opcion in opciones)
                                        {
                                            <div class="custom-control custom-radio mb-1">
                                                <input type="radio" class="custom-control-input"
                                                       id="opt_@opcion.OpcionPreguntaID"
                                                       name="@fieldName"
                                                       value="@opcion.OpcionPreguntaID"
                                                       @(pregunta.Requerida ? "required" : "") />
                                                <label class="custom-control-label" for="opt_@opcion.OpcionPreguntaID">
                                                    @opcion.Texto
                                                </label>
                                            </div>
                                        }
                                    }
                                    else if (pregunta.TipoPreguntaID == 3)
                                    {
                                        @foreach (var opcion in opciones)
                                        {
                                            <div class="custom-control custom-checkbox mb-1">
                                                <input type="checkbox" class="custom-control-input"
                                                       id="opt_@opcion.OpcionPreguntaID"
                                                       name="@fieldName"
                                                       value="@opcion.OpcionPreguntaID" />
                                                <label class="custom-control-label" for="opt_@opcion.OpcionPreguntaID">
                                                    @opcion.Texto
                                                </label>
                                            </div>
                                        }
                                    }
                                    else if (pregunta.TipoPreguntaID == 4)
                                    {
                                        <div class="d-flex flex-wrap" style="gap:.75rem;">
                                            @for (int v = 1; v <= 5; v++)
                                            {
                                                <div class="custom-control custom-radio custom-control-inline">
                                                    <input type="radio" class="custom-control-input"
                                                           id="scale_@(pregunta.PreguntaID)_@v"
                                                           name="@fieldName"
                                                           value="@v"
                                                           @(pregunta.Requerida ? "required" : "") />
                                                    <label class="custom-control-label" for="scale_@(pregunta.PreguntaID)_@v">
                                                        @v
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (pregunta.TipoPreguntaID == 5)
                                    {
                                        <input type="date" class="form-control" name="@fieldName"
                                               style="max-width:220px;"
                                               @(pregunta.Requerida ? "required" : "") />
                                    }
                                    else
                                    {
                                        <input type="text" class="form-control" name="@fieldName"
                                               @(pregunta.Requerida ? "required" : "") />
                                    }
                                </div>
                            }

                            <div class="d-flex justify-content-between mt-4 pt-2">
                                <a asp-controller="EncuestaResponder" asp-action="Index"
                                   class="btn btn-outline-secondary">
                                    <i class="mdi mdi-arrow-left"></i> Cancelar
                                </a>
                                <button type="submit" class="btn btn-primary px-5">
                                    <i class="mdi mdi-send"></i> Enviar respuestas
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-clipboard-edit"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">@Model.Encuesta.Titulo</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge">@totalPreguntas pregunta(s) · @requeridas obligatoria(s)</span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item"><a asp-controller="EncuestaResponder" asp-action="Index">Encuestas</a></li>
                <li class="breadcrumb-item active">Responder</li>
            </ol>
        </div>
    </div>
}
