@model EncuestaDetallePageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Detalle de encuesta";
    var editPregunta = Model.FormPregunta.PreguntaID.HasValue && Model.FormPregunta.PreguntaID.Value > 0;
    var editOpcion   = Model.FormOpcion.OpcionPreguntaID.HasValue && Model.FormOpcion.OpcionPreguntaID.Value > 0;
    var hayPreguntas = Model.Preguntas.Any();
    var totalRequeridas = Model.Preguntas.Count(p => p.Requerida);

    string TipoLabel(int? id) => id switch {
        1 => "Texto libre",
        2 => "Opción única",
        3 => "Opción múltiple",
        4 => "Escala 1–5",
        5 => "Fecha",
        _ => "Sin tipo"
    };
    string TipoIcon(int? id) => id switch {
        1 => "mdi-text",
        2 => "mdi-radiobox-marked",
        3 => "mdi-checkbox-multiple-marked",
        4 => "mdi-star-half-full",
        5 => "mdi-calendar",
        _ => "mdi-help-circle"
    };
    // Razor attribute helpers (null → attribute omitted)
    string? SelTipo(int v)  => (Model.FormPregunta.TipoPreguntaID ?? 0) == v ? "selected" : null;
    string? SelPreg(int? v) => Model.FormOpcion.PreguntaID == v ? "selected" : null;
    string? ChkReq()        => Model.FormPregunta.Requerida ? "checked" : null;
}
<style>
/* ── Stepper ─────────────────────────────────────────────── */
.enc-stepper{display:flex;align-items:center;gap:0;margin-bottom:1.5rem;flex-wrap:wrap;gap:.5rem;}
.enc-step{display:flex;align-items:center;gap:.5rem;font-size:.78rem;font-weight:700;color:var(--cq-muted);}
.enc-step__num{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:800;background:var(--cq-surface-alt);border:2px solid var(--cq-border);color:var(--cq-muted);flex-shrink:0;}
.enc-step--done .enc-step__num{background:var(--cq-success);border-color:var(--cq-success);color:#fff;}
.enc-step--active .enc-step__num{background:var(--cq-primary);border-color:var(--cq-primary);color:#fff;}
.enc-step--active{color:var(--cq-primary);}
.enc-step__sep{width:28px;height:2px;background:var(--cq-border);border-radius:2px;flex-shrink:0;}
.enc-step--done + .enc-step__sep{background:var(--cq-success);}

/* ── Form panel ──────────────────────────────────────────── */
.enc-form-card{border-radius:var(--cq-radius-md);border:2px solid var(--cq-border);background:var(--cq-surface);transition:border-color .2s;}
.enc-form-card.is-editing{border-color:var(--cq-warning);}
.enc-form-card.is-editing .enc-form-badge{display:inline-flex;}
.enc-form-badge{display:none;align-items:center;gap:.3rem;font-size:.7rem;font-weight:700;background:rgba(217,119,6,.12);color:#d97706;border-radius:20px;padding:.2em .7em;margin-bottom:.6rem;}

/* ── Question item ───────────────────────────────────────── */
.enc-q-item{border:1px solid var(--cq-border);border-radius:var(--cq-radius-sm);background:var(--cq-surface);padding:.8rem 1rem;transition:box-shadow .15s;}
.enc-q-item:hover{box-shadow:var(--cq-shadow);}
.enc-q-badge{display:inline-flex;align-items:center;gap:.25rem;font-size:.68rem;font-weight:700;border-radius:20px;padding:.15em .55em;}
.enc-q-tipo{background:rgba(25,118,210,.1);color:var(--cq-primary);}
.enc-q-req{background:rgba(220,38,38,.1);color:#dc2626;}
.enc-opts-collapse .enc-opt-chip{display:inline-flex;align-items:center;gap:.25rem;background:var(--cq-surface-alt);border-radius:6px;padding:.2em .6em;font-size:.74rem;font-weight:500;color:var(--cq-text);margin:.1rem;}

/* ── Empty state ─────────────────────────────────────────── */
.enc-empty{text-align:center;padding:2rem 1rem;color:var(--cq-muted);}
.enc-empty i{font-size:2.2rem;opacity:.35;display:block;margin-bottom:.5rem;}
.enc-empty p{font-size:.84rem;margin:0;}
/* ── Section divider ─────────────────────────────────────────── */
.enc-section-sep{display:flex;align-items:center;gap:.75rem;margin:1.5rem 0;}
.enc-section-sep__line{flex:1;height:1px;background:var(--cq-border);}
.enc-section-sep__label{display:flex;align-items:center;gap:.4rem;font-size:.72rem;font-weight:700;letter-spacing:.05em;color:var(--cq-muted);text-transform:uppercase;white-space:nowrap;}

/* ── Subtitle capitalize ─────────────────────────────────────── */
.enc-subtitle{text-transform:capitalize;}</style>

<div class="container-fluid">

    @* Alerts *@
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success alert-dismissible d-flex align-items-center gap-2 enc-alert-auto" role="alert">
            <i class="mdi mdi-check-circle" aria-hidden="true"></i>
            <span>@Model.Message</span>
            <button type="button" class="close ml-auto" data-dismiss="alert" aria-label="Cerrar"><span aria-hidden="true">&times;</span></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible d-flex align-items-center gap-2" role="alert">
            <i class="mdi mdi-alert-circle" aria-hidden="true"></i>
            <span>@Model.Error</span>
            <button type="button" class="close ml-auto" data-dismiss="alert" aria-label="Cerrar"><span aria-hidden="true">&times;</span></button>
        </div>
    }

    <div class="card cq-reserva-hero mb-4">
        <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="flex-grow-1">
                <span class="badge badge-pill cq-reserva-pill">Configuración de encuesta</span>
                <h3 class="mb-2 mt-2">Construye preguntas y opciones en una sola vista</h3>
                <p class="mb-0">Edita la estructura, revisa el avance y ajusta el formulario sin salir del detalle.</p>
            </div>
            <div class="d-flex flex-wrap gap-2 cq-reserva-stat-strip">
                <div class="cq-reserva-stat"><span>Preguntas</span><strong>@Model.Preguntas.Count</strong></div>
                <div class="cq-reserva-stat"><span>Opciones</span><strong>@Model.Opciones.Count</strong></div>
                <div class="cq-reserva-stat"><span>Requeridas</span><strong>@totalRequeridas</strong></div>
            </div>
        </div>
    </div>

    @* Stepper *@
    <div class="enc-stepper" role="list" aria-label="Pasos de configuración">
        <div class="enc-step enc-step--done" role="listitem">
            <span class="enc-step__num"><i class="mdi mdi-check" aria-hidden="true"></i></span>
            <span>Encuesta</span>
        </div>
        <div class="enc-step__sep" aria-hidden="true"></div>
        <div class="enc-step @(hayPreguntas ? "enc-step--done" : "enc-step--active")" role="listitem">
            <span class="enc-step__num">@Html.Raw(hayPreguntas ? "<i class=\"mdi mdi-check\" aria-hidden=\"true\"></i>" : "2")</span>
            <span>Preguntas</span>
        </div>
        <div class="enc-step__sep" aria-hidden="true"></div>
        <div class="enc-step @(Model.Opciones.Any() ? "enc-step--done" : (hayPreguntas ? "enc-step--active" : ""))" role="listitem">
            <span class="enc-step__num">@(Model.Opciones.Any() ? Html.Raw("<i class=\"mdi mdi-check\"></i>") : Html.Raw("3"))</span>
            <span>Opciones</span>
        </div>
    </div>

    @* ══ SECCIÓN 1: PREGUNTAS ══ *@
    <div class="row mb-4">

        @* Formulario pregunta *@
        <div class="col-lg-4 mb-3 mb-lg-0">
            <div class="enc-form-card p-3 p-md-4 h-100 @(editPregunta ? "is-editing" : "")">
                <div class="enc-form-badge">
                    <i class="mdi mdi-pencil" aria-hidden="true"></i> Editando pregunta
                </div>
                <h5 class="fw-bold mb-3" style="font-size:.95rem;">
                    <i class="mdi mdi-help-circle-outline me-1" style="color:var(--cq-primary);" aria-hidden="true"></i>
                    @(editPregunta ? "Editar pregunta" : "Nueva pregunta")
                </h5>

                <form asp-controller="Encuestas" asp-action="SavePregunta" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PreguntaID"  value="@Model.FormPregunta.PreguntaID" />
                    <input type="hidden" name="EncuestaID"  value="@Model.Encuesta.EncuestaID" />

                    <div class="mb-3">
                        <label for="txtPregTexto" class="form-label fw-semibold" style="font-size:.82rem;">
                            Texto de la pregunta <span class="text-danger" aria-hidden="true">*</span>
                        </label>
                        <input id="txtPregTexto" class="form-control" type="text" name="Texto"
                               value="@Model.FormPregunta.Texto" required maxlength="500"
                               placeholder="Ej. ¿Cómo califica el servicio?" />
                    </div>

                    <div class="mb-3">
                        <label for="selTipo" class="form-label fw-semibold" style="font-size:.82rem;">Tipo de pregunta</label>
                        <select id="selTipo" class="form-select" name="TipoPreguntaID">
                            <option value="1" selected="@SelTipo(1)">📝 Texto libre</option>
                            <option value="2" selected="@SelTipo(2)">🔘 Opción única</option>
                            <option value="3" selected="@SelTipo(3)">☑️ Opción múltiple</option>
                            <option value="4" selected="@SelTipo(4)">⭐ Escala 1–5</option>
                            <option value="5" selected="@SelTipo(5)">📅 Fecha</option>
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label for="txtOrdenP" class="form-label fw-semibold" style="font-size:.82rem;">Orden</label>
                            <input id="txtOrdenP" class="form-control" type="number" name="Orden"
                                   value="@(Model.FormPregunta.Orden ?? 0)" min="0" />
                        </div>
                        <div class="col-6 d-flex align-items-end pb-1">
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" id="chkRequerida"
                                       name="Requerida" value="true"
                                       checked="@ChkReq()" />
                                <label class="form-check-label fw-semibold" for="chkRequerida" style="font-size:.82rem;">
                                    Requerida
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-primary btn-sm px-4">
                            <i class="mdi mdi-check me-1" aria-hidden="true"></i>
                            @(editPregunta ? "Actualizar" : "Agregar pregunta")
                        </button>
                        @if (editPregunta)
                        {
                            <a asp-controller="Encuestas" asp-action="Detalle"
                               asp-route-encuestaId="@Model.Encuesta.EncuestaID"
                               class="btn btn-outline-secondary btn-sm">Cancelar</a>
                        }
                    </div>
                </form>
            </div>
        </div>

        @* Lista preguntas *@
        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h5 class="mb-0 fw-bold" style="font-size:.95rem;">
                            <i class="mdi mdi-format-list-numbered me-1" style="color:var(--cq-primary);" aria-hidden="true"></i>
                            Preguntas
                            <span class="badge ms-1" style="background:var(--cq-primary);font-size:.72rem;">@Model.Preguntas.Count</span>
                        </h5>
                    </div>

                    @if (!hayPreguntas)
                    {
                        <div class="enc-empty">
                            <i class="mdi mdi-help-box-outline" aria-hidden="true"></i>
                            <p>Todavía no hay preguntas.<br/><strong>Agrega la primera desde el panel lateral.</strong></p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var p in Model.Preguntas.OrderBy(x => x.Orden))
                            {
                                var optsCount = Model.Opciones.Count(o => o.PreguntaID == p.PreguntaID);
                                var opts      = Model.Opciones.Where(o => o.PreguntaID == p.PreguntaID).OrderBy(o => o.Orden).ToList();
                                <div class="enc-q-item">
                                    <div class="d-flex align-items-start justify-content-between gap-2 flex-wrap">
                                        <div class="flex-grow-1">
                                            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                                <span class="fw-semibold" style="font-size:.88rem;">@p.Texto</span>
                                                <span class="enc-q-badge enc-q-tipo">
                                                    <i class="mdi @TipoIcon(p.TipoPreguntaID)" aria-hidden="true"></i>
                                                    @TipoLabel(p.TipoPreguntaID)
                                                </span>
                                                @if (p.Requerida)
                                                {
                                                    <span class="enc-q-badge enc-q-req">Requerida</span>
                                                }
                                            </div>
                                            @if (opts.Any())
                                            {
                                                <div class="enc-opts-collapse mt-1">
                                                    @foreach (var opt in opts)
                                                    {
                                                        <span class="enc-opt-chip">@opt.Texto</span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <small class="text-muted" style="font-size:.72rem;">Sin opciones</small>
                                            }
                                        </div>
                                        <div class="d-flex gap-1 flex-shrink-0">
                                            <a asp-controller="Encuestas" asp-action="Detalle"
                                               asp-route-encuestaId="@Model.Encuesta.EncuestaID"
                                               asp-route-editPreguntaId="@p.PreguntaID"
                                               class="btn btn-sm btn-outline-warning" title="Editar pregunta"
                                               aria-label="Editar pregunta: @p.Texto">
                                                <i class="mdi mdi-pencil" aria-hidden="true"></i>
                                            </a>
                                            <form asp-controller="Encuestas" asp-action="DeletePregunta" method="post" class="d-inline"
                                                  onsubmit="return confirm('¿Eliminar «@p.Texto» y sus opciones?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="preguntaId" value="@p.PreguntaID" />
                                                <input type="hidden" name="encuestaId" value="@Model.Encuesta.EncuestaID" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        aria-label="Eliminar pregunta: @p.Texto">
                                                    <i class="mdi mdi-delete" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Separador de sección *@
    <div class="enc-section-sep">
        <div class="enc-section-sep__line"></div>
        <div class="enc-section-sep__label">
            <i class="mdi mdi-format-list-checks" aria-hidden="true"></i>
            Paso 2 — Opciones de respuesta
        </div>
        <div class="enc-section-sep__line"></div>
    </div>

    @* ══ SECCIÓN 2: OPCIONES ══ *@
    <div class="row">

        @* Formulario opción *@
        <div class="col-lg-4 mb-3 mb-lg-0">
            <div class="enc-form-card p-3 p-md-4 h-100 @(editOpcion ? "is-editing" : "")">
                <div class="enc-form-badge">
                    <i class="mdi mdi-pencil" aria-hidden="true"></i> Editando opción
                </div>
                <h5 class="fw-bold mb-3" style="font-size:.95rem;">
                    <i class="mdi mdi-format-list-checks me-1" style="color:var(--cq-primary);" aria-hidden="true"></i>
                    @(editOpcion ? "Editar opción" : "Nueva opción")
                </h5>

                @if (!hayPreguntas)
                {
                    <div class="enc-empty">
                        <i class="mdi mdi-arrow-up-circle-outline" aria-hidden="true"></i>
                        <p>Primero agrega al menos<br/><strong>una pregunta</strong> arriba.</p>
                    </div>
                }
                else
                {
                    <form asp-controller="Encuestas" asp-action="SaveOpcion" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="OpcionPreguntaID" value="@Model.FormOpcion.OpcionPreguntaID" />
                        <input type="hidden" name="encuestaId" value="@Model.Encuesta.EncuestaID" />

                        <div class="mb-3">
                            <label for="selPregunta" class="form-label fw-semibold" style="font-size:.82rem;">
                                Pregunta <span class="text-danger" aria-hidden="true">*</span>
                            </label>
                            <select id="selPregunta" class="form-select" name="PreguntaID" required>
                                <option value="">— Seleccionar pregunta —</option>
                                @foreach (var p in Model.Preguntas.OrderBy(x => x.Orden))
                                {
                                    <option value="@p.PreguntaID" selected="@SelPreg(p.PreguntaID)">
                                        @p.Texto
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="txtOptTexto" class="form-label fw-semibold" style="font-size:.82rem;">
                                Texto de la opción <span class="text-danger" aria-hidden="true">*</span>
                            </label>
                            <input id="txtOptTexto" class="form-control" type="text" name="Texto"
                                   value="@Model.FormOpcion.Texto" required maxlength="300"
                                   placeholder="Ej. Muy satisfecho" />
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label for="txtValor" class="form-label fw-semibold" style="font-size:.82rem;">
                                    Valor
                                    <span class="text-muted fw-normal">(interno)</span>
                                </label>
                                <input id="txtValor" class="form-control" type="text" name="Valor"
                                       value="@Model.FormOpcion.Valor" maxlength="100"
                                       placeholder="Ej. 5" />
                            </div>
                            <div class="col-6">
                                <label for="txtOrdenO" class="form-label fw-semibold" style="font-size:.82rem;">Orden</label>
                                <input id="txtOrdenO" class="form-control" type="number" name="Orden"
                                       value="@(Model.FormOpcion.Orden ?? 0)" min="0" />
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-3">
                            <button type="submit" class="btn btn-primary btn-sm px-4">
                                <i class="mdi mdi-check me-1" aria-hidden="true"></i>
                                @(editOpcion ? "Actualizar" : "Agregar opción")
                            </button>
                            @if (editOpcion)
                            {
                                <a asp-controller="Encuestas" asp-action="Detalle"
                                   asp-route-encuestaId="@Model.Encuesta.EncuestaID"
                                   class="btn btn-outline-secondary btn-sm">Cancelar</a>
                            }
                        </div>
                    </form>
                }
            </div>
        </div>

        @* Lista opciones *@
        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h5 class="mb-0 fw-bold" style="font-size:.95rem;">
                            <i class="mdi mdi-checkbox-multiple-marked-outline me-1" style="color:var(--cq-primary);" aria-hidden="true"></i>
                            Opciones de respuesta
                            <span class="badge ms-1" style="background:var(--cq-primary);font-size:.72rem;">@Model.Opciones.Count</span>
                        </h5>
                    </div>

                    @if (!Model.Opciones.Any())
                    {
                        <div class="enc-empty">
                            <i class="mdi mdi-format-list-checkbox" aria-hidden="true"></i>
                            <p>@(hayPreguntas ? "Agrega opciones desde el formulario lateral." : "Primero agrega preguntas.")</p>
                        </div>
                    }
                    else
                    {
                        @* Agrupar por pregunta *@
                        @foreach (var preg in Model.Preguntas.OrderBy(x => x.Orden))
                        {
                            var optsGrupo = Model.Opciones.Where(o => o.PreguntaID == preg.PreguntaID).OrderBy(o => o.Orden).ToList();
                            if (!optsGrupo.Any()) continue;
                            <div class="mb-3">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="enc-q-badge enc-q-tipo">
                                        <i class="mdi @TipoIcon(preg.TipoPreguntaID)" aria-hidden="true"></i>
                                        @TipoLabel(preg.TipoPreguntaID)
                                    </span>
                                    <span class="fw-semibold" style="font-size:.84rem;">@preg.Texto</span>
                                </div>
                                <div class="d-flex flex-column gap-1 ps-2" style="border-left:3px solid var(--cq-border);">
                                    @foreach (var o in optsGrupo)
                                    {
                                        <div class="d-flex align-items-center justify-content-between gap-2 py-1 px-2"
                                             style="border-radius:var(--cq-radius-sm);background:var(--cq-surface-alt);">
                                            <div class="d-flex align-items-center gap-2">
                                                <span style="font-size:.8rem;color:var(--cq-muted);min-width:18px;text-align:right;">@o.Orden</span>
                                                <span style="font-size:.84rem;font-weight:500;">@o.Texto</span>
                                                @if (!string.IsNullOrWhiteSpace(o.Valor))
                                                {
                                                    <span class="text-muted" style="font-size:.72rem;">· @o.Valor</span>
                                                }
                                            </div>
                                            <div class="d-flex gap-1 flex-shrink-0">
                                                <a asp-controller="Encuestas" asp-action="Detalle"
                                                   asp-route-encuestaId="@Model.Encuesta.EncuestaID"
                                                   asp-route-editOpcionId="@o.OpcionPreguntaID"
                                                   class="btn btn-sm btn-outline-warning py-0 px-1"
                                                   title="Editar opción" aria-label="Editar opción @o.Texto"
                                                   style="font-size:.75rem;">
                                                    <i class="mdi mdi-pencil" aria-hidden="true"></i>
                                                </a>
                                                <form asp-controller="Encuestas" asp-action="DeleteOpcion" method="post" class="d-inline"
                                                      onsubmit="return confirm('¿Eliminar «@o.Texto»?')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="opcionId" value="@o.OpcionPreguntaID" />
                                                    <input type="hidden" name="encuestaId" value="@Model.Encuesta.EncuestaID" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-1"
                                                            aria-label="Eliminar opción @o.Texto"
                                                            style="font-size:.75rem;">
                                                        <i class="mdi mdi-delete" aria-hidden="true"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

</div>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-clipboard-text"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">@Model.Encuesta.Titulo</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge"><strong>@Model.Preguntas.Count</strong> preguntas</span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item"><a asp-controller="Encuestas" asp-action="Index">Encuestas</a></li>
                <li class="breadcrumb-item active">Detalle</li>
            </ol>
        </div>
    </div>
}

@section Scripts {
<script>
    // Auto-dismiss success alerts after 3.5 s
    document.querySelectorAll('.enc-alert-auto').forEach(function(el) {
        setTimeout(function() {
            if (typeof $ !== 'undefined') { $(el).alert('close'); }
            else { el.style.display = 'none'; }
        }, 3500);
    });
</script>
}
