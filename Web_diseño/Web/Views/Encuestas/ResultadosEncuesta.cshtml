@model ResultadosEncuestaViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Resultados: " + Model.Encuesta.Titulo;
    var preguntasConRespuesta = Model.Preguntas.Count(p => p.TotalRespuestas > 0);

    string TipoLabel(int id) => id switch {
        1 => "Texto libre",
        2 => "Opción única",
        3 => "Opción múltiple",
        4 => "Escala 1-5",
        5 => "Fecha",
        _ => "Sin tipo"
    };
    string TipoIcon(int id) => id switch {
        1 => "mdi-text",
        2 => "mdi-radiobox-marked",
        3 => "mdi-checkbox-multiple-marked",
        4 => "mdi-star-half-full",
        5 => "mdi-calendar",
        _ => "mdi-help-circle"
    };
}
<style>
.res-card{border-radius:var(--cq-radius-md);border:1px solid var(--cq-border);background:var(--cq-surface);padding:1.25rem 1.5rem;margin-bottom:1rem;}
.res-q-header{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;margin-bottom:1rem;}
.res-q-num{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:50%;background:var(--cq-primary);color:#fff;font-size:.72rem;font-weight:800;flex-shrink:0;}
.res-q-text{font-weight:600;font-size:.95rem;flex:1;}
.res-badge{display:inline-flex;align-items:center;gap:.25rem;font-size:.68rem;font-weight:700;border-radius:20px;padding:.15em .55em;background:rgba(25,118,210,.1);color:var(--cq-primary);}
.res-bar-row{display:flex;align-items:center;gap:.6rem;margin-bottom:.45rem;}
.res-bar-label{min-width:130px;max-width:160px;font-size:.82rem;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.res-bar-track{flex:1;height:12px;background:var(--cq-surface-alt);border-radius:6px;overflow:hidden;}
.res-bar-fill{height:100%;border-radius:6px;background:var(--cq-primary);transition:width .4s ease;}
.res-bar-pct{min-width:42px;font-size:.78rem;color:var(--cq-muted);text-align:right;}
.res-bar-cnt{min-width:28px;font-size:.78rem;font-weight:600;color:var(--cq-text);text-align:right;}
.res-star-fill{background:linear-gradient(90deg,#f59e0b,#fbbf24);}
.res-text-chip{display:inline-block;background:var(--cq-surface-alt);border:1px solid var(--cq-border);border-radius:var(--cq-radius-sm);padding:.35em .7em;font-size:.82rem;margin:.2rem;}
.res-stat-box{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:.75rem 1rem;border-radius:var(--cq-radius-md);border:1px solid var(--cq-border);background:var(--cq-surface-alt);text-align:center;}
.res-stat-val{font-size:2rem;font-weight:800;color:var(--cq-primary);line-height:1.1;}
.res-stat-lbl{font-size:.72rem;color:var(--cq-muted);font-weight:600;text-transform:uppercase;margin-top:.2rem;}
.res-avg-badge{display:inline-flex;align-items:center;gap:.4rem;background:rgba(245,158,11,.12);color:#b45309;border-radius:8px;padding:.35em .9em;font-size:.95rem;font-weight:700;}
.no-results{text-align:center;padding:3rem 1rem;color:var(--cq-muted);}
.no-results i{font-size:2.5rem;opacity:.3;display:block;margin-bottom:.5rem;}
</style>

<div class="container-fluid">

    <div class="card cq-reserva-hero mb-4">
        <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="flex-grow-1">
                <span class="badge badge-pill cq-reserva-pill">Resultados</span>
                <h3 class="mb-2 mt-2">Lee la participación sin entrar pregunta por pregunta</h3>
                <p class="mb-0">Consulta respuestas, vigencia y avance general desde un solo resumen visual.</p>
            </div>
            <div class="d-flex flex-wrap gap-2 cq-reserva-stat-strip">
                <div class="cq-reserva-stat"><span>Participantes</span><strong>@Model.TotalParticipantes</strong></div>
                <div class="cq-reserva-stat"><span>Preguntas</span><strong>@Model.Preguntas.Count</strong></div>
                <div class="cq-reserva-stat"><span>Con respuesta</span><strong>@preguntasConRespuesta</strong></div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger"><i class="mdi mdi-alert-circle me-2"></i>@Model.Error</div>
    }

    @* Stats header *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-sm-4 col-md-2">
            <div class="res-stat-box">
                <div class="res-stat-val">@Model.TotalParticipantes</div>
                <div class="res-stat-lbl">Participantes</div>
            </div>
        </div>
        <div class="col-6 col-sm-4 col-md-2">
            <div class="res-stat-box">
                <div class="res-stat-val">@Model.Preguntas.Count</div>
                <div class="res-stat-lbl">Preguntas</div>
            </div>
        </div>
        <div class="col-12 col-sm-4 col-md-8 d-flex align-items-center gap-2 flex-wrap">
            @if (Model.Encuesta.FechaInicio.HasValue)
            {
                <span class="res-badge">
                    <i class="mdi mdi-calendar-start" aria-hidden="true"></i>
                    Inicio: @Model.Encuesta.FechaInicio.Value.ToString("dd/MM/yyyy")
                </span>
            }
            @if (Model.Encuesta.FechaFin.HasValue)
            {
                <span class="res-badge">
                    <i class="mdi mdi-calendar-end" aria-hidden="true"></i>
                    Cierre: @Model.Encuesta.FechaFin.Value.ToString("dd/MM/yyyy")
                </span>
            }
            <span class="res-badge" style="background:rgba(22,163,74,.1);color:#16a34a;">
                <i class="mdi mdi-circle" style="font-size:.5rem;" aria-hidden="true"></i>
                @(Model.Encuesta.bActivo ? "Activa" : "Inactiva")
            </span>
        </div>
    </div>

    @if (Model.TotalParticipantes == 0)
    {
        <div class="res-card">
            <div class="no-results">
                <i class="mdi mdi-chart-line" aria-hidden="true"></i>
                <p class="fw-semibold">Sin respuestas todavía</p>
                <p style="font-size:.84rem;">Cuando los residentes respondan la encuesta, aquí aparecerán los resultados.</p>
            </div>
        </div>
    }
    else
    {
        @foreach (var (preg, idx) in Model.Preguntas.Select((p, i) => (p, i + 1)))
        {
            <div class="res-card">
                <div class="res-q-header">
                    <span class="res-q-num">@idx</span>
                    <span class="res-q-text">@preg.Texto</span>
                    <span class="res-badge">
                        <i class="mdi @TipoIcon(preg.TipoPreguntaID)" aria-hidden="true"></i>
                        @TipoLabel(preg.TipoPreguntaID)
                    </span>
                    <span class="text-muted" style="font-size:.76rem;">@preg.TotalRespuestas resp.</span>
                </div>

                @if (preg.TipoPreguntaID is 2 or 3)
                {
                    @* Opción única / múltiple: barras *@
                    @if (preg.ConteoPorOpcion.Any())
                    {
                        @foreach (var opc in preg.ConteoPorOpcion.OrderByDescending(o => o.Conteo))
                        {
                            <div class="res-bar-row">
                                <span class="res-bar-label" title="@opc.Texto">@opc.Texto</span>
                                <div class="res-bar-track">
                                    <div class="res-bar-fill" style="width:@opc.Porcentaje.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%;"></div>
                                </div>
                                <span class="res-bar-cnt">@opc.Conteo</span>
                                <span class="res-bar-pct">@opc.Porcentaje.ToString("F1")%</span>
                            </div>
                        }
                    }
                    else
                    {
                        <small class="text-muted">Sin opciones definidas.</small>
                    }
                }
                else if (preg.TipoPreguntaID == 4)
                {
                    @* Escala 1-5 *@
                    @if (preg.PromedioEscala.HasValue)
                    {
                        <div class="mb-3">
                            <span class="res-avg-badge">
                                <i class="mdi mdi-star" aria-hidden="true"></i>
                                Promedio: @preg.PromedioEscala.Value.ToString("F2")
                                <span style="color:var(--cq-muted);font-weight:400;">/ 5</span>
                            </span>
                        </div>
                    }
                    @foreach (var opc in preg.ConteoPorOpcion)
                    {
                        <div class="res-bar-row">
                            <span class="res-bar-label">@opc.Texto</span>
                            <div class="res-bar-track">
                                <div class="res-bar-fill res-star-fill" style="width:@opc.Porcentaje.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%;"></div>
                            </div>
                            <span class="res-bar-cnt">@opc.Conteo</span>
                            <span class="res-bar-pct">@opc.Porcentaje.ToString("F1")%</span>
                        </div>
                    }
                }
                else
                {
                    @* Texto libre / Fecha *@
                    @if (preg.Textos.Any())
                    {
                        <div>
                            @foreach (var txt in preg.Textos)
                            {
                                <span class="res-text-chip">@txt</span>
                            }
                        </div>
                    }
                    else
                    {
                        <small class="text-muted">Sin respuestas de texto.</small>
                    }
                }
            </div>
        }
    }

    <div class="mt-3">
        <a asp-controller="Encuestas" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="mdi mdi-arrow-left me-1" aria-hidden="true"></i> Volver a Encuestas
        </a>
    </div>

</div>

@section TopbarContent {
    <div class="cq-topbar-inner">
        <div class="cq-tb-left">
            <div class="cq-tb-icon"><i class="mdi mdi-chart-bar"></i></div>
            <div class="cq-tb-info">
                <span class="cq-tb-title">@Model.Encuesta.Titulo</span>
                <div class="cq-tb-meta">
                    <span class="cq-tb-badge">Resultados de encuesta</span>
                </div>
            </div>
        </div>
        <div class="cq-tb-right">
            <div class="cq-tb-sep"></div>
            <ol class="breadcrumb mb-0 cq-tb-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item"><a asp-controller="Encuestas" asp-action="Index">Encuestas</a></li>
                <li class="breadcrumb-item active">Resultados</li>
            </ol>
        </div>
    </div>
}
