{
  "permissions": {
    "allow": [
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm test:api*)",
      "Bash(pnpm --filter * test*)",
      "Bash(pnpm db:generate*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Read(**)",
      "Edit(backend/src/**)",
      "Edit(backend/test/**)",
      "Edit(frontend/src/**)",
      "Edit(packages/**)",
      "Edit(e2e/**)",
      "Edit(openspec/**)",
      "Edit(docs/**)",
      "Edit(api-collection/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(api-collection/.env)",
      "Bash(prisma migrate reset*)",
      "Bash(pnpm db:reset*)",
      "Bash(git push --force*)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-db.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-schema.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/biome-on-save.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@anthropic-plugin-directory": true,
    "typescript-lsp@claude-plugins-official": true
  }
}
