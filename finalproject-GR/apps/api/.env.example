# Copy to apps/api/.env (gitignored) — loaded automatically by `npm run dev`
# (src/load-env.ts). Variables already set in your shell take precedence.

# Same value as CLERK_SECRET_KEY in apps/web/.env.local (same Clerk app).
CLERK_SECRET_KEY=

# 32 random bytes, base64 (e.g. `openssl rand -base64 32`). Keep it fixed: data
# encrypted under one key (environment passwords) can't be revealed under another.
SECRETS_MASTER_KEY=

# Optional — these defaults match docker-compose and the web dev server.
# DATABASE_URL=postgresql://railgun_app:app_dev_password@localhost:5433/railgun
# WEB_ORIGIN=http://localhost:3000
# PORT=3001
