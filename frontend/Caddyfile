# Con DIRECCION_WEB, Caddy obtiene y renueva el certificado HTTPS de ese dominio.
# Sin ella, sirve por HTTP en el puerto 8080: es el modo de desarrollo local.
{$DIRECCION_WEB::8080} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
